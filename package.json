    "db:push": "node scripts/db-push.mjs",
    "preview": "astro preview",
    "demo": "node scripts/demo.mjs",
    "demo:accounts": "node scripts/demo-accounts.mjs",
    "astro": "astro",
    "check": "node scripts/fetch-agenda.mjs && astro check",
    "test:branch": "node scripts/test-branch.mjs",
    "test:release": "node scripts/test-release.mjs",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "quick": "node scripts/quick.mjs",
    "smoke:prod": "node scripts/smoke-prod.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
