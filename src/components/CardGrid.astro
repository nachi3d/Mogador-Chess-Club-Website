---
/**
 * Generic card grid used by the cours / pièges / exercices index pages.
 * Skeleton — the cards are unstyled beyond the token palette. Real design later.
 */
import type { Locale } from '@config/site';
import type { LEVEL_KEYS } from '@i18n/ui';
import LevelBadge from '@components/LevelBadge.astro';

export interface CardItem {
  readonly title: string;
  readonly summary: string;
  readonly level: keyof typeof LEVEL_KEYS;
  readonly meta?: string | undefined;
  /** When set, the whole card becomes a link to the detail page. */
  readonly href?: string | undefined;
  /** Free tags rendered as chips. Content vocabulary, not translated. */
  readonly themes?: readonly string[] | undefined;
  /**
   * Content slug this card tracks progress for. When set, the card reserves a
   * status row and renders a hidden "solved" marker that a client script
   * reveals — see the note on `.card-status` below.
   */
  readonly progressKey?: string | undefined;
}

interface Props {
  locale: Locale;
  items: readonly CardItem[];
  emptyMessage: string;
  /** Label for the solved marker. Required once any item has a `progressKey`. */
  solvedLabel?: string | undefined;
}

const { locale, items, emptyMessage, solvedLabel } = Astro.props;
---

{
  items.length === 0 ? (
    <p class="empty">{emptyMessage}</p>
  ) : (
    <ul class="card-grid" data-reveal-stagger>
      {items.map((item) => (
        <li class:list={['card', { 'card-linked': item.href }]} data-reveal>
          <div class="card-head">
            <h2>
              {/* The <a> wraps only the title, but is stretched over the whole
                  card by CSS. That keeps ONE link per card in the a11y tree —
                  wrapping the summary and chips too would make the accessible
                  name a paragraph long. */}
              {item.href ? (
                <a class="card-link" href={item.href}>
                  {item.title}
                </a>
              ) : (
                item.title
              )}
            </h2>
            <LevelBadge locale={locale} level={item.level} />
          </div>
          <p class="card-summary">{item.summary}</p>
          {item.themes && item.themes.length > 0 && (
            <ul class="card-themes">
              {item.themes.map((theme) => (
                <li class="chip">{theme}</li>
              ))}
            </ul>
          )}
          {item.meta && <p class="card-meta">{item.meta}</p>}
          {/*
            PROGRESS. The row is ALWAYS rendered and always reserves its height,
            so revealing the marker cannot reflow the grid — the card is the
            same size before and after the script runs.

            `hidden` rather than `visibility: hidden`: an unsolved card must not
            have a stray "Solved" sitting in the accessibility tree waiting to
            be read out. The whole marker is absent until it is true.
          */}
          {item.progressKey && (
            <p class="card-status">
              <span class="card-solved" data-solved-for={item.progressKey} hidden>
                <span aria-hidden="true">✓</span> {solvedLabel}
              </span>
            </p>
          )}
        </li>
      ))}
    </ul>
  )
}

<style>
  .card-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    padding: 1.25rem;
    background-color: var(--mcc-surface-raised);
    border: 1px solid var(--mcc-border-subtle);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-lift);
  }

  /* Whole-card click target, single link in the a11y tree. */
  .card-linked {
    position: relative;
    transition:
      border-color var(--motion-response) var(--ease-response),
      transform var(--motion-response) var(--ease-response);
  }

  .card-linked:hover {
    border-color: var(--mcc-accent);
    transform: translateY(-2px);
  }

  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-card);
  }

  .card-link {
    color: inherit;
    text-decoration: none;
  }

  .card-link:hover {
    text-decoration: underline;
  }

  /* The stretched pseudo-element carries no outline, so focus is drawn on the
     card instead — otherwise a keyboard user sees a ring around nothing. */
  .card-linked:focus-within {
    outline: 2px solid var(--mcc-focus-ring);
    outline-offset: 3px;
  }

  .card-link:focus-visible {
    outline: none;
  }

  .card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
  }

  .card-head h2 {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.25;
  }

  .card-summary {
    margin: 0;
    color: var(--mcc-text-secondary);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .card-themes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
  }

  .chip {
    padding: 0.15rem 0.55rem;
    background-color: var(--mcc-surface-sunken);
    border: 1px solid var(--mcc-border-subtle);
    border-radius: var(--radius-pill);
    color: var(--mcc-text-secondary);
    font-size: var(--text-2xs);
    letter-spacing: 0.02em;
  }

  .card-meta {
    margin: 0.75rem 0 0;
    color: var(--mcc-text-secondary);
    font-family: var(--font-notation);
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Fixed height whether or not the marker inside is shown — this is the whole
     reason the row exists as its own element. */
  .card-status {
    display: flex;
    align-items: center;
    min-height: 1.5rem;
    margin: 0.75rem 0 0;
  }

  .card-solved {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0.6rem;
    /* green-700 fill with the cream label — the same AA-proved pair as the
       primary CTA. Never the level-badge mid-tones. */
    background-color: var(--mcc-primary);
    color: var(--mcc-primary-contrast);
    border-radius: var(--radius-pill);
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .empty {
    color: var(--mcc-text-secondary);
  }
</style>
