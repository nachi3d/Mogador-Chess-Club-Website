---
/**
 * /compte — display name, language, sign out.
 *
 * Minimal on purpose. Progress sync is v2-S3 and attendance is v2-S4; both are
 * marked "à venir" here rather than hidden, so a reader can see the shape of
 * what an account is for.
 *
 * ⚠️ The whole page renders server-side in its signed-OUT state and is revealed
 * by script. There is no SSR to ask "who is this?", so the HTML cannot know —
 * and rendering a signed-in shell that flashes for guests would be worse.
 */
import type { Locale } from '@config/site';
import { localizePath } from '@i18n/paths';
import { useTranslations } from '@i18n/ui';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/PageIntro.astro';
import FamilySection from '@components/account/FamilySection.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={t('account.title')} description={t('account.intro')}>
  <PageIntro title={t('account.title')} intro={t('account.intro')} />

  <div
    class="account"
    data-testid="account"
    data-state="loading"
    data-locale={locale}
    data-msg-saved={t('account.saved')}
    data-msg-error={t('account.saveError')}
    data-msg-imported={t('account.import.recovered')}
    data-msg-synced={t('account.import.upToDate')}
    data-msg-sync-ok={t('account.sync.ok')}
    data-msg-sync-pending={t('account.sync.pending')}
    data-msg-delete-word={t('account.delete.confirmWord')}
    data-msg-delete-working={t('account.delete.working')}
    data-msg-delete-error={t('account.delete.error')}
  >
    {/* Signed out — the default, because that is what a static page can prove. */}
    <div class="account-signed-out" data-testid="account-signed-out" hidden>
      <p>{t('account.signedOut')}</p>
      <p>
        <a class="btn-primary" href={localizePath('/connexion/', locale)}>
          {t('account.goSignIn')}
        </a>
      </p>
    </div>

    <div class="account-panel" data-testid="account-panel" hidden>
      {/* ── What this account IS ──────────────────────────────────────────
          ⚠️ THE MODEL IS NOT GUESSABLE, AND A PARENT WHO GUESSES IT WRONG
          LOOKS FOR THEIR CHILD IN THE WRONG PLACE. The account belongs to the
          adult and is identified by their email; a student is a profile
          underneath it. Without this block a parent reads "Prénom affiché" at
          the top of the page and reasonably concludes it is their child's.

          ⚠️ THE THIRD SENTENCE IS FOR THE AUTONOMOUS TEENAGER. An account
          holding exactly one child is the same object whether it belongs to a
          parent or to the student themselves (Critical Feature 40) — the site
          cannot tell and must not guess. Naming that case out loud is cheaper
          and more honest than copy that tries to be vague enough to cover it. */}
      <section class="account-model" data-testid="account-model">
        <h2>{t('account.model.heading')}</h2>
        <p>{t('account.model.body')}</p>
        <p class="account-model-teen">{t('account.model.teen')}</p>
      </section>

      <dl class="account-facts">
        {/* "Titulaire du compte", not "Adresse e-mail": the label is where the
            ownership is stated, and the value happens to be the address. */}
        <dt>{t('account.holder')}</dt>
        <dd data-testid="account-email"></dd>
        <dt>{t('account.role')}</dt>
        <dd data-testid="account-role"></dd>
      </dl>

      <form class="account-form" data-testid="account-form">
        <label for="account-display-name">{t('account.displayName')}</label>
        <input
          id="account-display-name"
          type="text"
          maxlength="40"
          autocomplete="given-name"
          data-testid="account-display-name"
        />

        <label for="account-locale">{t('account.locale')}</label>
        <select id="account-locale" data-testid="account-locale">
          <option value="fr">Français</option>
          <option value="en">English</option>
        </select>

        <button type="submit" class="btn-primary" data-testid="account-save">
          {t('account.save')}
        </button>
        <p class="account-status" role="status" data-testid="account-status"></p>
      </form>

      {/* ⚠️ ALWAYS RENDERED FOR A SIGNED-IN ACCOUNT — the section reveals
          itself once it knows who is signed in, and only the "Qui joue ?"
          picker inside it is conditional on holding more than one child.
          Those two rules were one until v0.11.x, which made "Ajouter un
          élève" unreachable for every normal account. */}
      <FamilySection locale={locale} />

      {/* ── v2-S3 — the real progress section ────────────────────────────
          ⚠️ EVERY NUMBER HERE IS DERIVED, NOT STORED. The counts come from the
          same local store the rest of the site reads and the same ledger
          `/progres/` uses; nothing about a total is fetched or kept. See the
          anti-cheat note in CLAUDE.md. */}
      <section class="account-progress" data-testid="account-progress">
        <h2>{t('account.progress.heading')}</h2>
        {/* Filled by the script below — the import report, shown ONCE after a
            sign-in that recovered something. Silent success is
            indistinguishable from silent loss. */}
        <p class="account-import" data-testid="sync-import" role="status" aria-live="polite"></p>
        <dl class="account-stats">
          <div>
            <dt>{t('progress.exercises')}</dt>
            <dd data-account-solved>0</dd>
          </div>
          <div>
            <dt>{t('score.pointsLabel')}</dt>
            <dd data-score-points>0</dd>
          </div>
          <div>
            <dt>{t('score.title')}</dt>
            <dd data-score-rank></dd>
          </div>
        </dl>
        <p class="account-sync" data-testid="account-sync-state"></p>
      </section>

      {/* ── The way into the admin surfaces (v2-S4) ────────────────────────
          ⚠️ THIS IS THE ONLY ENTRY POINT, AND IT IS DELIBERATELY HERE.

          Not the nav: the header is already at five entries and wraps between
          768 and 1024px, and a link almost every reader would never be allowed
          to follow does not earn a permanent slot. Not the mobile bottom bar
          either — that has exactly four entries (Critical Feature 27).

          `/compte/` is reachable from the account button in the header at every
          width, so Critical Feature 36 holds: there is no layout on which this
          is reachable and another on which it is not. `admin.spec.ts` asserts
          it at phone and desktop widths.

          ⚠️ HIDDEN IS UX, NOT SECURITY. The link is revealed by the script
          below when the profile says prof or admin; a student who un-hides it
          in devtools reaches a page whose every query RLS answers with nothing.
          The label is French because the destination is. */}
      <section class="account-staff" data-testid="account-staff" hidden>
        <h2>Espace encadrants</h2>
        <p>Classe, séances et présences.</p>
        <p>
          <a class="btn-primary" href="/admin/" data-testid="account-admin-link">
            Ouvrir l’espace encadrants
          </a>
        </p>
      </section>

      <section class="account-soon">
        <h2>
          {t('account.attendance.heading')}
          <span class="soon-badge">{t('account.attendance.soon')}</span>
        </h2>
        <p>{t('account.attendance.body')}</p>
      </section>

      <p>
        <button type="button" class="btn-ghost" data-testid="account-signout">
          {t('auth.signOut')}
        </button>
      </p>

      {/* ── Erasure ──────────────────────────────────────────────────────
          ⚠️ LAST ON THE PAGE, AND BEHIND TWO DELIBERATE STEPS.

          The privacy notice has always promised erasure on request; until now
          that promise was kept by a volunteer remembering to run a SQL
          statement. This is the button.

          ⚠️ THE SECOND STEP IS A TYPED WORD, NOT A SECOND BUTTON. Two buttons
          in the same place is one mis-tap on a phone, and this is the one
          action on the site that a child could take on a family tablet and
          nobody could undo. Typing costs a parent four seconds and costs a
          curious eight-year-old the whole idea.

          ⚠️ THE LIST NAMES WHAT GOES. "Are you sure?" tells a reader nothing;
          the words "progression" and "présences" have to be read BEFORE the
          confirmation, not discovered after it. */}
      <section class="account-delete" data-testid="account-delete">
        <h2>{t('account.delete.heading')}</h2>
        <p>{t('account.delete.body')}</p>
        <p>{t('account.delete.listIntro')}</p>
        <ul>
          <li>{t('account.delete.item.account')}</li>
          <li>{t('account.delete.item.children')}</li>
          <li>{t('account.delete.item.progress')}</li>
          <li>{t('account.delete.item.points')}</li>
          <li>{t('account.delete.item.attendance')}</li>
        </ul>
        <p class="account-delete-retained">{t('account.delete.retained')}</p>

        <button type="button" class="btn-ghost" data-testid="account-delete-start">
          {t('account.delete.start')}
        </button>

        <div class="account-delete-confirm" data-testid="account-delete-confirm" hidden>
          <h3>{t('account.delete.confirmHeading')}</h3>
          <label for="account-delete-word">
            {t('account.delete.confirmPrompt').replace('%s', t('account.delete.confirmWord'))}
          </label>
          <input
            id="account-delete-word"
            type="text"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            data-testid="account-delete-word"
          />
          <p class="account-delete-actions">
            {/* ⚠️ Disabled until the word matches. The control that cannot be
                undone is the one that must not be reachable by reflex. */}
            <button
              type="button"
              class="btn-ghost account-delete-go"
              data-testid="account-delete-go"
              disabled
            >
              {t('account.delete.confirm')}
            </button>
            <button type="button" class="btn-ghost" data-testid="account-delete-cancel">
              {t('account.delete.cancel')}
            </button>
          </p>
          <p class="account-status" role="status" data-testid="account-delete-status"></p>
        </div>
      </section>
    </div>
  </div>

  <script>
    import { deleteOwnAccount, getProfile, getSession, signOut, updateProfile } from '@lib/supabase';
    /* ⚠️ v2-S3 — through `progress.ts` ONLY. This page never touches the sync
       module or Supabase for progress: `progress.ts` is still the single
       reader, and it is the one that decides what the durable copy does. */
    import { importFromCloud, readProgress, solvedSlugs, startSync, syncState } from '@lib/progress';

    const root = document.querySelector('[data-testid="account"]') as HTMLElement | null;
    const signedOut = document.querySelector('[data-testid="account-signed-out"]') as HTMLElement | null;
    const panel = document.querySelector('[data-testid="account-panel"]') as HTMLElement | null;
    const emailEl = document.querySelector('[data-testid="account-email"]') as HTMLElement | null;
    const roleEl = document.querySelector('[data-testid="account-role"]') as HTMLElement | null;
    const nameInput = document.querySelector('[data-testid="account-display-name"]') as HTMLInputElement | null;
    const localeSelect = document.querySelector('[data-testid="account-locale"]') as HTMLSelectElement | null;
    const form = document.querySelector('[data-testid="account-form"]') as HTMLFormElement | null;
    const status = document.querySelector('[data-testid="account-status"]') as HTMLElement | null;
    const signOutBtn = document.querySelector('[data-testid="account-signout"]') as HTMLButtonElement | null;

    const roleLabels: Record<string, string> = {
      admin: root?.dataset.locale === 'en' ? 'Administrator' : 'Administrateur',
      prof: root?.dataset.locale === 'en' ? 'Teacher' : 'Professeur',
      eleve: root?.dataset.locale === 'en' ? 'Student' : 'Élève',
    };

    function showSignedOut() {
      root?.setAttribute('data-state', 'signed-out');
      if (signedOut) signedOut.hidden = false;
      if (panel) panel.hidden = true;
    }

    (async () => {
      const session = await getSession();
      if (!session) {
        showSignedOut();
        return;
      }

      const profile = await getProfile();
      if (emailEl) emailEl.textContent = session.user.email ?? '';
      if (roleEl) roleEl.textContent = profile ? (roleLabels[profile.role] ?? profile.role) : '';
      if (nameInput) nameInput.value = profile?.display_name ?? '';
      if (localeSelect) localeSelect.value = profile?.locale === 'en' ? 'en' : 'fr';

      root?.setAttribute('data-state', 'signed-in');
      if (panel) panel.hidden = false;
      if (signedOut) signedOut.hidden = true;

      /* Staff see the way into /admin. UX only — RLS is the boundary. */
      if (profile?.role === 'prof' || profile?.role === 'admin') {
        const staff = document.querySelector('[data-testid="account-staff"]') as HTMLElement | null;
        if (staff) staff.hidden = false;
      }

      /**
       * ⚠️ THE FIRST-SIGN-IN MERGE, and the moment a guest month is saved or
       * lost. It runs on every visit and is IDEMPOTENT by construction (max /
       * OR / earliest / union by id), so a re-run changes nothing — the
       * bookmark only decides whether the reader is told about it again.
       *
       * It is awaited AFTER the panel is shown: nothing on this page waits on
       * the network, so a dead Supabase leaves a usable account page.
       */
      const importEl = document.querySelector('[data-testid="sync-import"]') as HTMLElement | null;
      const report = await importFromCloud();
      if (importEl) {
        const recovered = report.exercises + report.lessons;
        importEl.textContent =
          report.ran && recovered > 0
            ? (root?.dataset.msgImported ?? '')
                .replace('%s', String(report.exercises))
                .replace('%s', String(report.lessons))
            : (root?.dataset.msgSynced ?? '');
      }

      /* Derived, never stored — the same computation `/progres/` does. */
      const solvedEl = document.querySelector('[data-account-solved]');
      if (solvedEl) solvedEl.textContent = String(solvedSlugs().length);
      void readProgress();

      const syncEl = document.querySelector('[data-testid="account-sync-state"]');
      const paint = () => {
        if (!syncEl) return;
        const key = syncState() === 'synced' ? 'msgSyncOk' : 'msgSyncPending';
        syncEl.textContent = root?.dataset[key] ?? '';
      };
      paint();
      window.addEventListener('mcc:sync-state', paint);
      startSync();
    })();

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status) return;
      status.textContent = '';

      const patch: { display_name?: string; locale?: string } = {};
      if (nameInput) patch.display_name = nameInput.value.trim();
      if (localeSelect) patch.locale = localeSelect.value;

      const result = await updateProfile(patch);
      status.textContent = result.ok
        ? (root?.dataset.msgSaved ?? '')
        : (root?.dataset.msgError ?? '');
    });

    signOutBtn?.addEventListener('click', async () => {
      await signOut();
      /* Full document load, not a client-side swap: it guarantees the header
         re-reads the (now cleared) flag from scratch. */
      window.location.assign(root?.dataset.locale === 'en' ? '/en/' : '/');
    });

    /* ── Erasure ────────────────────────────────────────────────────────── */

    const deleteStart = document.querySelector('[data-testid="account-delete-start"]') as HTMLButtonElement | null;
    const deletePanel = document.querySelector('[data-testid="account-delete-confirm"]') as HTMLElement | null;
    const deleteWord = document.querySelector('[data-testid="account-delete-word"]') as HTMLInputElement | null;
    const deleteGo = document.querySelector('[data-testid="account-delete-go"]') as HTMLButtonElement | null;
    const deleteCancel = document.querySelector('[data-testid="account-delete-cancel"]') as HTMLButtonElement | null;
    const deleteStatus = document.querySelector('[data-testid="account-delete-status"]') as HTMLElement | null;

    function closeDelete() {
      if (deletePanel) deletePanel.hidden = true;
      if (deleteWord) deleteWord.value = '';
      if (deleteGo) deleteGo.disabled = true;
      if (deleteStatus) deleteStatus.textContent = '';
      if (deleteStart) deleteStart.hidden = false;
      deleteStart?.focus();
    }

    deleteStart?.addEventListener('click', () => {
      if (deletePanel) deletePanel.hidden = false;
      /* The trigger goes away while the panel is open: leaving it there offers
         a second "delete" beside the real one, which is a mis-tap waiting. */
      if (deleteStart) deleteStart.hidden = true;
      deleteWord?.focus();
    });

    deleteCancel?.addEventListener('click', closeDelete);

    /**
     * ⚠️ CASE-SENSITIVE, ACCENT-EXACT, TRIMMED ONLY AT THE EDGES.
     *
     * The word is deliberately shouted (`SUPPRIMER` / `DELETE`) and compared
     * exactly. A case-insensitive match would accept a phone's autocapitalised
     * first letter and nothing else typed on purpose — which is most of the
     * friction this step exists to add.
     */
    deleteWord?.addEventListener('input', () => {
      const expected = root?.dataset.msgDeleteWord ?? '';
      if (deleteGo) deleteGo.disabled = deleteWord.value.trim() !== expected;
    });

    deleteGo?.addEventListener('click', async () => {
      if (deleteGo.disabled) return;
      /* Locked while it runs. A double tap on a slow connection would fire a
         second RPC whose only possible answer is "no such user" — an error
         message for an operation that in fact succeeded. */
      deleteGo.disabled = true;
      if (deleteCancel) deleteCancel.disabled = true;
      if (deleteStatus) deleteStatus.textContent = root?.dataset.msgDeleteWorking ?? '';

      const result = await deleteOwnAccount();

      if (!result.ok) {
        if (deleteStatus) deleteStatus.textContent = root?.dataset.msgDeleteError ?? '';
        if (deleteCancel) deleteCancel.disabled = false;
        if (deleteGo) deleteGo.disabled = false;
        return;
      }

      /* Full document load, same reason as sign-out: the header must re-read a
         world in which this account no longer exists. */
      window.location.assign(root?.dataset.locale === 'en' ? '/en/' : '/');
    });
  </script>
</BaseLayout>

<style>
  /* Context, not a warning: the same quiet sunken panel with an accent edge
     that the staff block uses. No opacity over an audited token pair — the
     contrast checker proves the pair and cannot see an alpha laid on top. */
  .account-model {
    margin-bottom: 1.5rem;
    padding: 1rem 1.25rem;
    border-inline-start: 3px solid var(--mcc-accent);
    border-radius: var(--radius-card);
    background-color: var(--mcc-surface-sunken);
  }

  .account-model h2 {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
  }

  .account-model p {
    margin: 0 0 0.6rem;
    line-height: 1.6;
  }

  .account-model p:last-child {
    margin-bottom: 0;
  }

  .account-model-teen {
    color: var(--mcc-text-secondary);
    font-size: 0.9375rem;
  }

  .account-facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.35rem 1rem;
    margin: 0 0 1.5rem;
  }

  .account-facts dt {
    color: var(--mcc-text-secondary);
  }

  .account-facts dd {
    margin: 0;
  }

  .account-form {
    max-width: 26rem;
    margin-bottom: 2rem;
  }

  .account-form label {
    display: block;
    margin: 1rem 0 0.35rem;
    font-weight: 500;
  }

  .account-form input,
  .account-form select {
    width: 100%;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--mcc-border-strong);
    border-radius: var(--radius-card);
    background-color: var(--mcc-surface-page);
    color: var(--mcc-text-primary);
    font: inherit;
  }

  .btn-primary {
    margin-top: 1rem;
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--mcc-primary);
    border-radius: var(--radius-card);
    background-color: var(--mcc-primary);
    color: var(--mcc-primary-contrast);
    font: inherit;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
  }

  .btn-ghost {
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--mcc-border-strong);
    border-radius: var(--radius-card);
    background: none;
    color: var(--mcc-link);
    font: inherit;
    cursor: pointer;
  }

  .account-status {
    margin: 0.75rem 0 0;
    color: var(--mcc-text-secondary);
  }

  /* The staff block reads as a destination, not a notice: a solid accent edge
     rather than the dashed "coming soon" border below it. */
  .account-staff {
    margin-bottom: 1.5rem;
    padding: 1rem 1.25rem;
    border-inline-start: 3px solid var(--mcc-accent);
    background-color: var(--mcc-surface-sunken);
    border-radius: var(--radius-card);
  }

  .account-staff h2 {
    margin: 0 0 0.4rem;
    font-size: 1.125rem;
  }

  .account-staff p {
    margin: 0 0 0.75rem;
    color: var(--mcc-text-secondary);
  }

  .account-soon {
    margin-bottom: 1.5rem;
    padding: 1rem 1.25rem;
    border: 1px dashed var(--mcc-border-strong);
    border-radius: var(--radius-card);
  }

  .account-soon h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.4rem;
    font-size: 1.125rem;
  }

  .account-soon p {
    margin: 0;
    color: var(--mcc-text-secondary);
  }

  /* ⚠️ MARKED BY ITS EDGE AND ITS WORDS, NOT BY RED FILL AND NOT BY OPACITY.
     A red panel reads as "error" on a page that has an error line already, and
     an alpha over an audited pair is exactly what `check-contrast.mjs` cannot
     see. This is a section of the page a reader chose to scroll to; it needs to
     be findable and unmistakable, not alarming. */
  .account-delete {
    margin-top: 2.5rem;
    padding: 1.25rem;
    border: 1px solid var(--mcc-border-strong);
    border-inline-start: 4px solid var(--mcc-accent-strong);
    border-radius: var(--radius-card);
  }

  .account-delete h2 {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
  }

  .account-delete h3 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }

  .account-delete p {
    margin: 0 0 0.6rem;
    line-height: 1.55;
  }

  .account-delete ul {
    margin: 0 0 0.75rem;
    padding-inline-start: 1.25rem;
    line-height: 1.6;
  }

  .account-delete-retained {
    color: var(--mcc-text-secondary);
    font-size: 0.9375rem;
  }

  .account-delete-confirm {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--mcc-border-subtle);
  }

  .account-delete-confirm label {
    display: block;
    margin-bottom: 0.35rem;
    font-weight: 500;
  }

  .account-delete-confirm input {
    width: 100%;
    max-width: 18rem;
    min-height: 2.75rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--mcc-border-strong);
    border-radius: var(--radius-card);
    background-color: var(--mcc-surface-page);
    color: var(--mcc-text-primary);
    font: inherit;
    letter-spacing: 0.08em;
  }

  .account-delete-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  /* Disabled must LOOK unavailable without relying on colour alone — the
     cursor and the border both change, and the label never greys below AA. */
  .account-delete-go[disabled] {
    border-style: dashed;
    color: var(--mcc-text-secondary);
    cursor: not-allowed;
  }

  .soon-badge {
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background-color: var(--color-brass-300);
    color: var(--color-ink-950);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
