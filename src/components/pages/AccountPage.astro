---
/**
 * /compte — THREE BLOCKS, ORDERED BY WHAT A READER CAME FOR.
 *
 * ═════════════════════════════════════════════════════════════════════════
 * ⚠️ IT WAS ONE FLAT COLUMN, AND THAT IS THE DEFECT THIS SHAPE FIXES.
 *
 * The email address, the interface language, the "coming soon" notice and
 * PERMANENT ACCOUNT DELETION all had exactly the same visual weight as the
 * children's progress. Everything was equally important, which is the same as
 * nothing being important, and the one irreversible control on the site sat in
 * the flow as though it were a preference.
 *
 *   1. TOP — the profiles. Names, ranks, progress; add, rename, remove. This is
 *      the page's subject and it is the only block that is open by default.
 *   2. MIDDLE — account settings, behind a disclosure. Email, name, language.
 *   3. BOTTOM — "Options avancées", behind a second disclosure. Deletion.
 *
 * ⚠️ `<details>`, NOT A SCRIPTED TOGGLE. It works with no JavaScript, it is
 * keyboard-operable and screen-reader-announced for free, and browser find-in-
 * page opens it. A scripted accordion would be three of those behaviours
 * reimplemented worse, on a page a parent reaches once a term.
 *
 * ⚠️ SIGNING OUT IS NOT BEHIND A DISCLOSURE. It is ordinary, frequent and
 * harmless; burying it next to deletion would be the same mistake in reverse.
 *
 * ⚠️ The whole page renders server-side in its signed-OUT state and is revealed
 * by script. There is no SSR to ask "who is this?", so the HTML cannot know —
 * and rendering a signed-in shell that flashes for guests would be worse.
 * ═════════════════════════════════════════════════════════════════════════
 */
import type { Locale } from '@config/site';
import { localizePath } from '@i18n/paths';
import { useTranslations } from '@i18n/ui';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/PageIntro.astro';
import Trail from '@components/nav/Trail.astro';
import FamilySection from '@components/account/FamilySection.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={t('account.title')} description={t('account.intro')}>
  <Trail locale={locale} href={localizePath('/moi/', locale)} label={t('me.title')} />
  <PageIntro title={t('account.title')} intro={t('account.intro')} />

  <div
    class="account"
    data-testid="account"
    data-state="loading"
    data-locale={locale}
    data-msg-saved={t('account.saved')}
    data-msg-error={t('account.saveError')}
    data-msg-imported={t('account.import.recovered')}
    data-msg-synced={t('account.import.upToDate')}
    data-msg-sync-ok={t('account.sync.ok')}
    data-msg-sync-pending={t('account.sync.pending')}
    data-msg-delete-word={t('account.delete.confirmWord')}
    data-msg-delete-working={t('account.delete.working')}
    data-msg-delete-error={t('account.delete.error')}
  >
    {/* Signed out — the default, because that is what a static page can prove. */}
    <div class="account-signed-out" data-testid="account-signed-out" hidden>
      <p>{t('account.signedOut')}</p>
      <p>
        <a class="btn-primary" href={localizePath('/connexion/', locale)}>
          {t('account.goSignIn')}
        </a>
      </p>
    </div>

    <div class="account-panel" data-testid="account-panel" hidden>
      {/* ══ 1. THE PROFILES ════════════════════════════════════════════════
          ⚠️ ALWAYS RENDERED FOR A SIGNED-IN ACCOUNT — the section reveals
          itself once it knows who is signed in, and only the "Qui joue ?"
          picker inside it is conditional on holding more than one profile.
          Those two rules were one until v0.11.x, which made the add form
          unreachable for every normal account. */}
      <FamilySection locale={locale} />

      {/* The import report — shown ONCE after a sign-in that recovered
          something, and it belongs beside the profiles because that is what it
          is about. Silent success is indistinguishable from silent loss. */}
      <p class="account-import" data-testid="sync-import" role="status" aria-live="polite"></p>

      {/* ── The way into the admin surfaces (v2-S4) ────────────────────────
          ⚠️ THIS IS THE ONLY ENTRY POINT, AND IT IS DELIBERATELY HERE.

          Not the nav: the header is already at five entries and wraps between
          768 and 1024px, and a link almost every reader would never be allowed
          to follow does not earn a permanent slot. Not the mobile bottom bar
          either — that has exactly four entries (Critical Feature 27).

          `/compte/` is reachable from the account button in the header at every
          width, so Critical Feature 36 holds. ⚠️ AND IT STAYS OUTSIDE BOTH
          DISCLOSURES: a prof opening the site on a phone at Dar Souiri must not
          have to know that "Réglages du compte" is where the register lives.

          ⚠️ HIDDEN IS UX, NOT SECURITY. The link is revealed by the script
          below when the profile says prof or admin; a student who un-hides it
          in devtools reaches a page whose every query RLS answers with nothing.
          The label is French because the destination is. */}
      <section class="account-staff mcc-card mcc-card-accent" data-testid="account-staff" hidden>
        <h2>Espace encadrants</h2>
        <p>Classe, séances et présences.</p>
        <p>
          <a class="btn-primary" href="/admin/" data-testid="account-admin-link">
            Ouvrir l’espace encadrants
          </a>
        </p>
      </section>

      {/* ══ 2. ACCOUNT SETTINGS ════════════════════════════════════════════ */}
      <details class="account-block mcc-card" data-testid="account-settings">
        <summary>
          <span class="account-block-title">{t('account.settings.heading')}</span>
          <span class="account-block-hint">{t('account.settings.summary')}</span>
        </summary>

        <div class="account-block-body">
          <dl class="account-facts">
            {/* "Titulaire du compte", not "Adresse e-mail": the label is where
                the ownership is stated, and the value happens to be the
                address. */}
            <dt>{t('account.holder')}</dt>
            <dd data-testid="account-email"></dd>
            <dt>{t('account.role')}</dt>
            <dd data-testid="account-role"></dd>
          </dl>

          <form class="account-form" data-testid="account-form">
            <label for="account-display-name">{t('account.displayName')}</label>
            {/* ⚠️ THE HINT IS NOT DECORATION. "Prénom affiché" told a parent
                nothing — displayed where, and whose? A parent reading it at the
                top of the old flat page reasonably concluded it was their
                child's, which is exactly the confusion the whole redesign is
                about. */}
            <p class="account-field-hint" id="account-display-name-hint">
              {t('account.displayNameHint')}
            </p>
            <input
              id="account-display-name"
              type="text"
              maxlength="40"
              autocomplete="given-name"
              aria-describedby="account-display-name-hint"
              data-testid="account-display-name"
            />
            {/* ⚠️ THE PLACEHOLDER IS CALLED OUT HERE TOO, AND THAT IS THE
                SKIPPED-ONBOARDING PATH. A reader who dismissed `/bienvenue/`
                still has `nachiketas3d` sitting in this field, and nothing
                anywhere would otherwise suggest it could be changed. Shown only
                when the value is an EXACT match for the email local part — a
                test of "nobody has ever typed this", not a guess about what
                names look like. */}
            <p
              class="account-field-warning"
              data-testid="account-name-placeholder"
              hidden
            >
              {t('account.displayNamePlaceholder')}
            </p>

            <label for="account-locale">{t('account.locale')}</label>
            <select id="account-locale" data-testid="account-locale">
              <option value="fr">Français</option>
              <option value="en">English</option>
            </select>

            <button type="submit" class="btn-primary" data-testid="account-save">
              {t('account.save')}
            </button>
            <p class="account-status" role="status" data-testid="account-status"></p>
          </form>

          {/* ⚠️ THE MODEL EXPLAINER LIVES HERE NOW. It used to open the page,
              which was right when nothing else explained anything. Since
              `/bienvenue/` asks who the account is for, the profiles block above
              opens with a sentence written for THIS reader — so the general
              model is reference material, and reference material belongs with
              the settings rather than above the thing it describes.

              ⚠️ THE COPY NAMES THE STRUCTURE, NEVER THE RELATIONSHIP (Critical
              Feature 54). An account holding exactly one profile is the same
              object whether it belongs to a parent or to a teenager who signed
              up alone, and this paragraph has to be true for both. */}
          <section class="account-model" data-testid="account-model">
            <h3>{t('account.model.heading')}</h3>
            <p>{t('account.model.body')}</p>
            <p class="account-model-teen">{t('account.model.teen')}</p>
          </section>

          <p class="account-sync" data-testid="account-sync-state"></p>

          <section class="account-soon">
            <h3>
              {t('account.attendance.heading')}
              <span class="soon-badge">{t('account.attendance.soon')}</span>
            </h3>
            <p>{t('account.attendance.body')}</p>
          </section>
        </div>
      </details>

      <p class="account-signout-row">
        <button type="button" class="btn-ghost" data-testid="account-signout">
          {t('auth.signOut')}
        </button>
      </p>

      {/* ══ 3. ADVANCED — erasure ══════════════════════════════════════════
          ⚠️ LAST ON THE PAGE, COLLAPSED, AND BEHIND TWO FURTHER STEPS.

          It used to compete with everything above it: a full section with a
          heading, a list and a button, in the same column as "Langue". The
          privacy notice has always promised erasure and this is the button that
          keeps that promise — it has to be FINDABLE, which is not the same as
          being in the way.

          ⚠️ THE SECOND STEP IS A TYPED WORD, NOT A SECOND BUTTON. Two buttons
          in the same place is one mis-tap on a phone, and this is the one
          action on the site that a child could take on a family tablet and
          nobody could undo. Typing costs a parent four seconds and costs a
          curious eight-year-old the whole idea.

          ⚠️ THE LIST NAMES WHAT GOES. "Are you sure?" tells a reader nothing;
          the words "progression" and "présences" have to be read BEFORE the
          confirmation, not discovered after it. */}
      <details class="account-block account-block-danger mcc-card" data-testid="account-advanced">
        <summary>
          <span class="account-block-title">{t('account.advanced.heading')}</span>
          <span class="account-block-hint">{t('account.advanced.summary')}</span>
        </summary>

        <div class="account-block-body">
          <section class="account-delete" data-testid="account-delete">
            <h3>{t('account.delete.heading')}</h3>
            <p>{t('account.delete.body')}</p>
            <p>{t('account.delete.listIntro')}</p>
            <ul>
              <li>{t('account.delete.item.account')}</li>
              <li>{t('account.delete.item.children')}</li>
              <li>{t('account.delete.item.progress')}</li>
              <li>{t('account.delete.item.points')}</li>
              <li>{t('account.delete.item.attendance')}</li>
            </ul>
            <p class="account-delete-retained">{t('account.delete.retained')}</p>

            <button type="button" class="btn-ghost" data-testid="account-delete-start">
              {t('account.delete.start')}
            </button>

            <div class="account-delete-confirm" data-testid="account-delete-confirm" hidden>
              <h4>{t('account.delete.confirmHeading')}</h4>
              <label for="account-delete-word">
                {t('account.delete.confirmPrompt').replace('%s', t('account.delete.confirmWord'))}
              </label>
              <input
                id="account-delete-word"
                type="text"
                autocomplete="off"
                autocapitalize="characters"
                spellcheck="false"
                data-testid="account-delete-word"
              />
              <p class="account-delete-actions">
                {/* ⚠️ Disabled until the word matches. The control that cannot
                    be undone is the one that must not be reachable by reflex. */}
                <button
                  type="button"
                  class="btn-ghost account-delete-go"
                  data-testid="account-delete-go"
                  disabled
                >
                  {t('account.delete.confirm')}
                </button>
                <button type="button" class="btn-ghost" data-testid="account-delete-cancel">
                  {t('account.delete.cancel')}
                </button>
              </p>
              <p class="account-status" role="status" data-testid="account-delete-status"></p>
            </div>
          </section>
        </div>
      </details>
    </div>
  </div>

  <script>
    import { deleteOwnAccount, getProfile, getSession, signOut, updateProfile } from '@lib/supabase';
    /* ⚠️ v2-S3 — through `progress.ts` ONLY. This page never touches the sync
       module or Supabase for progress: `progress.ts` is still the single
       reader, and it is the one that decides what the durable copy does. */
    import { importFromCloud, startSync, syncState } from '@lib/progress';

    const root = document.querySelector('[data-testid="account"]') as HTMLElement | null;
    const signedOut = document.querySelector('[data-testid="account-signed-out"]') as HTMLElement | null;
    const panel = document.querySelector('[data-testid="account-panel"]') as HTMLElement | null;
    const emailEl = document.querySelector('[data-testid="account-email"]') as HTMLElement | null;
    const roleEl = document.querySelector('[data-testid="account-role"]') as HTMLElement | null;
    const nameInput = document.querySelector('[data-testid="account-display-name"]') as HTMLInputElement | null;
    const namePlaceholder = document.querySelector('[data-testid="account-name-placeholder"]') as HTMLElement | null;
    const localeSelect = document.querySelector('[data-testid="account-locale"]') as HTMLSelectElement | null;
    const form = document.querySelector('[data-testid="account-form"]') as HTMLFormElement | null;
    const status = document.querySelector('[data-testid="account-status"]') as HTMLElement | null;
    const signOutBtn = document.querySelector('[data-testid="account-signout"]') as HTMLButtonElement | null;

    const roleLabels: Record<string, string> = {
      admin: root?.dataset.locale === 'en' ? 'Administrator' : 'Administrateur',
      prof: root?.dataset.locale === 'en' ? 'Teacher' : 'Professeur',
      eleve: root?.dataset.locale === 'en' ? 'Student' : 'Élève',
    };

    function showSignedOut() {
      root?.setAttribute('data-state', 'signed-out');
      if (signedOut) signedOut.hidden = false;
      if (panel) panel.hidden = true;
    }

    /**
     * ⚠️ IS THIS A NAME, OR THE EMAIL WEARING ONE? Exactly the test
     * `/bienvenue/` makes, for exactly the same reason: an exact match against
     * the local part is a test of "nobody has ever typed this", where a
     * heuristic about what names look like would insult somebody called Alex99.
     *
     * This is the SKIPPED-ONBOARDING path. A reader who dismissed the welcome
     * screen keeps the email fragment as their name, and Critical Feature 52
     * says a skipped onboarding must still leave a usable account — which means
     * the one thing the screen would have fixed has to be visible here.
     */
    function looksLikePlaceholder(name: string, email: string): boolean {
      const local = email.split('@')[0] ?? '';
      if (!local) return false;
      return name.trim().toLowerCase() === local.trim().toLowerCase();
    }

    (async () => {
      const session = await getSession();
      if (!session) {
        showSignedOut();
        return;
      }

      const profile = await getProfile();
      const email = session.user.email ?? '';
      if (emailEl) emailEl.textContent = email;
      if (roleEl) roleEl.textContent = profile ? (roleLabels[profile.role] ?? profile.role) : '';
      if (nameInput) nameInput.value = profile?.display_name ?? '';
      if (localeSelect) localeSelect.value = profile?.locale === 'en' ? 'en' : 'fr';

      if (namePlaceholder && looksLikePlaceholder(profile?.display_name ?? '', email)) {
        namePlaceholder.hidden = false;
        /* ⚠️ THE DISCLOSURE OPENS ITSELF WHEN THERE IS SOMETHING TO FIX. A
           warning inside a collapsed block is a warning nobody reads, and this
           one is the entire remedy for a skipped welcome screen. It does not
           open for anybody else — a settings block that is always open is just
           the flat column again. */
        (document.querySelector('[data-testid="account-settings"]') as HTMLDetailsElement | null)
          ?.setAttribute('open', '');
      }

      root?.setAttribute('data-state', 'signed-in');
      if (panel) panel.hidden = false;
      if (signedOut) signedOut.hidden = true;

      /* Staff see the way into /admin. UX only — RLS is the boundary. */
      if (profile?.role === 'prof' || profile?.role === 'admin') {
        const staff = document.querySelector('[data-testid="account-staff"]') as HTMLElement | null;
        if (staff) staff.hidden = false;
      }

      /**
       * ⚠️ THE FIRST-SIGN-IN MERGE, and the moment a guest month is saved or
       * lost. It runs on every visit and is IDEMPOTENT by construction (max /
       * OR / earliest / union by id), so a re-run changes nothing — the
       * bookmark only decides whether the reader is told about it again.
       *
       * It is awaited AFTER the panel is shown: nothing on this page waits on
       * the network, so a dead Supabase leaves a usable account page.
       */
      const importEl = document.querySelector('[data-testid="sync-import"]') as HTMLElement | null;
      const report = await importFromCloud();
      if (importEl) {
        const recovered = report.exercises + report.lessons;
        importEl.textContent =
          report.ran && recovered > 0
            ? (root?.dataset.msgImported ?? '')
                .replace('%s', String(report.exercises))
                .replace('%s', String(report.lessons))
            : (root?.dataset.msgSynced ?? '');
      }

      const syncEl = document.querySelector('[data-testid="account-sync-state"]');
      const paint = () => {
        if (!syncEl) return;
        const key = syncState() === 'synced' ? 'msgSyncOk' : 'msgSyncPending';
        syncEl.textContent = root?.dataset[key] ?? '';
      };
      paint();
      window.addEventListener('mcc:sync-state', paint);
      startSync();
    })();

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status) return;
      status.textContent = '';

      const patch: { display_name?: string; locale?: string } = {};
      if (nameInput) patch.display_name = nameInput.value.trim();
      if (localeSelect) patch.locale = localeSelect.value;

      const result = await updateProfile(patch);
      status.textContent = result.ok
        ? (root?.dataset.msgSaved ?? '')
        : (root?.dataset.msgError ?? '');
      /* A name that was the email fragment and has just been replaced is no
         longer a placeholder — the warning must not outlive the problem. */
      if (result.ok && namePlaceholder) namePlaceholder.hidden = true;
    });

    signOutBtn?.addEventListener('click', async () => {
      await signOut();
      /* Full document load, not a client-side swap: it guarantees the header
         re-reads the (now cleared) flag from scratch. */
      window.location.assign(root?.dataset.locale === 'en' ? '/en/' : '/');
    });

    /* ── Erasure ────────────────────────────────────────────────────────── */

    const deleteStart = document.querySelector('[data-testid="account-delete-start"]') as HTMLButtonElement | null;
    const deletePanel = document.querySelector('[data-testid="account-delete-confirm"]') as HTMLElement | null;
    const deleteWord = document.querySelector('[data-testid="account-delete-word"]') as HTMLInputElement | null;
    const deleteGo = document.querySelector('[data-testid="account-delete-go"]') as HTMLButtonElement | null;
    const deleteCancel = document.querySelector('[data-testid="account-delete-cancel"]') as HTMLButtonElement | null;
    const deleteStatus = document.querySelector('[data-testid="account-delete-status"]') as HTMLElement | null;

    function closeDelete() {
      if (deletePanel) deletePanel.hidden = true;
      if (deleteWord) deleteWord.value = '';
      if (deleteGo) deleteGo.disabled = true;
      if (deleteStatus) deleteStatus.textContent = '';
      if (deleteStart) deleteStart.hidden = false;
      deleteStart?.focus();
    }

    deleteStart?.addEventListener('click', () => {
      if (deletePanel) deletePanel.hidden = false;
      /* The trigger goes away while the panel is open: leaving it there offers
         a second "delete" beside the real one, which is a mis-tap waiting. */
      if (deleteStart) deleteStart.hidden = true;
      deleteWord?.focus();
    });

    deleteCancel?.addEventListener('click', closeDelete);

    /**
     * ⚠️ CASE-SENSITIVE, ACCENT-EXACT, TRIMMED ONLY AT THE EDGES.
     *
     * The word is deliberately shouted (`SUPPRIMER` / `DELETE`) and compared
     * exactly. A case-insensitive match would accept a phone's autocapitalised
     * first letter and nothing else typed on purpose — which is most of the
     * friction this step exists to add.
     */
    deleteWord?.addEventListener('input', () => {
      const expected = root?.dataset.msgDeleteWord ?? '';
      if (deleteGo) deleteGo.disabled = deleteWord.value.trim() !== expected;
    });

    deleteGo?.addEventListener('click', async () => {
      if (deleteGo.disabled) return;
      /* Locked while it runs. A double tap on a slow connection would fire a
         second RPC whose only possible answer is "no such user" — an error
         message for an operation that in fact succeeded. */
      deleteGo.disabled = true;
      if (deleteCancel) deleteCancel.disabled = true;
      if (deleteStatus) deleteStatus.textContent = root?.dataset.msgDeleteWorking ?? '';

      const result = await deleteOwnAccount();

      if (!result.ok) {
        if (deleteStatus) deleteStatus.textContent = root?.dataset.msgDeleteError ?? '';
        if (deleteCancel) deleteCancel.disabled = false;
        if (deleteGo) deleteGo.disabled = false;
        return;
      }

      /* Full document load, same reason as sign-out: the header must re-read a
         world in which this account no longer exists. */
      window.location.assign(root?.dataset.locale === 'en' ? '/en/' : '/');
    });
  </script>
</BaseLayout>

<style>
  /* ── The two disclosures ────────────────────────────────────────────────
     ⚠️ NATIVE `<details>`, STYLED — not reimplemented. It works with no JS, it
     is keyboard-operable and announced for free, and find-in-page opens it. */
  /* ⚠️ SURFACE, BORDER AND RADIUS COME FROM `.mcc-card` NOW — see
     `src/styles/surfaces.css`. This block used to declare its own, at 3px and
     with no shadow, while `.account-staff` declared a THIRD treatment beside
     it. Three cards, three looks, on one page.

     What stays here is only what a disclosure needs: the summary is the whole
     control, so the card's padding moves onto the two halves instead. */
  .account-block {
    padding: 0;
  }

  .account-block summary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.75rem;
    align-items: baseline;
    /* Comfortably past the 44px target: this is the whole control. */
    min-height: 3rem;
    padding: 0.85rem 1.1rem;
    border-radius: var(--radius-card);
    cursor: pointer;
  }

  .account-block summary:focus-visible {
    outline: 2px solid var(--mcc-focus-ring);
    outline-offset: 2px;
  }

  .account-block-title {
    font-size: 1.0625rem;
    font-weight: 600;
  }

  /* ⚠️ NO `opacity` ON TEXT OVER AN AUDITED FILL — `check-contrast.mjs` proves
     the token PAIR and cannot see an alpha laid on top of it. Differentiated by
     size and by its own audited token. */
  .account-block-hint {
    color: var(--mcc-text-secondary);
    font-size: 0.9375rem;
  }

  .account-block-body {
    padding: 0 1.1rem 1.25rem;
    border-block-start: 1px solid var(--mcc-border-subtle);
    padding-block-start: 1.1rem;
  }

  /* The danger block is marked by its edge and its words, NOT by a red fill and
     not by opacity. A red panel reads as "error" rather than "this is the part
     you should be careful with", and it is a section a reader chose to open. */
  /* ⚠️ THE GOLD LEFT BORDER IS GONE FROM HERE, DELIBERATELY.
     It marked the DANGER block in the accent colour — the same gold the site
     uses to say "this is the thing to press". Marking permanent deletion with
     the primary-action colour is the wrong signal twice over, and it was also
     the reason gold meant nothing anywhere else: everything had it.

     The gold edge now appears on ONE card per page, on the primary action.
     Danger is told by its heading and its button, which is `.btn-danger`. */
  .account-block-danger summary .account-block-title {
    color: var(--mcc-danger-text);
  }

  /* ── One rhythm for the whole panel ──────────────────────────────────────
     ⚠️ THE GAPS HERE WERE NOT DECISIONS. This container had no styles at all,
     so the distance between two blocks was whichever margin the upper one
     happened to carry — which is how the page came to show a ~40px gap in one
     place and a ~200px one in another. The gap is now chosen once, from the
     scale in `tokens.css`, and the children's own margins are cleared so they
     cannot re-introduce it.

     ⚠️⚠️ `:not([hidden])` IS LOAD-BEARING, NOT TIDINESS. `display: flex` beats
     the `hidden` attribute's `display: none`, so an unguarded rule here would
     reveal the whole signed-in panel — email, profiles, deletion — to every
     signed-out reader, on a page that renders signed-out by construction. */
  .account-panel:not([hidden]) {
