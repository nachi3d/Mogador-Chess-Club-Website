---
/**
 * /agenda — the club's sessions, from the database.
 *
 * ⚠️ BAKED AT BUILD TIME, AND THE READ IS NOT OPTIONAL TO UNDERSTAND. The list
 * comes from `sessions` via `scripts/fetch-agenda.mjs`, not from a runtime
 * fetch: this page is public, and Critical Feature 9 means an anonymous visitor
 * makes no third-party request at all. The full argument is in the header of
 * that script — read it before proposing a client-side read.
 *
 * ⚠️ THE FAILURE MODE IS STALENESS, AND IT IS HANDLED WHERE IT CAN BE. A
 * session published after the last deploy is not here. This page cannot know
 * that; `/admin/seances` can, and says so to the prof who published it.
 */
import type { Locale } from '@config/site';
import { site } from '@config/site';
import { publicSessions } from '@lib/agenda';
import { useTranslations } from '@i18n/ui';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/PageIntro.astro';
import Trail from '@components/nav/Trail.astro';
import { localizePath } from '@i18n/paths';
import LevelBadge from '@components/LevelBadge.astro';
/* The booking controls render only when accounts are on — with the flag off
   there is no `/connexion/` route to send a reader to, so the invitation would
   point nowhere. This gates the MARKUP; what keeps the SCRIPT out of the
   bundle is the alias, not this flag. See the note above the script block. */
import { AUTH_ENABLED } from '@config/auth';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const sessions = publicSessions();

/* ⚠️ `T12:00:00Z` rather than the bare date. `new Date('2026-09-12')` is parsed
   as midnight UTC, and formatting that in a zone behind UTC prints the 11th.
   Midday is far enough from either edge that no zone on earth moves the day.
   The date string itself is already local to the club — the resolving was done
   at bake time, in `site.timezone`, exactly once. */
const asDate = (date: string) => new Date(`${date}T12:00:00Z`);

const dateFormat = new Intl.DateTimeFormat(locale === 'fr' ? 'fr-FR' : 'en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

/**
 * ⚠️ THE CLIENT SCRIPT'S STRINGS, RESOLVED HERE AND HANDED OVER AS DATA.
 *
 * The booking controls are painted in the browser and need wording; importing
 * `@i18n/ui` into a client script would bundle BOTH language tables into every
 * page and still leave the script guessing which locale it was rendered in.
 * Resolving them at build time keeps `ui.ts` the single source of strings —
 * including the `booking.code.*` keys, which mirror the codes the database
 * returns (see src/lib/booking.ts).
 */
const BOOKING_KEYS = [
  'booking.places',
  'booking.places.one',
  'booking.full',
  'booking.book',
  'booking.booking',
  'booking.booked',
  'booking.cancel',
  'booking.cancelling',
  'booking.noChildren',
  'booking.cutoff',
  'booking.cutoffPassed',
  'booking.code.ok',
  'booking.code.full',
  'booking.code.already',
  'booking.code.past',
  'booking.code.too_late',
  'booking.code.not_published',
  'booking.code.forbidden',
  'booking.code.no_session',
  'booking.code.no_booking',
  'booking.code.error',
] as const;

const bookingStrings = Object.fromEntries(BOOKING_KEYS.map((k) => [k, t(k)]));
---

<BaseLayout locale={locale} title={t('agenda.title')} description={t('agenda.intro')} reveals>
  <Trail locale={locale} href={localizePath('/club/', locale)} label={t('club.title')} />
  <PageIntro title={t('agenda.title')} intro={t('agenda.intro')} />

  {
    sessions.length === 0 ? (
      <p class="empty">{t('agenda.empty')}</p>
    ) : (
      <ul class="sessions" data-reveal-stagger>
        {sessions.map((session) => {
          const note = locale === 'fr' ? session.noteFr : session.noteEn;
          // A session's own venue wins; otherwise fall back to site config.
          // Nothing venue-related is hardcoded here.
          const venue = session.venue ?? site.venue.name;
          const cancelled = session.status === 'cancelled';
          return (
            <li
              class:list={['session', 'mcc-card', cancelled && 'session-cancelled']}
              data-reveal
              data-status={session.status}
            >
              <div class="session-when">
                <time datetime={session.date}>{dateFormat.format(asDate(session.date))}</time>
                <span class="session-time">{session.time}</span>
              </div>
              <div class="session-what">
                {/* ⚠️ THE STATE IS A WORD, NOT A COLOUR AND NOT A STRIKETHROUGH.
                    A cancelled session that reads as "faded" is a session a
                    parent squints at and turns up to. It says so, first, in
                    the reading order, and the badge carries its own ink. */}
                {cancelled && <p class="session-cancelled-tag">{t('agenda.cancelled')}</p>}
                {session.level && <LevelBadge locale={locale} level={session.level} />}
                {venue && <p class="session-venue">{venue}</p>}
                {note && <p class="session-note">{note}</p>}
                {/*
                  ⚠️ SERVER-RENDERED AND `hidden`, NEVER BUILT FROM NOTHING.
                  The container, the live region and the sign-in invitation are
                  real elements in the HTML: only the per-child buttons are
                  painted at runtime, because only the account knows its
                  children. A signed-out reader gets the invitation with no
                  script having run and no request having been made.

                  ⚠️ NOT RENDERED FOR A CANCELLED SESSION. Booking a session
                  that is not happening is not a state worth designing.
                */}
                {!cancelled && AUTH_ENABLED && (
                  <div
                    class="booking"
                    data-booking
                    data-session-id={session.id}
                    data-starts-at={session.startsAt}
                    data-capacity={session.capacity ?? ''}
                  >
                    {/* The baked hint: capacity, never a remaining count —
                        see the note on PublicSession.capacity. */}
                    {session.capacity !== null && (
                      <p class="booking-places" data-booking-places>
                        {t('booking.capacity').replace('{n}', String(session.capacity))}
                      </p>
                    )}
                    <p class="booking-prompt" data-booking-signedout>
                      {t('booking.signedOut')}{' '}
                      <a class="booking-signin" href={localizePath('/connexion/', locale)}>
                        {t('booking.signIn')}
                      </a>
                    </p>
                    <ul class="booking-children" data-booking-children hidden />
                    <p class="booking-note" data-booking-cutoff hidden>{t('booking.cutoff')}</p>
                    {/* ⚠️ NEVER THE ONLY SIGNAL — the button's label and
                        disabled state change with it (Critical Feature 39's
                        reasoning, applied to a non-audio channel). */}
                    <p class="booking-message" data-booking-message role="status" aria-live="polite" />
                  </div>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    )
  }

  {
    /* Data, not markup: read once by the booking script. `set:html` on a JSON
       string inside a non-executable script type is the standard Astro way to
       hand structured data to a client script. */
    AUTH_ENABLED && (
      <script
        is:inline
        type="application/json"
        data-booking-strings
        set:html={JSON.stringify(bookingStrings)}
      />
    )
  }
</BaseLayout>

{/*
 * ⚠️ UNCONDITIONAL, AND THAT IS DELIBERATE RATHER THAN LAZY.
 *
 * Wrapping this in `AUTH_ENABLED &&` would look like it kept the code out of
 * the accounts-OFF bundle and would NOT: Astro collects a page's `<script>`
 * blocks from the MODULE GRAPH, not from what renders — the same trap that
 * once shipped 216 KB of unreachable Supabase into a build meant to prove
 * Supabase was absent. What actually keeps the bundle clean is the alias in
 * `astro.config.mjs`, which swaps `@lib/supabase` for the stub; `booking-ui`
 * reaches it only through a dynamic import, and only after `hasStoredSession()`
 * says a token exists. With accounts off there is no token, so nothing loads.
 */}
<script>
  import { renderBooking } from '@lib/booking-ui';

  renderBooking();
</script>

<style>
  /* ⚠️⚠️ A GRID OF CARDS, NOT A STACK OF FULL-WIDTH ROWS.
     Measured at 1440px: each session was a 1264px card holding about 600px of
     content, and the date sat in a 16rem column that was empty below its two
     lines. The box model was honest — a cancelled session already rendered at
     97px against a full one's 217px, so absent optional content DID shorten
     the card — but the card itself was mostly air.

     ⚠️ THE MODEL IS `/apprendre/`'s CHOOSER GRID, deliberately: the same
     auto-fit / minmax shape, so two surfaces with the same job look the same.
     22rem is the floor because a session carries a date, a venue, a note and a
     booking control, which is more than a chooser card holds.

     ⚠️ THE READING ORDER IS UNTOUCHED. auto-fit reflows the cards; the DOM
     order inside each one — and therefore the path a parent takes to the
     booking control — is exactly as it was. */
  .sessions {
    display: grid;
    /* ⚠️ min(22rem, 100%), NOT A BARE 22rem — AND THE BARE ONE REGRESSED A
       PHONE. A minmax floor is a hard minimum: at 360px the column insisted on
       352px inside 320px of available width and the page scrolled sideways by
       12px, one release after that class of bug was fixed. `min()` lets the
       floor collapse to the container on a screen narrower than the floor. */
    grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr));
    gap: var(--mcc-card-gap);
    margin: 0;
    padding: 0;
    list-style: none;
    align-items: start;
  }

  /* ⚠️ THE COLOURED LEFT EDGE IS GONE, AND IT WAS ON EVERY SESSION.
     A 4px accent edge that every card carries marks nothing — it is the
     general treatment the containment brief rules out, and it is why the same
     edge meant nothing anywhere else on the site. Surface, border, radius and
     shadow now come from `.mcc-card`; what stays here is the grid, which is
     genuinely this card's own. */
  /* ⚠️ ONE COLUMN AT EVERY WIDTH NOW. The two-column rule split a card into a
     16rem date and the rest — reasonable on a 1264px row, absurd inside a 22rem
     card. The date reads as the card's heading instead, which is what it always
     was. */
  .session {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  /* The date is the card's title: a rule under it separates it from what it
     announces, which is what the two-column split used to do with distance. */
  .session-when {
    padding-block-end: 0.5rem;
    border-block-end: 1px solid var(--mcc-border-subtle);
  }

  /* ⚠️ ONE BRASS FIGURE PER CARD, AND THIS IS IT. The places count is the
     number a parent is actually looking for, and it had no styling at all —
     it read as another line of body copy. This is the same treatment
     `.hub-card-state` gives the chooser cards on /apprendre/, deliberately:
     the accent means "the figure that matters here", and it means nothing if
     a second thing on the same card takes it.

     ⚠️ `--mcc-accent-text` IS THE AUDITED TOKEN, not a raw brass. Brass as
     text fails on cream; this resolves to the pair check-contrast.mjs already
     proves (CLAUDE.md → the brass rule). */
  .booking-places {
    margin: 0;
    color: var(--mcc-accent-text);
    font-weight: 600;
  }

  .session-when {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    line-height: 1.35;
  }

  .session-when time {
    display: block;
    /* First letter of a French weekday is lowercase from Intl — a capital
       reads better as a heading without changing the locale data. */
    text-transform: capitalize;
  }

  .session-time {
    display: block;
    color: var(--mcc-text-secondary);
    font-family: var(--font-notation);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  /**
   * ⚠️ A CANCELLED SESSION IS MARKED BY ITS EDGE AND A WORD — never by opacity
   * and never by a strikethrough.
   *
   * `check-contrast.mjs` proves the token pair and cannot see an alpha applied
   * on top of it, so a faded card is an unaudited card (CLAUDE.md: 0.9 once
   * dropped a proved pair to 4.42:1). And a struck-through date is read as
   * decoration by half of readers and by no screen reader at all. The card
   * keeps full contrast; the edge changes colour and the state is written out.
   */
  .session-cancelled {
    border-left-color: var(--mcc-text-secondary);
    background-color: var(--mcc-surface-sunken);
  }

  .session-cancelled-tag {
    margin: 0 0 0.4rem;
    color: var(--mcc-text-primary);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .session-venue {
    margin: 0.5rem 0 0;
    font-weight: 500;
  }

  .session-note {
    margin: 0.25rem 0 0;
    color: var(--mcc-text-secondary);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .empty {
    color: var(--mcc-text-secondary);
  }
</style>
