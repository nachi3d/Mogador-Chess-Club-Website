---
import { getCollection } from 'astro:content';
import type { Locale } from '@config/site';
import { exercisePath } from '@i18n/paths';
import { useTranslations } from '@i18n/ui';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/PageIntro.astro';
import CardGrid, { type CardItem } from '@components/CardGrid.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const entries = (await getCollection('exercices', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.slug.localeCompare(b.data.slug),
);

const items: CardItem[] = entries.map(({ data }) => ({
  title: locale === 'fr' ? data.title_fr : data.title_en,
  summary: locale === 'fr' ? data.hint_fr : data.hint_en,
  level: data.level,
  themes: data.themes,
  href: exercisePath(data.slug, locale),
  meta: `${data.solution.length} ${t(
    data.solution.length === 1 ? 'exercises.moveCount.one' : 'exercises.moveCount.other',
  )}`,
  progressKeys: [data.slug],
}));
---

<BaseLayout locale={locale} title={t('exercises.title')} description={t('exercises.intro')} reveals>
  <PageIntro title={t('exercises.title')} intro={t('exercises.intro')} />
  {/* NOTE: no board is mounted here. The single Chessground island is
      client:visible and belongs on the exercise DETAIL route, never on an
      index — see the architecture rule in CLAUDE.md. */}
  <CardGrid locale={locale} items={items} emptyMessage={t('agenda.empty')} />
</BaseLayout>

{/*
  ⚠️ THE SOLVED-TICK SCRIPT MOVED INTO CardGrid (M3), because the same three
  states are now drawn on /cours and /pieges too and a second copy here would
  be the fourth definition of "what does this reader's storage say". CardGrid
  emits it only when at least one of its items tracks progress, so /pieges —
  which tracks none — still ships no script at all.
*/}
