---
import { getCollection } from 'astro:content';
import type { Locale } from '@config/site';
import { trapPath, localizePath } from '@i18n/paths';
import { useTranslations } from '@i18n/ui';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/PageIntro.astro';
import Trail from '@components/nav/Trail.astro';
import CardGrid, { type CardItem } from '@components/CardGrid.astro';
import { isListed } from '@config/fixtures';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/* ⚠️ `isListed`, NOT `isRoutable`. A fixture page exists in a fixtures build
   and must still be absent from this grid — otherwise `index-cards.spec.ts`
   draws a card for it and a reader could reach it. See src/config/fixtures.ts
   for why the two predicates are two. */
const entries = (await getCollection('traps', ({ data }) => isListed(data))).sort((a, b) =>
  a.data.slug.localeCompare(b.data.slug),
);

const items: CardItem[] = entries.map(({ data }) => ({
  title: locale === 'fr' ? data.title_fr : data.title_en,
  summary: locale === 'fr' ? data.summary_fr : data.summary_en,
  level: data.level,
  themes: data.themes,
  href: trapPath(data.slug, locale),
  // ECO is language-neutral notation — shown as-is in both locales.
  meta: data.eco,
}));
---

<BaseLayout locale={locale} title={t('traps.title')} description={t('traps.intro')} reveals>
  <Trail locale={locale} href={localizePath('/apprendre/', locale)} label={t('learn.title')} />
  <PageIntro title={t('traps.title')} intro={t('traps.intro')} />
  {/* No board here. The replayer lives on the detail route — an index never
      mounts a board (CLAUDE.md → ONE board island). */}
  <CardGrid locale={locale} items={items} emptyMessage={t('agenda.empty')} />
</BaseLayout>
