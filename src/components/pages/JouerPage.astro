---
/**
 * `/jouer/` — a game against Stockfish, in both locales.
 *
 * The page itself is static text plus the board island. Nothing here knows the
 * engine exists; see `PlayBoard.astro` and the header of `PlayView.tsx` for why
 * that matters (the 3.6 MB engine must not enter this page's module graph).
 */
import type { Locale } from '@config/site';
import { useTranslations } from '@i18n/ui';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/PageIntro.astro';
import PlayBoard from '@components/board/PlayBoard.astro';
import ScoreResolver from '@components/progress/ScoreResolver.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={t('play.title')} description={t('play.intro')} board>
  <PageIntro title={t('play.title')} intro={t('play.intro')} />
  <PlayBoard locale={locale} />

  {/* E3 — the board islands call `refreshScore()` after a solve or a win, and
      this is what publishes the function and owns the achievement toast. A page
      with a judged board and no resolver still works: `src/lib/score.ts`
      returns null and the board simply shows no award. */}
  <ScoreResolver locale={locale} />
</BaseLayout>
