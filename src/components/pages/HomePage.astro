---
/**
 * The home page — a MAIN MENU, in the spirit of a 1990s PC chess game (E5).
 *
 * Direction: `docs/direction/mcc-direction-esthetique-addendum.md` § E5.
 *
 * ── The three tensions, and how they are resolved here ───────────────────
 *
 * 1. SEO. The home page is the main entry from Google and six words do not
 *    index. The menu owns the FIRST SCREEN; everything descriptive lives BELOW
 *    it and carries the markup — the `<h1>` stays at the top where it belongs,
 *    the meta description is set explicitly rather than falling back to the
 *    site default, and the section below is real prose with a real `<h2>`.
 *
 * 2. Adults. A parent, Dar Souiri or the association has to understand what
 *    this is within five seconds. One descriptive sentence sits directly under
 *    the menu, above the fold, not below it.
 *
 * 3. Redundancy with the grouped nav. Not a defect — games have a main menu AND
 *    shortcuts — but ⚠️ **the labels must be IDENTICAL**, or it reads as two
 *    different sites. Every entry below takes its label from the SAME `nav.*`
 *    key the header uses. Do not introduce a `menu.play` string; that is the
 *    exact mistake this note exists to prevent.
 *
 * ── No JavaScript ────────────────────────────────────────────────────────
 * The menu is a plain `<ul>` of real links. Arrow-key navigation is a
 * progressive enhancement, and the roving tabindex is applied BY the script —
 * so with no JS every entry stays in the natural tab order rather than being
 * unreachable behind a `tabindex="-1"` that nothing will ever move.
 */
import type { Locale } from '@config/site';
import { site } from '@config/site';
import { localizePath } from '@i18n/paths';
import { useTranslations } from '@i18n/ui';
import { fullJourney } from '@lib/journey';
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroAmbient from '@components/motion/HeroAmbient.astro';
import Dashboard from '@components/home/Dashboard.astro';
import ResumeResolver from '@components/progress/ResumeResolver.astro';
import ScoreResolver from '@components/progress/ScoreResolver.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/**
 * The menu.
 *
 * ⚠️ `label` is a `nav.*` key on every single entry that has a nav counterpart.
 * See tension 3 above.
 *
 * The two group labels (Apprendre, S'entraîner) are nav GROUPS, which are
 * toggles rather than links — so each is pointed at the destination a reader
 * most likely wants from it: the course index and the exercise index. "Le club"
 * goes to the agenda rather than contact, because "when does it meet" is asked
 * far more often than "how do I write to it", and the agenda links contact.
 */
const entries = [
  { key: 'nav.play', href: '/jouer/', testId: 'home-cta-play' },
  { key: 'nav.group.learn', href: '/cours/', testId: 'menu-learn' },
  { key: 'nav.group.practise', href: '/exercices/', testId: 'menu-practise' },
  { key: 'nav.traps', href: '/pieges/', testId: 'menu-traps' },
  { key: 'nav.group.club', href: '/agenda/', testId: 'menu-club' },
] as const;

/* ── "Reprendre" — the detail that makes it feel like a game ─────────────
 *
 * ⚠️ THE JOURNEY AND THE RULE BOTH MOVED OUT (M3).
 *
 * The ordered table is built by `src/lib/journey.ts` — which is now the ONE
 * place the `mcc:progress:v1` key scheme is written, after three pages had
 * grown their own copy of it — and the resolution rule lives in
 * `ResumeResolver.astro`, which `/cours/`, `/exercices/` and `/progres/` also
 * use. What is left in this file is only the binding for the two surfaces
 * that are genuinely bespoke to the home page: the E5 menu entry (declarative,
 * see below) and the mobile dashboard (imperative, the script at the bottom).
 *
 * Nothing about WHICH step is chosen changed. See the resolver's frontmatter
 * for the rule, and `tests/e2e/resume.spec.ts` for the properties that had to
 * survive the move — it was written first, run green against the old code, and
 * run green against this.
 */
const journey = await fullJourney(locale);
---

<BaseLayout
  locale={locale}
  title={t('home.title')}
  description={t('home.about.lede')}
  reveals
>
  {/* ⚠️ THE DASHBOARD COMES FIRST IN THE DOM, AND THAT IS DELIBERATE (M2).

      Below 768px the menu screen hides everything of its own except the
      tagline, so the reading order on a phone is: dashboard, then that same
      sentence, then the about section. ONE tagline element, shared — the
      alternative was a second copy of it in this file, and a sentence that
      exists twice is a sentence that will disagree with itself.

      Above 768px this is `display: none` and the menu below is EXACTLY as E5
      left it. That is a regression guard, not a preference. */}
  <Dashboard locale={locale} />

  <section class="menu-screen">
    <HeroAmbient />

    <div class="menu-content">
      <p class="eyebrow">{site.venue.city}, {site.venue.country}</p>
      <h1>{site.name}</h1>

      <nav class="main-menu" aria-label={t('menu.label')} data-main-menu>
        <ul class="menu-list">
          {/* Hidden until the script proves there is something to resume. With
              no JavaScript it stays hidden, and that is correct: "Reprendre"
              with nothing to reprendre would be a lie, and progress is only
              knowable in the browser. Five real links is the no-JS shape. */}
          {/* `data-resume-for="home"` is the resolver's declarative contract:
              it sets the href, the aria-label from the pattern beside it, and
              removes `hidden` — exactly what the old bespoke code did here.
              `data-menu-resume` stays as the specs' handle. */}
          <li
            class="menu-entry"
            data-menu-resume
            data-resume-for="home"
            data-resume-aria={t('menu.resume.aria')}
            hidden
          >
            <a class="menu-link" href={localizePath('/apprendre-les-bases/', locale)} data-testid="menu-resume">
              <span class="menu-cursor" aria-hidden="true">
                <svg viewBox="0 0 44 64" fill="currentColor" width="16" height="23">
                  <path
                    d="M15 5c8-2 16 2 20 10 3 7 3 16 0 23-2 5-6 9-11 12h9v6H9v-6c0-7 4-13 10-17l-9-3-3-10 8-5z"
                  ></path>
                </svg>
              </span>
              <span class="menu-text">{t('menu.resume')}</span>
            </a>
          </li>

          {
            entries.map((entry) => (
              <li class="menu-entry">
                <a
                  class="menu-link"
                  href={localizePath(entry.href, locale)}
                  data-testid={entry.testId}
                >
                  <span class="menu-cursor" aria-hidden="true">
                    <svg viewBox="0 0 44 64" fill="currentColor" width="16" height="23">
                      <path d="M15 5c8-2 16 2 20 10 3 7 3 16 0 23-2 5-6 9-11 12h9v6H9v-6c0-7 4-13 10-17l-9-3-3-10 8-5z" />
                    </svg>
                  </span>
                  <span class="menu-text">{t(entry.key)}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Tension 2: the one sentence an adult reads before deciding whether
          this site is for their child. Above the fold, under the menu. */}
      <p class="menu-tagline">{t('home.intro')}</p>

      <p class="menu-more">
        <a href="#a-propos">{t('menu.more')}</a>
      </p>
    </div>
  </section>

  {/* ── Below the fold: the markup Google reads and the adult scrolls to ── */}
  <section class="about" id="a-propos" aria-labelledby="about-title" data-reveal>
    <h2 id="about-title">{t('home.about.title')}</h2>
    <p class="about-lede">{t('home.about.lede')}</p>
    <p class="about-actions">
      <a
        class="btn btn-primary"
        href={localizePath('/apprendre-les-bases/', locale)}
        data-testid="home-cta-tutorial"
      >
        {t('home.about.cta')}
      </a>
    </p>
  </section>

  <section class="pillars" aria-labelledby="pillars-title" data-reveal>
    <h2 id="pillars-title">{t('home.pillars.title')}</h2>
    <ul class="pillar-grid" data-reveal-stagger>
      {
        [
          { href: '/cours/', title: t('home.pillar.learn.title'), text: t('home.pillar.learn.text') },
          {
            href: '/exercices/',
            title: t('home.pillar.practise.title'),
            text: t('home.pillar.practise.text'),
          },
          { href: '/jouer/', title: t('home.pillar.play.title'), text: t('home.pillar.play.text') },
        ].map((pillar) => (
          <li class="pillar">
            {/* One link per card, wrapping the heading — the card is made
                clickable by CSS below rather than by a second overlapping
                anchor. That keeps a single entry in the a11y tree, the same
                pattern CardGrid uses. */}
            <h3>
              <a href={localizePath(pillar.href, locale)}>{pillar.title}</a>
            </h3>
            <p>{pillar.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {/* ⚠️ THE RESOLVER GOES LAST INSIDE THE LAYOUT, AND THE DASHBOARD BINDER
      BELOW COMES AFTER IT. Both are inline and synchronous, so document order
      is the whole of the ordering guarantee — there is no race to lose, but
      there is an order to keep. Moving either one above the markup it touches
      would leave it binding elements that do not exist yet. */}
  <ResumeResolver journeys={{ home: journey }} />

  {/* E3. Independent of the resume resolver — it reads the same store but
      answers a different question, and neither needs the other's output. Both
      are inline and synchronous, so the dashboard's rank and its "Reprendre"
      card land in the same first paint. */}
  <ScoreResolver locale={locale} />
</BaseLayout>

{/*
  THE DASHBOARD BINDER — the one surface too bespoke for the declarative
  contract (M3).

  ⚠️ THE RULE IS NOT HERE ANY MORE. It is in
  `src/components/progress/ResumeResolver.astro`, which runs immediately
  above this in document order and publishes its answer at
  `window.MCC_RESUME.home`. This script only MOVES THINGS AROUND. If you are
  looking for how the step is chosen, read the resolver's frontmatter.

  ⚠️ STILL `is:inline`, for the same reason the resolver is: it runs
  synchronously during parsing, so the swap is in the first paint and nothing
  jumps. A bundled module is deferred and would cost a visible reflow on the
  site's most-visited page. `tests/e2e/resume.spec.ts` measures the CLS.

  It touches no storage at all now — that is the resolver's job — so there is
  one fewer copy of `mcc:progress:v1` on this page than there was.

  WHAT IT DOES. The server rendered the "nothing yet" branch — "Jouer une
  partie" — because that is what is true for a first-time visitor and it works
  with no JavaScript. Given a step to resume, swap it in place:

    title  ← the step's own name
    card   → that step
    beside → "Jouer", since Play is no longer the primary thing to do

  Nothing is created, so nothing moves: the progress bar's height was reserved
  by CSS from the first paint (see Dashboard.astro).
*/}
<script is:inline>
  (function () {
    try {
      var resolved = window.MCC_RESUME && window.MCC_RESUME.home;
      var step = resolved && resolved.step;
      if (!step) return;

      var dash = document.querySelector('[data-dashboard]');
      if (!dash) return;

      function fill(selector, text) {
        var el = dash.querySelector(selector);
        if (el) el.textContent = text;
      }

      var primary = dash.querySelector('[data-dash-primary]');
      if (primary) primary.setAttribute('href', step.u);

      var eyebrow = dash.querySelector('[data-dash-primary-eyebrow]');
      if (eyebrow) {
        eyebrow.textContent = dash.getAttribute('data-label-resume') || '';
        eyebrow.removeAttribute('hidden');
      }
      fill('[data-dash-primary-title]', step.t);
      /* The explanatory line is redundant once the card names a specific
         lesson — the bar underneath says everything else worth saying. */
      var text = dash.querySelector('[data-dash-primary-text]');
      if (text) text.remove();

      var bar = dash.querySelector('[data-dash-progress]');
      if (bar && resolved.total) {
        var pattern = dash.getAttribute('data-label-progress') || '%s / %s';
        fill(
          '[data-dash-progress-label]',
          pattern.replace('%s', String(resolved.done)).replace('%s', String(resolved.total)),
        );
        var f = dash.querySelector('[data-dash-progress-fill]');
        if (f) f.style.inlineSize = Math.round((resolved.done / resolved.total) * 100) + '%';
        bar.removeAttribute('hidden');
      }

      /* The secondary tile becomes Play — the action a returning student
         wants second, once resuming is the first. */
      var secondary = dash.querySelector('[data-dash-secondary]');
      if (secondary) {
        secondary.setAttribute('href', dash.getAttribute('data-href-play') || '/jouer/');
        fill('[data-dash-secondary-title]', dash.getAttribute('data-label-play-title') || '');
        fill('[data-dash-secondary-text]', dash.getAttribute('data-label-play-text') || '');
      }

      /* Both real. "Solved" counts the whole store; "lessons" is how far along
         this journey the reader is. */
      fill('[data-dash-solved]', String(resolved.solved));
      fill('[data-dash-lessons]', String(resolved.done));
      dash.setAttribute('data-resolved', 'true');
    } catch (e) {
      /* The dashboard keeps its server-rendered branch. Same silent-failure
         contract as src/lib/progress.ts. */
    }
  })();
</script>

<script is:inline>
  /**
   * Roving tabindex over the menu — the retro half, and a standard pattern.
   *
   * ⚠️ EVERY tabindex here is set BY THIS SCRIPT. The server renders plain
   * links, so a reader with no JavaScript gets the ordinary tab order rather
   * than five links marked `tabindex="-1"` that nothing will ever move focus
   * to. Progressive enhancement means the enhanced state is the one that is
   * added, never the one that is removed.
   */
  (function () {
    try {
      var menu = document.querySelector('[data-main-menu]');
      if (!menu) return;

      function items() {
        return [].slice
          .call(menu.querySelectorAll('.menu-entry'))
          .filter(function (li) {
            return !li.hasAttribute('hidden');
          })
          .map(function (li) {
            return li.querySelector('a');
          })
          .filter(Boolean);
      }

      var links = items();
      if (!links.length) return;

      function select(index, focus) {
        links = items();
        if (!links.length) return;
        var next = (index + links.length) % links.length;
        for (var i = 0; i < links.length; i++) {
          var isCurrent = i === next;
          links[i].tabIndex = isCurrent ? 0 : -1;
          links[i].parentNode.setAttribute('data-selected', isCurrent ? 'true' : 'false');
        }
        if (focus) links[next].focus();
      }

      /* The first entry is the selected one on arrival — which is "Reprendre"
         when it exists, and that is the whole point of putting it first. */
      select(0, false);

      menu.addEventListener('keydown', function (e) {
        var key = e.key;
        if (key !== 'ArrowDown' && key !== 'ArrowUp' && key !== 'Home' && key !== 'End') return;

        links = items();
        var current = links.indexOf(document.activeElement);
        if (current < 0) current = 0;

        e.preventDefault();
        if (key === 'ArrowDown') select(current + 1, true);
        else if (key === 'ArrowUp') select(current - 1, true);
        else if (key === 'Home') select(0, true);
        else select(links.length - 1, true);
      });

      /* Focus and pointer keep the cursor honest: whatever the reader is on IS
         the selected line, however they got there. Enter needs no handler — a
         focused link already activates on Enter, and reimplementing that would
         only break middle-click and modifier-click. */
      menu.addEventListener('focusin', function (e) {
        var link = e.target && e.target.closest ? e.target.closest('.menu-link') : null;
        if (!link) return;
        links = items();
        var index = links.indexOf(link);
        if (index >= 0) select(index, false);
      });
    } catch (e) {
      /* A menu that cannot be arrow-driven is still a list of working links. */
    }
  })();
</script>

<style>
  /* ══ The menu screen ══════════════════════════════════════════════════
     ⚠️ ONE SCREEN, NO SCROLLING TO REACH AN ENTRY — including on a phone.
     `svh` rather than `vh`: on mobile Safari `vh` is the LARGEST viewport, so
     100vh is taller than what is actually visible while the address bar is
     showing, and the last entry would sit under it. The subtraction is the
     header, which is outside this section but inside the same screen. */
  .menu-screen {
    position: relative;
    display: grid;
    align-content: center;
    justify-items: center;
    min-block-size: calc(100svh - 9rem);
    padding-block: 1.5rem;
    text-align: center;
  }

  .menu-content {
    position: relative;
    /* Above .ambient, which sits at z-index 0. */
    z-index: 1;
    inline-size: 100%;
    max-inline-size: 34rem;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    /* brass-700, not the nominal accent — brass fails AA as text on cream.
       See the brass contrast rule in tokens.css. */
    color: var(--mcc-accent-text);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .menu-screen h1 {
    margin: 0 0 clamp(1.25rem, 4vh, 2.5rem);
    font-size: clamp(2rem, 8vw, 3.5rem);
    line-height: 1.05;
  }

  /* ── The entries ──────────────────────────────────────────────────── */

  .menu-list {
    display: grid;
    /* Tight enough that six entries plus a title plus a sentence clear a short
       phone, loose enough that each row is a comfortable target. */
    gap: clamp(0.1rem, 0.6vh, 0.4rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu-link {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.65rem;
    /* ≥44px touch target, and the padding is what provides it — the text alone
       is nowhere near. */
    min-block-size: 2.75rem;
    /* The cursor sits in reserved space to the LEFT of the label, so revealing
       it cannot shift the text sideways. That is why the row is left-aligned
       inside a centred, width-limited list rather than centred itself: a
       centred row would recentre every time the cursor appeared. */
    padding: 0.35rem 1rem;
    inline-size: fit-content;
    margin-inline: auto;
    color: var(--mcc-text-heading);
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 4.5vw, 1.5rem);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-card);
    transition: color var(--motion-response) var(--ease-response);
  }

  .menu-cursor {
    /* Reserved whether or not it is showing — see the note above. */
    flex: 0 0 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--mcc-accent-text);
    opacity: 0;
    /* Réponse (E1). The cursor answers an arrow key; nothing else here moves. */
    transition:
      opacity var(--motion-response) var(--ease-response),
      transform var(--motion-response) var(--ease-response);
    transform: translateX(-0.35rem);
  }

  .menu-cursor svg {
    display: block;
    inline-size: 0.8em;
    block-size: auto;
  }

  /* Selected (arrow keys), focused (Tab), or hovered — one cursor, three ways
     of being the active line. Hover and focus work with NO JavaScript, which is
     what keeps the menu legible when the roving script never runs. */
  .menu-entry[data-selected='true'] .menu-cursor,
  .menu-link:hover .menu-cursor,
  .menu-link:focus-visible .menu-cursor {
    opacity: 1;
    transform: translateX(0);
  }

  .menu-entry[data-selected='true'] .menu-link,
  .menu-link:hover,
  .menu-link:focus-visible {
    color: var(--mcc-link);
  }

  /* ⚠️ Reduced motion: the cursor still MOVES between lines — it is how the
     reader knows where they are — it simply arrives without travel. Removing
     it outright would take away the one piece of state the menu has. */
  @media (prefers-reduced-motion: reduce) {
    .menu-cursor {
      transition: none;
      transform: none;
    }

    .menu-entry[data-selected='true'] .menu-cursor,
    .menu-link:hover .menu-cursor,
    .menu-link:focus-visible .menu-cursor {
      transform: none;
    }
  }

  /* ── Under the menu ───────────────────────────────────────────────── */

  .menu-tagline {
    margin: clamp(1.25rem, 4vh, 2.25rem) auto 0;
    max-inline-size: 32rem;
    color: var(--mcc-text-secondary);
    font-size: clamp(0.9375rem, 3.4vw, 1.0625rem);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .menu-more {
    margin: 1rem 0 0;
    font-size: 0.875rem;
  }

  .menu-more a {
    color: var(--mcc-accent-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* ══ BELOW 768px: THE MENU IS SUPERSEDED (M1/M2) ══════════════════════
     Direction: mcc-direction-mobile-app.md. The retro menu was designed for a
     large screen; at 390px it is a list of links on a dark background, sitting
     under a header that already repeats every one of them.

     ⚠️ THE SECTION IS NOT HIDDEN — ITS CONTENTS ARE, EXCEPT THE TAGLINE.
     That one sentence is shared with the dashboard, which renders above this
     in the DOM, so the phone reading order is: dominant card, tiles, stats,
     next session, THEN the sentence an adult reads. Hiding the whole section
     would have meant a second copy of that sentence in this file, and a
     sentence that exists twice is one that will disagree with itself.

     ⚠️ THE `<h1>` GOES SR-ONLY, NOT `display: none`. The club name is already
     visible in the reduced header on this breakpoint, so showing it again
     would be the redundancy M1 exists to remove — but `display: none` would
     take the page's only `<h1>` out of the accessibility tree and leave the
     document with no top-level heading at all.

     Everything above 768px is untouched. */
  @media (max-width: 767.98px) {
    .menu-screen {
      display: block;
      min-block-size: 0;
      padding-block: 0;
      text-align: start;
    }

    .menu-content {
      max-inline-size: none;
    }

    .menu-screen :global(.ambient),
    .eyebrow,
    .main-menu,
    .menu-more {
      display: none;
    }

    .menu-screen h1 {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }

    .menu-tagline {
      margin: 1rem 0 0;
      max-inline-size: none;
      font-size: 0.9375rem;
    }
  }

  /* ── Below the fold ───────────────────────────────────────────────── */

  .about {
    margin-block-start: var(--mcc-section-gap, 4rem);
    scroll-margin-block-start: 2rem;
    max-inline-size: 46rem;
  }

  .about h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.5rem, 4vw, 2rem);
  }

  .about-lede {
    margin: 0 0 1.5rem;
    color: var(--mcc-text-secondary);
    font-size: 1.0625rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .about-actions {
    margin: 0;
  }

  .btn {
    padding: 0.7rem 1.4rem;
  }

  .btn-primary {
    background-color: var(--mcc-primary);
    color: var(--mcc-primary-contrast);
    border: 1px solid var(--mcc-primary);
  }

  .btn-primary:hover {
    background-color: var(--mcc-primary-hover);
  }

  /* ── The three pillars ──────────────────────────────────────────────── */

  .pillars {
    margin-block-start: var(--mcc-section-gap, 4rem);
  }

  .pillars h2 {
    margin: 0 0 1.5rem;
    font-size: 1.5rem;
  }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pillar {
    position: relative;
    padding: 1.25rem;
    border: 1px solid var(--mcc-border-subtle);
    border-radius: var(--radius-card);
    background-color: var(--mcc-surface-raised);
    transition:
      border-color var(--motion-response) var(--ease-response),
