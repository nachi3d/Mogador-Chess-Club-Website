---
/**
 * /admin/comptes — who has signed up, and how to remove a junk one.
 *
 * ═════════════════════════════════════════════════════════════════════════
 * ⚠️ FRENCH ONLY. See `AdminShell.astro` and CLAUDE.md — the missing English is
 * the decision, not an omission.
 *
 * ⚠️ ADMIN ONLY, AND THAT IS A NARROWER GATE THAN THE REST OF `/admin*`. A prof
 * marks a register and reads the class; seeing every family's email address and
 * erasing an account is not the same class of act. `requires="admin"` decides
 * what to DRAW; `is_admin_direct()` inside `admin_list_accounts()` and
 * `admin_delete_account()` is what actually refuses, and
 * `role-separation.spec.ts` proves it with a prof's own token rather than by
 * driving this page.
 *
 * ⚠️ THIS IS THE ANSWER TO JUNK SIGN-UPS, AND THE FORM-SIDE HONEYPOT IS NOT.
 * Anyone can create an account on a public static site — the anon key is
 * published by design, so the sign-up endpoint is reachable without ever
 * loading `/connexion/`. Client-side friction is noise reduction. What actually
 * scales for a club of twenty families is being able to SEE the list and delete
 * a row, which is this page.
 *
 * ⚠️ WHAT A JUNK SIGN-UP LOOKS LIKE, AND WHY THE COLUMNS ARE THESE ONES. An
 * address that was typed into the form but never confirmed leaves a row with no
 * `confirmed_at`, no children beyond the auto-created one and nothing solved.
 * The table therefore leads with confirmation state and activity rather than
 * with names: those three facts together are the judgement, and a prof-facing
 * "last seen" column would not be.
 *
 * ⚠️ NOTHING HERE IS A LEADERBOARD. `solved` is present so an admin can tell a
 * real family from a bounced address before erasing one, and for no other
 * reason. It is not ordered by it and never should be — same rule as the
 * dashboard's "activité récente".
 * ═════════════════════════════════════════════════════════════════════════
 */
import AdminShell from '@components/admin/AdminShell.astro';
---

<AdminShell
  title="Comptes"
  current="comptes"
  requires="admin"
  intro="Les inscriptions, les plus récentes en premier."
>
  <ul class="admin-tiles">
    <li class="admin-tile"><b data-tile="total">–</b><span>comptes</span></li>
    <li class="admin-tile"><b data-tile="unconfirmed">–</b><span>jamais confirmés</span></li>
    <li class="admin-tile"><b data-tile="week">–</b><span>cette semaine</span></li>
  </ul>

  <section class="admin-block mcc-card">
    <h2 class="admin-block-title">Inscriptions</h2>
    <div data-accounts>
      <p class="admin-empty">Chargement…</p>
    </div>
  </section>

  <section class="admin-block mcc-card">
    <h2 class="admin-block-title">Réinitialisations</h2>
    {/* ⚠️ CE JOURNAL NOMME L'ÉLÈVE, ET CELUI DES SUPPRESSIONS NON. Ce n'est pas
        une incohérence : la Critical Feature 51 interdit de conserver quoi que
        ce soit d'un compte EFFACÉ. Une réinitialisation n'efface rien, et
        « à qui a-t-on remis un mot de passe trois fois ce trimestre ? » est
        précisément la question à laquelle ce journal sert à répondre. Les
        lignes disparaissent avec le compte (cascade). */}
    <p class="admin-note">
      Qui a réinitialisé, quand, et pour qui. Jamais le mot de passe : il n’existe qu’une
      fois, à l’écran.
    </p>
    <div data-resets>
      <p class="admin-empty">Chargement…</p>
    </div>
  </section>

  <section class="admin-block mcc-card">
    <h2 class="admin-block-title">Suppressions</h2>
    {/* ⚠️ THE JOURNAL NAMES NOBODY, AND THAT IS DELIBERATE. Critical Feature 51
        says erasure leaves no statistic, no archive and no anonymised copy —
        written for the self-service button, and it binds a volunteer pressing
        this one exactly as hard. So the audit records the ACT (who, when, why)
        and holds no reference at all to the account that was removed. It is
        enough to notice twenty deletions nobody authorised; it is not enough to
        reconstruct anything, and nothing on this site is. */}
    <p class="admin-note">
      Le journal enregistre l’acte, jamais la personne : aucun identifiant, aucune adresse,
      aucun compteur du compte supprimé.
    </p>
    <div data-deletions>
      <p class="admin-empty">Chargement…</p>
    </div>
  </section>
</AdminShell>

<script>
  import {
    deleteAccount,
    listAccounts,
    listDeletions,
    listPasswordResets,
    resetPassword,
    validateDeletion,
  } from '@lib/admin';
  import type { AdminAccount } from '@lib/admin';

  const set = (name: string, value: string | number) => {
    const el = document.querySelector(`[data-tile="${name}"]`);
    if (el) el.textContent = String(value);
  };

  const dateFmt = new Intl.DateTimeFormat('fr-FR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });

  /** Escape everything reaching innerHTML — every value below is user text. */
  function esc(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  const when = (iso: string | null) => (iso ? dateFmt.format(new Date(iso)) : '—');

  function row(account: AdminAccount): string {
    /* ⚠️ THE STATE IS A WORD, NOT A COLOUR. Same rule the public agenda follows
       for a cancelled session: an admin scanning a list on a phone in a bright
       room must not have to distinguish two greys. */
    const confirmed = account.confirmedAt
      ? '<span class="account-state" data-state="confirmed">confirmé</span>'
      : '<span class="account-state" data-state="pending">jamais confirmé</span>';
    /* ⚠️ UN COMPTE À PSEUDO EST DÉSIGNÉ PAR SON PSEUDO — c'est le nom que Seàn
       prononcera au téléphone, et l'adresse synthétique n'arrive même pas
       jusqu'ici : `admin_list_accounts()` la remplace par NULL à la source. */
    const who = account.pseudo
      ? `<span class="account-email">${esc(account.pseudo)}</span>
         <span class="account-state" data-state="pseudo">pseudo</span>`
      : `<span class="account-email">${esc(account.email || '—')}</span>${confirmed}`;
    const temporary = account.mustChangePassword
      ? '<span class="account-state" data-state="pending">mot de passe provisoire</span>'
      : '';
    return `
      <li class="account-row" data-account-id="${esc(account.accountId)}">
        <div class="account-main">
          ${who}
          ${temporary}
        </div>
        <p class="account-meta">
          inscrit le ${esc(when(account.createdAt))}
          · ${account.children} élève${account.children > 1 ? 's' : ''}
          · ${account.solved} exercice${account.solved > 1 ? 's' : ''} résolu${account.solved > 1 ? 's' : ''}
          ${account.role && account.role !== 'eleve' ? `· <b>${esc(account.role)}</b>` : ''}
        </p>
        <div class="account-actions" data-actions></div>
      </li>`;
  }

  function paint(selector: string, html: string) {
    const el = document.querySelector(selector);
    if (el) el.innerHTML = html;
  }

  let accounts: AdminAccount[] = [];

  /**
   * ⚠️ TWO STEPS, IN PLACE, AND THE SECOND ONE REQUIRES TYPING A REASON.
   *
   * The reason is not paperwork: it is the whole content of the audit row, and
   * the database refuses a blank one (`length(btrim(reason)) >= 3`). Making it
   * the thing that unlocks the button means an admin cannot delete by reflex,
   * which matters more here than on `/compte/` — there, a reader erases their
   * own account; here, somebody erases a family's.
   *
   * ⚠️ NO MODAL. Same reasoning as the family roster: a dialog over a list on a
   * phone hides the row being acted on, which is the one thing that must stay
   * visible while confirming.
   */
  function startDelete(li: HTMLElement, account: AdminAccount) {
    const actions = li.querySelector('[data-actions]') as HTMLElement | null;
    if (!actions) return;

    const wrap = document.createElement('div');
    wrap.className = 'account-confirm';

    const question = document.createElement('p');
    question.className = 'account-confirm-q';
    question.textContent =
      `Supprimer ${account.email} ? Le compte, ses ${account.children} élève(s), ` +
      'leur progression, leurs points et leurs présences seront effacés. Irréversible.';

    const label = document.createElement('label');
    label.className = 'account-confirm-label';
    label.textContent = 'Raison (journalisée)';
    const field = document.createElement('input');
    field.type = 'text';
    field.maxLength = 120;
    field.autocomplete = 'off';
    field.className = 'account-reason';
    field.dataset['testid'] = 'account-reason';
    const fieldId = `reason-${account.accountId}`;
    field.id = fieldId;
    label.htmlFor = fieldId;

    const go = document.createElement('button');
    go.type = 'button';
    go.className = 'btn-ghost account-danger';
    go.textContent = 'Supprimer définitivement';
    go.dataset['testid'] = 'account-delete-go';
    go.disabled = true;

    const cancel = document.createElement('button');
    cancel.type = 'button';
    cancel.className = 'btn-ghost';
    cancel.textContent = 'Annuler';

    const status = document.createElement('p');
    status.className = 'account-status';
    status.setAttribute('role', 'status');

    field.addEventListener('input', () => {
      go.disabled = validateDeletion(field.value) !== null;
    });

    cancel.addEventListener('click', () => void render());

    go.addEventListener('click', async () => {
      if (go.disabled) return;
      /* Locked while it runs: a double tap on mobile data would fire a second
         RPC whose only possible answer is "no such user" — an error message for
         an operation that in fact succeeded. */
      go.disabled = true;
      cancel.disabled = true;
      status.textContent = 'Suppression en cours…';
      const result = await deleteAccount(account.accountId, field.value);
      if (!result.ok) {
        status.textContent = result.error ?? 'La suppression a échoué.';
        go.disabled = false;
        cancel.disabled = false;
        return;
      }
      await render();
    });

    const buttons = document.createElement('p');
    buttons.className = 'account-confirm-actions';
    buttons.append(go, cancel);

    wrap.append(question, label, field, buttons, status);
    actions.replaceChildren(wrap);
    field.focus();
  }

  /**
   * ⚠️ LE MOT DE PASSE S'AFFICHE UNE SEULE FOIS, ET LA PAGE LE DIT.
   *
   * Rien ne le stocke : `auth.users` n'a que l'empreinte bcrypt et le journal
   * n'a que qui/quand/pour qui. Un rechargement ne le ramène pas — et c'est le
   * comportement honnête : re-réinitialiser coûte un clic, tandis qu'un mot de
   * passe consultable plus tard serait un identifiant en clair dans une table.
   *
   * ⚠️ LE LIEN WHATSAPP EST SORTANT, comme tous les partages du site :
   * `wa.me/<numéro>?text=…` prépare un message sur l'appareil de Seàn. Rien
   * n'est envoyé par le site, rien n'est stocké, rien n'est reçu.
   */
  function showTemporary(li: HTMLElement, account: AdminAccount, password: string) {
    const actions = li.querySelector('[data-actions]') as HTMLElement | null;
    if (!actions) return;

    const wrap = document.createElement('div');
    wrap.className = 'account-confirm';

    const heading = document.createElement('p');
    heading.className = 'account-confirm-q';
    heading.textContent =
      'Mot de passe provisoire — il ne sera plus affiché. L’élève devra en choisir un ' +
      'nouveau à la prochaine connexion.';

    /* Un <code> plutôt qu'un champ : rien à soumettre, rien à modifier par
       accident, et la police à chasse fixe évite de confondre l comme dans
       « clou » et 1 au téléphone. */
    const value = document.createElement('code');
    value.className = 'account-temp-password';
    value.dataset['testid'] = 'account-temp-password';
    value.textContent = password;

    const buttons = document.createElement('p');
    buttons.className = 'account-confirm-actions';

    if (account.whatsapp) {
      const digits = account.whatsapp.replace(/[^0-9]/g, '');
      const message =
        `Bonjour, voici le mot de passe provisoire pour le site du club : ${password} — ` +
        `pseudo : ${account.pseudo ?? ''}. Tu en choisiras un nouveau à la connexion.`;
      const send = document.createElement('a');
      send.className = 'btn-ghost';
      send.href = `https://wa.me/${digits}?text=${encodeURIComponent(message)}`;
      send.target = '_blank';
      send.rel = 'noopener';
      send.textContent = `Envoyer sur WhatsApp (${account.whatsapp})`;
      send.dataset['testid'] = 'account-reset-whatsapp';
      buttons.append(send);
    } else {
      /* Ne peut pas arriver pour un compte créé par le formulaire — le numéro
         y est obligatoire — mais un compte migré à la main pourrait en manquer,
         et un bouton absent sans explication ressemblerait à une panne. */
      const none = document.createElement('span');
      none.className = 'admin-note';
      none.textContent = 'Aucun numéro WhatsApp enregistré : à lire de vive voix.';
      buttons.append(none);
    }

    const done = document.createElement('button');
    done.type = 'button';
    done.className = 'btn-ghost';
    done.textContent = 'Terminé';
    done.dataset['testid'] = 'account-reset-done';
    done.addEventListener('click', () => void render());
    buttons.append(done);

    wrap.append(heading, value, buttons);
    actions.replaceChildren(wrap);
  }

  /**
   * ⚠️ DEUX ÉTAPES, SUR PLACE, SANS MODALE — comme la suppression juste en
   * dessous. La première frappe ne fait rien d'irréversible mais invalide les
   * sessions en cours et l'ancien mot de passe : c'est assez pour mériter une
   * confirmation, et pas assez pour mériter une raison écrite.
   */
  function startReset(li: HTMLElement, account: AdminAccount) {
    const actions = li.querySelector('[data-actions]') as HTMLElement | null;
    if (!actions) return;

    const wrap = document.createElement('div');
    wrap.className = 'account-confirm';

    const question = document.createElement('p');
    question.className = 'account-confirm-q';
    question.textContent =
      `Réinitialiser le mot de passe de ${account.pseudo ?? ''} ? L’ancien mot de passe ` +
      'cessera de fonctionner immédiatement et les appareils connectés seront déconnectés.';

    const go = document.createElement('button');
    go.type = 'button';
    go.className = 'btn-ghost';
    go.textContent = 'Générer un mot de passe provisoire';
    go.dataset['testid'] = 'account-reset-go';

    const cancel = document.createElement('button');
    cancel.type = 'button';
    cancel.className = 'btn-ghost';
    cancel.textContent = 'Annuler';
    cancel.addEventListener('click', () => void render());

    const status = document.createElement('p');
    status.className = 'account-status';
    status.setAttribute('role', 'status');

    go.addEventListener('click', async () => {
      /* Verrouillé pendant l'appel : un double appui générerait un second mot
         de passe et invaliderait le premier, que Seàn vient peut-être de lire
         à voix haute. */
      go.disabled = true;
      cancel.disabled = true;
      status.textContent = 'Génération…';
      const result = await resetPassword(account.accountId);
      if (!result.ok) {
        status.textContent = result.error ?? 'La réinitialisation a échoué.';
        go.disabled = false;
        cancel.disabled = false;
        return;
      }
      showTemporary(li, account, result.password);
    });

    const buttons = document.createElement('p');
    buttons.className = 'account-confirm-actions';
    buttons.append(go, cancel);

    wrap.append(question, buttons, status);
    actions.replaceChildren(wrap);
    go.focus();
  }

  function attachActions() {
    for (const li of document.querySelectorAll('[data-account-id]')) {
      const el = li as HTMLElement;
      const account = accounts.find((a) => a.accountId === el.dataset['accountId']);
      if (!account) continue;
      const actions = el.querySelector('[data-actions]') as HTMLElement | null;
      if (!actions) continue;
      /* ⚠️ LE NOM ACCESSIBLE NE PEUT PAS ÊTRE L'ADRESSE POUR UN COMPTE À
         PSEUDO : elle est nulle. Le pseudo est le nom que cet écran affiche et
         que Seàn prononce, donc c'est celui-là. */
      const label = account.pseudo || account.email || 'ce compte';

      const buttons: HTMLElement[] = [];

      /* ⚠️ UNIQUEMENT POUR LES COMPTES À MOT DE PASSE. Un compte par lien
         e-mail n'a pas de mot de passe à réinitialiser — `admin_reset_password`
         refuse d'ailleurs, et un bouton qui échoue toujours est pire qu'absent. */
      if (account.pseudo) {
        const reset = document.createElement('button');
        reset.type = 'button';
        reset.className = 'btn-ghost';
        reset.textContent = 'Réinitialiser le mot de passe';
        reset.dataset['testid'] = 'account-reset-start';
        reset.setAttribute('aria-label', `Réinitialiser le mot de passe de ${label}`);
        reset.addEventListener('click', () => startReset(el, account));
        buttons.push(reset);
      }

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn-ghost';
      btn.textContent = 'Supprimer ce compte';
      btn.dataset['testid'] = 'account-delete-start';
      /* Repeated per row, so the visible label alone is not a distinguishing
         accessible name — the same rule the family roster follows. */
      btn.setAttribute('aria-label', `Supprimer le compte ${label}`);
      btn.addEventListener('click', () => startDelete(el, account));
      buttons.push(btn);

      actions.replaceChildren(...buttons);
    }
  }

  async function render() {
    const [rows, deletions, resets] = await Promise.all([
      listAccounts(),
      listDeletions(),
      listPasswordResets(),
    ]);
    accounts = rows;

    const weekAgo = Date.now() - 7 * 86_400_000;
    set('total', rows.length);
    set('unconfirmed', rows.filter((a) => !a.confirmedAt).length);
    set('week', rows.filter((a) => Date.parse(a.createdAt) >= weekAgo).length);

    paint(
      '[data-accounts]',
      rows.length === 0
        ? '<p class="admin-empty">Aucun compte pour le moment.</p>'
        : `<ul class="account-list" data-testid="account-list">${rows.map(row).join('')}</ul>`,
    );
    attachActions();

    paint(
      '[data-resets]',
      resets.length === 0
        ? '<p class="admin-empty">Aucune réinitialisation enregistrée.</p>'
        : `<ul class="mark-list" data-testid="reset-list">${resets
            .map(
              (r) => `
              <li class="mark-row">
                <span class="mark-name">${esc(r.pseudo ?? r.displayName ?? '—')}</span>
                <span class="admin-rank">${esc(when(r.resetAt))}${
                  r.resetByName ? ` · par ${esc(r.resetByName)}` : ''
                }</span>
              </li>`,
            )
            .join('')}</ul>`,
    );

    paint(
      '[data-deletions]',
      deletions.length === 0
        ? '<p class="admin-empty">Aucune suppression enregistrée.</p>'
        : `<ul class="mark-list">${deletions
            .map(
              (d) => `
              <li class="mark-row">
                <span class="mark-name">${esc(d.reason)}</span>
                <span class="admin-rank">${esc(when(d.deletedAt))}</span>
              </li>`,
            )
            .join('')}</ul>`,
    );
  }

  window.addEventListener('mcc:admin-ready', () => void render());
</script>
