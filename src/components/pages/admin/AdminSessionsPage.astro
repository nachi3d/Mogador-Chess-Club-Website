---
/**
 * /admin/seances/ — session CRUD and the attendance marker.
 *
 * ⚠️ FRENCH ONLY. See `AdminShell.astro` and CLAUDE.md.
 *
 * ═════════════════════════════════════════════════════════════════════════
 * ⚠️ THE MARKER IS THE DESIGN CONSTRAINT OF THIS WHOLE SESSION.
 *
 * Twenty teenagers in a room at Dar Souiri, a prof standing up with a phone.
 * That produces three hard rules, and each one rules out the obvious build:
 *
 *  1. **ONE TAP PER CHILD.** Not tap-to-open, choose, confirm. Three states are
 *     three buttons, always visible, always in the same place on every row.
 *  2. **NO MODAL PER ROW.** A dialog steals focus, covers the list, and has to
 *     be dismissed before the next student — it triples the interaction count
 *     and loses the prof's place in the room.
 *  3. **NO SAVE BUTTON PER ROW, AND NO SAVE BUTTON AT ALL.** Each tap writes
 *     immediately. A single "enregistrer" at the bottom means twenty marks held
 *     in a phone browser that a phone call, a lock screen or a stray back
 *     gesture can take away — and the prof would not know which ones were lost.
 *
 * ⚠️ THE WRITE IS OPTIMISTIC AND FAILURE IS LOUD. The button flips on the tap,
 * because a prof cannot wait for a round trip twenty times on Essaouira mobile
 * data. If the write then fails, the ROW says so and keeps saying so — it does
 * not silently revert, because a mark that quietly undoes itself is worse than
 * one that never happened. The failed row keeps the prof's intended value on
 * screen so they can see what to retry.
 *
 * ⚠️ NOTHING MOVES AFTER A TAP. No re-sort, no removal of marked rows, no
 * collapsing. A list that reorders under a thumb mid-pass is precisely how the
 * next student gets marked wrong, and the prof would have no way to notice.
 *
 * Measured on the built site with twenty children: see docs/MANUAL-TESTS.md.
 * ═════════════════════════════════════════════════════════════════════════
 */
import AdminShell from '@components/admin/AdminShell.astro';
import { bakedAt, bakedFingerprints } from '@lib/agenda';

/**
 * ⚠️ WHAT THIS BUILD BAKED INTO THE PUBLIC AGENDA — the loud half of the
 * agenda's failure mode.
 *
 * `/agenda/` is static: its content is fixed at build time, because a public
 * page may not make a third-party request (Critical Feature 9) and accounts-off
 * builds carry no Supabase at all (18). The unavoidable consequence is that a
 * session published after the last deploy is not on the site — and the public
 * page has no way to know that.
 *
 * This page does. It is built in the SAME build as the agenda, so it knows
 * exactly what was baked; it reads the live table anyway to draw the list; and
 * comparing the two costs one string set. A prof who publishes something then
 * gets told, in French, on the screen they published it from, that the public
 * agenda has not caught up.
 *
 * Without this the failure is completely silent — which is how `/admin/seances`
 * came to be a feature that wrote to a table nobody displayed.
 */
const baked = { at: bakedAt(), fingerprints: bakedFingerprints() };

const STATUSES = [
  { id: 'present', label: 'P', full: 'Présent' },
  { id: 'absent', label: 'A', full: 'Absent' },
  { id: 'excuse', label: 'E', full: 'Excusé' },
] as const;
---

<AdminShell title="Séances" current="seances" intro="Programmer une séance, et marquer les présences.">
  {/* ── The marker, FIRST ────────────────────────────────────────────────
      ⚠️ ABOVE THE CRUD FORM, DELIBERATELY. Marking happens weekly and takes
      two minutes; creating a session happens rarely and can be scrolled to.
      The thing done most often is the thing at the top. */}
  <section class="admin-block">
    <h2 class="admin-block-title">Présences</h2>

    <div class="admin-field">
      <label for="mark-session">Séance</label>
      <select id="mark-session" data-mark-session>
        <option value="">Choisir une séance…</option>
      </select>
    </div>

    <p class="admin-status" data-mark-summary hidden></p>

    <ul class="mark-list" data-mark-list></ul>
    <p class="admin-empty" data-mark-empty hidden>
      Choisissez une séance pour marquer les présences.
    </p>
  </section>

  {/* ── Sessions ─────────────────────────────────────────────────────── */}
  <section class="admin-block">
    <h2 class="admin-block-title">Programmer une séance</h2>
    <form class="admin-form" data-session-form>
      <div class="admin-field">
        <label for="session-when">Date et heure</label>
        <input id="session-when" type="datetime-local" required data-field="startsAt" />
      </div>
      <div class="admin-field">
        <label for="session-title">Intitulé</label>
        <input id="session-title" type="text" maxlength="80" data-field="titleFr" />
      </div>
      <div class="admin-field">
        <label for="session-venue">Lieu</label>
        {/* ⚠️ Free text, and empty means "the club's usual venue". The venue
            lives in site config and must never be hardcoded here — a session
            carries its own only when it differs. See the portability rule. */}
        <input id="session-venue" type="text" maxlength="80" data-field="venue" />
        <p class="admin-field-hint">Vide = le lieu habituel du club.</p>
      </div>
      <div class="admin-field">
        <label for="session-level">Niveau</label>
        <select id="session-level" data-field="level">
          <option value="">Tous niveaux</option>
          <option value="debutant">Débutant</option>
          <option value="intermediaire">Intermédiaire</option>
          <option value="avance">Avancé</option>
        </select>
      </div>
      <div class="admin-field">
        <label for="session-duration">Durée (minutes)</label>
        <input id="session-duration" type="number" min="15" max="480" value="90" data-field="duration" />
      </div>
      <div class="admin-field">
        <label for="session-status">État</label>
        <select id="session-status" data-field="status">
          <option value="draft">Brouillon</option>
          <option value="published">Publiée</option>
        </select>
        <p class="admin-field-hint">Seules les séances publiées sont visibles par les élèves.</p>
      </div>
      {/* ── Repeat ──────────────────────────────────────────────────────────
          ⚠️ THE PREVIEW IS NOT A COURTESY. A prof presses one button and
          thirteen rows land in the public agenda; if the only way to find out
          what was created is to read the list afterwards, a wrong end date
          costs thirteen deletions that the UI deliberately does not offer
          (Critical Feature 46 — a session is cancelled, never deleted). So the
          exact dates are on screen, in full, BEFORE the button is pressed.

          ⚠️ AND THE BUTTON SAYS THE NUMBER. "Créer" and "Créer les 13 séances"
          are different promises; a submit button that does not change when the
          form means thirteen times as much is the half a prof reads. */}
      <fieldset class="admin-repeat">
        <legend>Répéter</legend>
        <div class="admin-field">
          <label for="session-cadence">Répétition</label>
          <select id="session-cadence" data-field="cadence">
            <option value="none">Aucune — une seule séance</option>
            <option value="weekly">Chaque semaine</option>
            <option value="fortnightly">Toutes les deux semaines</option>
          </select>
        </div>
        <div class="admin-field" data-until-field hidden>
          <label for="session-until">Jusqu’au</label>
          <input id="session-until" type="date" data-field="until" />
          <p class="admin-field-hint">
            La dernière séance possible avant cette date incluse. 52 au maximum.
          </p>
        </div>
        <div class="repeat-preview" data-repeat-preview role="status" hidden></div>
      </fieldset>

      <div class="admin-actions">
        <button type="submit" class="btn-primary" data-session-submit>Créer</button>
      </div>
      <p class="admin-error" data-session-error role="status"></p>
    </form>

    {/* ── Is the public agenda up to date? ─────────────────────────────────
        Hidden until the script has compared; a banner that flashes "à jour"
        before it has looked would be worse than none. */}
    <div
      class="agenda-sync"
      data-agenda-sync
      data-baked-at={baked.at ?? ''}
      data-baked={JSON.stringify(baked.fingerprints)}
      hidden
    >
    </div>

    {/* ── Series ──────────────────────────────────────────────────────────
        ⚠️ ONE ROW PER SERIES, NOT TWO MORE BUTTONS ON EVERY CARD. Thirteen
        cards each carrying "publier la série" is thirteen chances to press the
        one that acts on twelve others, and no way to see the set as a set.

        ⚠️ AND BOTH ACTIONS ARE ONE STATEMENT. `update … in (…)` — see the
        rule at the top of `src/lib/admin.ts`. Iterating here would cost one
        Cloudflare build per session, which is precisely the defect the
        statement-level trigger in migration 0011 exists to avoid. */}
    <h2 class="admin-block-title" data-series-title hidden>Séries</h2>
    <div data-series-list hidden></div>

    <h2 class="admin-block-title">Toutes les séances</h2>
    {/* ⚠️ CANCELLED SESSIONS STAY IN THIS LIST, with their state. They are
        never deleted: a session that vanishes leaves students wondering whether
        they misremembered, and deleting it would cascade away a register that
        had already been marked. */}
    <div data-session-list><p class="admin-empty">Chargement…</p></div>
  </section>

  <template data-mark-template>
    <li class="mark-row">
      <span class="mark-name"></span>
      <span class="mark-buttons">
        {
          STATUSES.map((status) => (
            <button
              type="button"
              class="mark-button"
              data-status={status.id}
              aria-pressed="false"
              title={status.full}
            >
              <span aria-hidden="true">{status.label}</span>
              <span class="sr-only">{status.full}</span>
            </button>
          ))
        }
      </span>
    </li>
  </template>
</AdminShell>

<script>
  import {
    cancelSession,
    createSessions,
    listAttendance,
    listChildren,
    listSessions,
    markAttendance,
    newSeriesId,
    sessionsInSeries,
    updateSession,
    updateSessions,
    type AdminChild,
    type AdminSession,
    type AttendanceStatus,
    type SessionInput,
  } from '@lib/admin';
  import { getUser } from '@lib/supabase';
  import { sessionFingerprint } from '@lib/agenda';
  import { expandSeries, SERIES_MAX, type Cadence } from '@lib/recurrence';

  const select = document.querySelector('[data-mark-session]') as HTMLSelectElement | null;
  const list = document.querySelector('[data-mark-list]') as HTMLElement | null;
  const emptyNote = document.querySelector('[data-mark-empty]') as HTMLElement | null;
  const summary = document.querySelector('[data-mark-summary]') as HTMLElement | null;
  const template = document.querySelector('[data-mark-template]') as HTMLTemplateElement | null;
  const form = document.querySelector('[data-session-form]') as HTMLFormElement | null;
  const formError = document.querySelector('[data-session-error]') as HTMLElement | null;
  const sessionList = document.querySelector('[data-session-list]') as HTMLElement | null;
  const submitButton = document.querySelector('[data-session-submit]') as HTMLButtonElement | null;
  const untilField = document.querySelector('[data-until-field]') as HTMLElement | null;
  const preview = document.querySelector('[data-repeat-preview]') as HTMLElement | null;
  const seriesTitle = document.querySelector('[data-series-title]') as HTMLElement | null;
  const seriesList = document.querySelector('[data-series-list]') as HTMLElement | null;

  let children: AdminChild[] = [];
  let sessions: AdminSession[] = [];
  let me: string | null = null;
  /** The marks on screen, so the summary does not need a re-read per tap. */
  const marks = new Map<string, AttendanceStatus>();

  const whenFmt = new Intl.DateTimeFormat('fr-FR', {
    weekday: 'short',
    day: 'numeric',
    month: 'short',
    hour: '2-digit',
    minute: '2-digit',
  });

  function esc(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  function paintSummary() {
    if (!summary) return;
    const total = children.length;
    const done = marks.size;
    const present = [...marks.values()].filter((s) => s === 'present').length;
    summary.hidden = total === 0;
    /* ⚠️ "12 sur 20" and not a percentage: a prof mid-pass needs to know how
       many are LEFT, which a percentage makes them work out. */
    summary.textContent = `${done} sur ${total} marqués · ${present} présents`;
  }

  function renderMarkList(attendance: Map<string, AttendanceStatus>) {
    if (!list || !template) return;
    list.innerHTML = '';
    marks.clear();
    for (const [id, status] of attendance) marks.set(id, status);

    for (const child of children) {
      const node = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
      node.dataset.child = child.id;
      const name = node.querySelector('.mark-name');
      if (name) name.textContent = child.displayName || 'Élève';
      const current = attendance.get(child.id);
      if (current) {
        const button = node.querySelector(`[data-status="${current}"]`);
        button?.setAttribute('aria-pressed', 'true');
      }
      list.appendChild(node);
    }
    paintSummary();
  }

  /**
   * ⚠️ ONE DELEGATED LISTENER FOR THE WHOLE REGISTER, not one per button.
   * Twenty children is sixty buttons; sixty listeners is sixty closures over
   * rows that get replaced whenever the session changes, and the stale ones
   * would keep writing to the previous session.
   */
  list?.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest('.mark-button') as HTMLElement | null;
    if (!button) return;
    const row = button.closest('.mark-row') as HTMLElement | null;
    const childId = row?.dataset.child;
    const sessionId = select?.value;
    if (!row || !childId || !sessionId) return;

    const status = button.dataset.status as AttendanceStatus;

    /* Optimistic: the state flips on the tap. See the header. */
    row.querySelectorAll('.mark-button').forEach((b) => b.setAttribute('aria-pressed', 'false'));
    button.setAttribute('aria-pressed', 'true');
    marks.set(childId, status);
    row.removeAttribute('data-failed');
    row.querySelector('.mark-failed-note')?.remove();
    row.dataset.saving = '';
    paintSummary();

    const result = await markAttendance(sessionId, childId, status, me);
    delete row.dataset.saving;

    if (!result.ok) {
      /* ⚠️ LOUD, AND IT DOES NOT REVERT. The prof's intent stays on screen so
         they can see what to retry; a mark that silently undoes itself is worse
         than one that never happened. */
      row.dataset.failed = '';
      const note = document.createElement('p');
      note.className = 'mark-failed-note';
      note.setAttribute('role', 'status');
      note.textContent = 'Non enregistré — retoucher pour réessayer.';
      row.appendChild(note);
    }
  });

  /**
   * ⚠️ TWO REGISTER LOADS ARE ROUTINELY IN FLIGHT, AND THE LATER ONE TO FINISH
   * IS NOT THE MOST RECENT ONE REQUESTED.
   *
   * The page preselects the nearest session on `mcc:admin-ready` and awaits its
   * `loadRegister()`; a prof who touches the session picker before that settles
   * starts a second one. Both end in `renderMarkList()`, which begins by
   * CLEARING `marks` — so whichever request happens to answer last decides what
   * the register shows, and a stale answer silently discards taps that have
   * already been made.
   *
   * Measured, not hypothetical: the accounts-ON matrix caught the summary
   * reading `18 sur 26 marqués` immediately after twenty successful taps whose
   * rows were already durable in Postgres. The prof's own count — the thing
   * that stops them losing their place in a room of twenty children — was
   * wrong, and every mark was safely in the database.
   *
   * ⚠️ SAME BUG, SAME REMEDY AS `FamilySection.astro`, which carries this exact
   * counter for this exact reason. That lesson was written down and not applied
   * here; a third surface that loads twice must copy the guard, not rediscover
   * the defect.
   */
  let registerGeneration = 0;

  async function loadRegister(sessionId: string) {
    const mine = ++registerGeneration;
    if (!sessionId) {
      if (list) list.innerHTML = '';
      if (emptyNote) emptyNote.hidden = false;
      if (summary) summary.hidden = true;
      return;
    }
    if (emptyNote) emptyNote.hidden = true;
    const rows = await listAttendance(sessionId);
    /* ⚠️ A NEWER LOAD HAS ALREADY ANSWERED — drop this one rather than paint
       over it. This read may have been issued before marks the prof has since
       made, and `renderMarkList()` would wipe them. */
    if (mine !== registerGeneration) return;
    renderMarkList(new Map(rows.map((r) => [r.childId, r.status])));
  }

  select?.addEventListener('change', () => void loadRegister(select.value));

  /* ── Is the deployed agenda still what the database says? ──────────────── */

  const syncBox = document.querySelector('[data-agenda-sync]') as HTMLElement | null;

  /**
   * ⚠️ ONLY FUTURE SESSIONS COUNT, AND THAT IS WHAT MAKES THIS QUIET ENOUGH TO
   * BELIEVE.
   *
   * The baked snapshot drops sessions a day after they finish, so a past
   * session inevitably stops matching. Comparing those would leave a permanent
   * "not up to date" banner, and a warning that is always on is a warning
   * nobody reads — which would leave the real failure just as silent as before.
   *
   * Both directions are counted: something published or edited and not yet
   * deployed, AND something the public agenda still shows that the database no
   * longer agrees with (a session pulled back to draft). A prof cares about the
   * same thing in either case — the site does not match the truth.
   */
  function paintAgendaSync() {
    if (!syncBox) return;
    let bakedList: string[] = [];
    try {
      bakedList = JSON.parse(syncBox.dataset.baked ?? '[]') as string[];
    } catch {
      /* An unreadable stamp must not take the page down; say nothing. */
      return;
    }
    const bakedSet = new Set(bakedList);
    const now = Date.now();

    const liveFuture = sessions.filter(
      (s) => (s.status === 'published' || s.status === 'cancelled') && Date.parse(s.startsAt) >= now,
    );
    const liveSet = new Set(liveFuture.map((s) => sessionFingerprint(s)));
    const notDeployed = liveFuture.filter((s) => !bakedSet.has(sessionFingerprint(s))).length;
    const staleOnSite = bakedList.filter((fp) => {
      /* A baked entry for a session that is still in the future and no longer
         matches anything live. The date is the second field of the print. */
      const startsAt = fp.split('|')[1] ?? '';
      return Date.parse(startsAt) >= now && !liveSet.has(fp);
    }).length;

    const pending = notDeployed + staleOnSite;
    const bakedAtRaw = syncBox.dataset.bakedAt ?? '';
    const builtOn = bakedAtRaw
      ? new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeStyle: 'short' }).format(
          new Date(bakedAtRaw),
        )
      : 'inconnue';

    syncBox.hidden = false;
    syncBox.dataset.state = pending > 0 ? 'pending' : 'ok';
    syncBox.setAttribute('role', 'status');
    syncBox.innerHTML =
      pending > 0
        ? `<p class="agenda-sync-title">⚠️ L’agenda public n’est pas à jour</p>
           <p class="agenda-sync-body">${pending} modification${pending > 1 ? 's' : ''} ne ${
             pending > 1 ? 'sont' : 'est'
           } pas encore visible${pending > 1 ? 's' : ''} sur <a href="/agenda/">/agenda</a>.
           Le site public est reconstruit à chaque déploiement : la séance apparaîtra
           au prochain. Si c’est urgent, prévenez Seàn.</p>
           <p class="agenda-sync-when">Dernière construction : ${builtOn}</p>`
        : `<p class="agenda-sync-title">L’agenda public est à jour</p>
           <p class="agenda-sync-when">Dernière construction : ${builtOn}</p>`;
  }

  /* ── Series ───────────────────────────────────────────────────────────────
     ⚠️ EVERYTHING BELOW READS `series_id` ONLY TO SELECT ROWS THE PROF IS
     ALREADY LOOKING AT. Nothing asks the series what a session should be —
     there is no rule stored, only rows, and migration 0012 carries the whole
     argument. A cancelled week is a cancelled row and nothing else. */

  const spanFmt = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short' });

  function seriesMembers(seriesId: string): AdminSession[] {
    return sessionsInSeries(sessions, seriesId).sort(
      (a, b) => Date.parse(a.startsAt) - Date.parse(b.startsAt),
    );
  }

  /** "3/13" — where this row sits in the set, counting from the first date. */
  function seriesRank(session: AdminSession): string {
    if (!session.seriesId) return '';
    const members = seriesMembers(session.seriesId);
    const index = members.findIndex((s) => s.id === session.id);
    return `${index + 1}/${members.length}`;
  }

  function paintSeries() {
    if (!seriesList || !seriesTitle) return;
    const ids = [...new Set(sessions.map((s) => s.seriesId).filter(Boolean))] as string[];
    /* A single leftover row is not a series — cancelling twelve of thirteen
       must not leave a "série" block offering to act on one card. */
    const groups = ids.map(seriesMembers).filter((m) => m.length > 1);

    seriesTitle.hidden = groups.length === 0;
    seriesList.hidden = groups.length === 0;
    if (groups.length === 0) {
      seriesList.innerHTML = '';
      return;
    }

    const now = Date.now();
    seriesList.innerHTML = groups
      .map((members) => {
        const id = members[0]!.seriesId!;
        const first = new Date(members[0]!.startsAt);
        const last = new Date(members[members.length - 1]!.startsAt);
        const drafts = members.filter((s) => s.status === 'draft');
        /* ⚠️ ONLY THE FUTURE CAN BE CANCELLED. A session that already happened
           happened; marking it "annulée" afterwards would tell a student who
           attended that it did not take place. */
        const upcoming = members.filter(
          (s) => s.status !== 'cancelled' && Date.parse(s.startsAt) >= now,
        );
        const title = members[0]!.titleFr ?? 'Séance';
        return `
        <div class="series-card" data-series-card="${esc(id)}">
          <p class="series-when">${esc(title)} — du ${esc(spanFmt.format(first))} au ${esc(spanFmt.format(last))}</p>
          <p class="series-meta">${members.length} séances · ${drafts.length} brouillon${
            drafts.length > 1 ? 's' : ''
          } · ${upcoming.length} à venir</p>
          <p class="admin-actions">
            ${
              drafts.length > 0
                ? `<button type="button" class="btn-ghost" data-series-publish>Publier les ${drafts.length} brouillons</button>`
                : ''
            }
            ${
              upcoming.length > 0
                ? `<button type="button" class="btn-ghost" data-series-cancel>Annuler les ${upcoming.length} séances à venir</button>`
                : ''
            }
          </p>
        </div>`;
      })
      .join('');
  }

  seriesList?.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement;
    const card = target.closest('[data-series-card]') as HTMLElement | null;
    const id = card?.dataset.seriesCard;
    if (!id) return;

    const members = seriesMembers(id);
    const now = Date.now();

    /* ⚠️ ONE STATEMENT EACH — `update … in (…)`. A loop here would cost one
       Cloudflare build per session, which is the exact defect the
       statement-level trigger in 0011 exists to avoid. Measured by
       `recurring-sessions.spec.ts`, not assumed. */
    if (target.hasAttribute('data-series-publish')) {
      const ids = members.filter((s) => s.status === 'draft').map((s) => s.id);
      if (ids.length === 0) return;
      if (!window.confirm(`Publier ${ids.length} séances ? Les élèves les verront toutes.`)) return;
      await updateSessions(ids, { status: 'published' });
    } else if (target.hasAttribute('data-series-cancel')) {
      const ids = members
        .filter((s) => s.status !== 'cancelled' && Date.parse(s.startsAt) >= now)
        .map((s) => s.id);
      if (ids.length === 0) return;
      if (
        !window.confirm(
          `Annuler ${ids.length} séances à venir ? Les élèves les verront comme annulées. ` +
            'Les séances passées ne sont pas touchées.',
        )
      ) {
        return;
      }
      await updateSessions(ids, { status: 'cancelled' });
    } else return;

    sessions = await listSessions();
    paintSessions();
    fillSessionSelect();
  });

  function paintSessions() {
    /* ⚠️ FIRST, AND BEFORE THE EMPTY-LIST RETURN BELOW. Every path that
       refreshes the list — create, publish, cancel, first load — comes through
       here, so this is the one call site; and an account with no sessions at
       all can still have a stale entry baked into the deployed agenda. */
    paintAgendaSync();
    paintSeries();
    if (!sessionList) return;
    if (sessions.length === 0) {
      sessionList.innerHTML = '<p class="admin-empty">Aucune séance.</p>';
      return;
    }
    const labels: Record<string, string> = {
      draft: 'brouillon',
      published: 'publiée',
      cancelled: 'annulée',
    };
    sessionList.innerHTML = sessions
      .map(
        (s) => `
        <div class="session-card" data-status="${s.status}" data-session="${s.id}"${
          s.seriesId ? ` data-series="${esc(s.seriesId)}"` : ''
        }>
          <div class="session-when">${esc(whenFmt.format(new Date(s.startsAt)))}</div>
          <p class="session-meta">${esc(s.titleFr ?? 'Séance')}${s.venue ? ' — ' + esc(s.venue) : ''} · ${s.durationMinutes} min</p>
          ${
            /* ⚠️ THE BADGE SAYS THE ROW BELONGS TO A SET AND NOTHING MORE. It
               is not a control: every action on this card acts on this card. */
            s.seriesId ? `<span class="session-series">série · ${seriesRank(s)}</span>` : ''
          }
          <span class="session-status" data-status="${s.status}">${labels[s.status]}</span>
          <p class="admin-actions">
            ${
              s.status === 'draft'
                ? '<button type="button" class="btn-ghost" data-publish>Publier</button>'
                : ''
            }
            ${
              s.status !== 'cancelled'
                ? '<button type="button" class="btn-ghost" data-cancel>Annuler la séance</button>'
                : ''
            }
          </p>
        </div>`,
      )
      .join('');
  }

  sessionList?.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement;
    const card = target.closest('[data-session]') as HTMLElement | null;
    const id = card?.dataset.session;
    if (!id) return;

    if (target.hasAttribute('data-publish')) {
      await updateSession(id, { status: 'published' });
    } else if (target.hasAttribute('data-cancel')) {
      /* ⚠️ Confirmed, because it is visible to every student the moment it
         lands — and it is a state change, not a deletion. */
      if (!window.confirm('Annuler cette séance ? Les élèves la verront comme annulée.')) return;
      await cancelSession(id);
    } else return;

    sessions = await listSessions();
    paintSessions();
    fillSessionSelect();
  });

  function fillSessionSelect() {
    if (!select) return;
    const keep = select.value;
    /* ⚠️ Cancelled sessions are NOT offered for marking — there is no register
       to take for a session that did not happen — but they stay in the list
       above with their state. */
    const options = sessions
      .filter((s) => s.status !== 'cancelled')
      .sort((a, b) => Date.parse(b.startsAt) - Date.parse(a.startsAt));
    select.innerHTML =
      '<option value="">Choisir une séance…</option>' +
      options
        .map(
          (s) =>
            `<option value="${s.id}">${esc(whenFmt.format(new Date(s.startsAt)))} — ${esc(s.titleFr ?? 'Séance')}</option>`,
        )
        .join('');
    if (keep && options.some((s) => s.id === keep)) select.value = keep;
  }

  /* ── Repeat: the preview, and the one expansion both halves share ─────────
     ⚠️ THE PREVIEW AND THE WRITE CALL `expandSeries()` WITH THE SAME INPUT,
     and the write recomputes rather than reusing what was drawn. A preview
     that is a separate calculation from the thing it previews is a preview
     that can be wrong; a preview that is a cached result is a preview that can
     be stale. Recomputing from the live fields at submit is neither. */

  const field = (name: string) =>
    (form?.querySelector(`[data-field="${name}"]`) as HTMLInputElement | HTMLSelectElement | null)
      ?.value ?? '';

  const dayFmt = new Intl.DateTimeFormat('fr-FR', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    hour: '2-digit',
    minute: '2-digit',
  });

  const PROBLEMS: Record<string, string> = {
    'no-start': 'Choisissez d’abord une date et une heure.',
    'bad-start': 'La date de départ n’est pas lisible.',
    'no-until': 'Jusqu’à quelle date ?',
    'bad-until': 'La date de fin n’est pas lisible.',
    'until-before-start': 'La date de fin est avant la première séance.',
  };

  function currentExpansion() {
    return expandSeries({
      startLocal: field('startsAt'),
      cadence: (field('cadence') || 'none') as Cadence,
      untilLocal: field('until'),
    });
  }

  function paintPreview() {
    if (!preview || !submitButton) return;
    const repeating = field('cadence') !== 'none';
    if (untilField) untilField.hidden = !repeating;

    if (!repeating) {
      preview.hidden = true;
      preview.innerHTML = '';
      submitButton.textContent = 'Créer';
      return;
    }

    const result = currentExpansion();
    preview.hidden = false;

    if (!result.ok) {
      /* ⚠️ REFUSED, NEVER TRUNCATED. Creating the first 52 of 520 and saying
         nothing would leave a prof believing the rest exist. */
      preview.dataset.state = 'problem';
      preview.innerHTML =
        result.problem === 'too-many'
          ? `<p class="repeat-count">${result.wanted} séances — c’est trop.</p>
             <p class="repeat-note">Maximum ${SERIES_MAX} d’un coup. Vérifiez l’année de la date
             de fin, puis recommencez en deux fois si c’est bien ce que vous vouliez.</p>`
          : `<p class="repeat-note">${PROBLEMS[result.problem] ?? 'Répétition impossible.'}</p>`;
      submitButton.textContent = 'Créer';
      return;
    }

    preview.dataset.state = 'ok';
    const n = result.dates.length;
    preview.innerHTML =
      `<p class="repeat-count">${n} séance${n > 1 ? 's' : ''} ${n > 1 ? 'seront créées' : 'sera créée'} :</p>` +
      '<ol class="repeat-dates">' +
      result.dates.map((d) => `<li>${esc(dayFmt.format(d))}</li>`).join('') +
      '</ol>';
    submitButton.textContent = n > 1 ? `Créer les ${n} séances` : 'Créer';
  }

  form?.addEventListener('input', paintPreview);
  form?.addEventListener('change', paintPreview);
  /* Once at load, so the "Jusqu’au" field's visibility matches the select even
     if a browser restored a previous value on a back-navigation. */
  paintPreview();

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!formError) return;
    formError.textContent = '';

    if (!field('startsAt')) {
      formError.textContent = 'Une date est nécessaire.';
      return;
    }

    const expansion = currentExpansion();
    if (!expansion.ok) {
      formError.textContent =
        expansion.problem === 'too-many'
          ? `${expansion.wanted} séances — maximum ${SERIES_MAX} d’un coup.`
          : (PROBLEMS[expansion.problem] ?? 'Répétition impossible.');
      return;
    }

    const repeating = expansion.dates.length > 1;
    /* ⚠️ Confirmed only when it is a SET. One session is one row and one
       undo-by-cancelling; thirteen is a term in the public agenda. */
    if (
      repeating &&
      !window.confirm(`Créer ${expansion.dates.length} séances ? Elles seront modifiables une par une.`)
    ) {
      return;
    }

    const common = {
      durationMinutes: Number(field('duration')) || 90,
      titleFr: field('titleFr').trim() || null,
      venue: field('venue').trim() || null,
      level: field('level') || null,
      status: (field('status') || 'draft') as 'draft' | 'published',
      /* ⚠️ A LABEL ON ROWS CREATED TOGETHER, and only when there ARE rows
         created together. A one-off carries none — see migration 0012. */
      seriesId: repeating ? newSeriesId() : null,
    };

    /* ⚠️ ONE CALL, ONE STATEMENT, ONE REBUILD. Never a loop — see the section
       header in `src/lib/admin.ts`. `datetime-local` has no zone; the browser's
       own is the right one, because the prof is entering the time in the room
       they will be standing in. */
    const rows: SessionInput[] = expansion.dates.map((date) => ({
      ...common,
      startsAt: date.toISOString(),
    }));

    const result = await createSessions(rows);

    if (!result.ok) {
      formError.textContent = result.error ?? 'La séance n’a pas pu être créée.';
      return;
    }
    form.reset();
    paintPreview();
    sessions = await listSessions();
    paintSessions();
    fillSessionSelect();
  });

  window.addEventListener('mcc:admin-ready', async () => {
    const [user, kids, allSessions] = await Promise.all([getUser(), listChildren(), listSessions()]);
    me = user?.id ?? null;
    children = kids;
    sessions = allSessions;
    paintSessions();
    fillSessionSelect();

    /* Preselect the nearest session that is not cancelled — on a phone, at the
       start of a class, that is almost always the one being marked. */
    const now = Date.now();
    const nearest = [...sessions]
      .filter((s) => s.status !== 'cancelled')
      .sort(
        (a, b) =>
          Math.abs(Date.parse(a.startsAt) - now) - Math.abs(Date.parse(b.startsAt) - now),
      )[0];
    /* ⚠️ ONLY IF THE READER HAS NOT ALREADY CHOSEN. `fillSessionSelect()` runs
       above and this handler is async, so a prof quick enough to pick a session
       in that window would have it taken off them again — the picker would jump
       back to "nearest" under their thumb and load a different register. The
       preselect is a convenience for an untouched control, not an override. */
    const alreadyChosen = Boolean(select?.value);
    if (nearest && select && !alreadyChosen) {
      select.value = nearest.id;
      await loadRegister(nearest.id);
    } else if (alreadyChosen && select) {
      await loadRegister(select.value);
    } else if (emptyNote) emptyNote.hidden = false;
  });
</script>
