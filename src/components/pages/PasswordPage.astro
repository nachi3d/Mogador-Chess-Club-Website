---
/**
 * /mot-de-passe — the reader chooses their own, forced or voluntary.
 *
 * ═════════════════════════════════════════════════════════════════════════
 * ⚠️ ONE PAGE FOR BOTH CASES, AND THE DIFFERENCE IS ONE SENTENCE.
 *
 * A student who forgot their password gets a temporary one from Seàn, read out
 * or sent on WhatsApp. `admin_reset_password()` flags the account, the landing
 * rule sends them here on the next sign-in, and the banner explains why they
 * are looking at this page instead of their profiles. Everybody else reaches
 * the same form from `/compte/` when they simply want a new password.
 *
 * ⚠️ THE CURRENT PASSWORD IS ASKED FOR IN BOTH CASES, AND IT IS VERIFIED IN
 * POSTGRES. The family phone left signed in on the kitchen table is the normal
 * case at this club, not the exotic one: without that check this screen is a
 * "take this account" button for whoever picks the phone up next. In the forced
 * case the "current" password is the temporary one the reader typed thirty
 * seconds ago, which is the least friction that is still safe.
 *
 * ⚠️ IT IS NOT A GATE. A reader who navigates away keeps a working account —
 * `must_change_password` only decides where sign-in LANDS them. Making it a
 * real gate would mean a student locked out of a site whose whole point is that
 * nothing is locked, over a password Seàn already knows.
 *
 * ⚠️ THE SEGMENT IS NOT TRANSLATED (`/en/mot-de-passe/`), like every other
 * route on this site. Visible labels are translated; URLs are structural.
 * ═════════════════════════════════════════════════════════════════════════
 */
import type { Locale } from '@config/site';
import { localizePath } from '@i18n/paths';
import { useTranslations } from '@i18n/ui';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/PageIntro.astro';
import Trail from '@components/nav/Trail.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={t('password.title')} description={t('password.intro')}>
  <Trail locale={locale} href={localizePath('/compte/', locale)} label={t('account.title')} />
  <PageIntro title={t('password.title')} intro={t('password.intro')} />

  <div
    class="auth-card"
    data-testid="password-page"
    data-state="loading"
    data-locale={locale}
    data-msg-working={t('password.working')}
    data-msg-submit={t('password.submit')}
    data-msg-saved={t('password.saved')}
    data-msg-mismatch={t('password.mismatch')}
    data-err-wrong-password={t('password.error.wrong_password')}
    data-err-password-too-short={t('password.error.password_too_short')}
    data-err-not-pseudo-account={t('password.error.not_pseudo_account')}
    data-err-unknown={t('password.error.unknown')}
  >
    {/* Signed out — the default, because that is what a static page can prove.
        Same shape as `/compte/`: the HTML has no way to ask who this is. */}
    <div class="account-signed-out" data-testid="password-signed-out" hidden>
      <p>{t('account.signedOut')}</p>
      <p>
        <a class="btn-primary" href={localizePath('/connexion/', locale)}>
          {t('account.goSignIn')}
        </a>
      </p>
    </div>

    <div data-testid="password-panel" hidden>
      {/* ⚠️ SERVER-RENDERED AND REVEALED, NEVER BUILT BY SCRIPT. An element the
          script creates carries no `data-astro-cid-*`, so every scoped rule
          below would silently miss it — the defect that has bitten three times
          in this codebase. */}
      <p class="password-forced" data-testid="password-forced" hidden>{t('password.forced')}</p>

      <form data-testid="password-form" novalidate>
        <label for="password-current">{t('password.currentLabel')}</label>
        <p class="auth-hint" id="password-current-hint">{t('password.currentHint')}</p>
        <input
          id="password-current"
          type="password"
          autocomplete="current-password"
          aria-describedby="password-current-hint"
          required
          data-testid="password-current"
        />

        <label for="password-new">{t('password.newLabel')}</label>
        <input
          id="password-new"
          type="password"
          autocomplete="new-password"
          required
          data-testid="password-new"
        />

        <label for="password-confirm">{t('password.confirmLabel')}</label>
        <input
          id="password-confirm"
          type="password"
          autocomplete="new-password"
          required
          data-testid="password-confirm"
        />

        <p class="auth-reveal">
          <input type="checkbox" id="password-reveal" data-testid="password-reveal" />
          <label for="password-reveal">{t('login.showPassword')}</label>
        </p>

        <button type="submit" class="btn-primary" data-testid="password-submit">
          {t('password.submit')}
        </button>
        <p class="auth-status" role="status" data-testid="password-status"></p>
      </form>
    </div>
  </div>

  <script>
    import { changeOwnPassword, getProfile, getSession, landingAfterSignIn } from '@lib/supabase';
    import { PASSWORD_MIN } from '@lib/pseudo';

    const root = document.querySelector('[data-testid="password-page"]') as HTMLElement | null;
    const signedOut = document.querySelector('[data-testid="password-signed-out"]') as HTMLElement | null;
    const panel = document.querySelector('[data-testid="password-panel"]') as HTMLElement | null;
    const forced = document.querySelector('[data-testid="password-forced"]') as HTMLElement | null;
    const form = document.querySelector('[data-testid="password-form"]') as HTMLFormElement | null;
    const current = document.querySelector('[data-testid="password-current"]') as HTMLInputElement | null;
    const next = document.querySelector('[data-testid="password-new"]') as HTMLInputElement | null;
    const confirm = document.querySelector('[data-testid="password-confirm"]') as HTMLInputElement | null;
    const reveal = document.querySelector('[data-testid="password-reveal"]') as HTMLInputElement | null;
    const submit = document.querySelector('[data-testid="password-submit"]') as HTMLButtonElement | null;
    const status = document.querySelector('[data-testid="password-status"]') as HTMLElement | null;

    const message = (token: string) =>
      root?.getAttribute(`data-err-${token.replace(/_/g, '-')}`) ??
      root?.getAttribute('data-err-unknown') ??
      '';

    reveal?.addEventListener('change', () => {
      const type = reveal.checked ? 'text' : 'password';
      for (const field of [current, next, confirm]) if (field) field.type = type;
    });

    (async () => {
      const session = await getSession();
      if (!session) {
        root?.setAttribute('data-state', 'signed-out');
        if (signedOut) signedOut.hidden = false;
        return;
      }
      const profile = await getProfile();
      /* ⚠️ THE BANNER IS THE ONLY THING THE FLAG CHANGES HERE. A magic-link
         account that lands on this page still sees the form and is refused by
         `change_own_password()` with `not_pseudo_account` — which is the honest
         answer, and one the page could not give as reliably by guessing. */
      if (forced && profile?.must_change_password) forced.hidden = false;
      root?.setAttribute('data-state', 'ready');
      if (panel) panel.hidden = false;
      current?.focus();
    })();

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!current || !next || !confirm || !submit || !status) return;
      status.textContent = '';

      if (next.value.length < PASSWORD_MIN) {
        status.textContent = message('password_too_short');
        next.focus();
        return;
      }
      /* ⚠️ THE CONFIRMATION FIELD EXISTS HERE AND NOT ON SIGN-UP, on purpose.
         A new password typed wrong twice on sign-up is caught by reading it;
         typed wrong here it locks an account that already has progress in it. */
      if (next.value !== confirm.value) {
        status.textContent = root?.dataset.msgMismatch ?? '';
        confirm.focus();
        return;
      }

      submit.disabled = true;
      submit.textContent = root?.dataset.msgWorking ?? '';

      const result = await changeOwnPassword(current.value, next.value);
      if (!result.ok) {
        status.textContent = message(result.error);
        submit.disabled = false;
        submit.textContent = root?.dataset.msgSubmit ?? '';
        current.select();
        return;
      }

      status.textContent = root?.dataset.msgSaved ?? '';
      /* The flag is cleared in the same statement as the new hash, so asking
         the landing rule again sends a reset reader onward rather than back
         here. A full document load, like sign-out and deletion. */
      window.location.assign(await landingAfterSignIn());
    });
  </script>
</BaseLayout>

<style>
  .auth-card {
    max-width: 32rem;
    padding: 1.5rem;
    border: 1px solid var(--mcc-border-subtle);
    border-radius: var(--radius-card);
    background-color: var(--mcc-surface-raised);
  }

  /* ⚠️ A NOTICE, NOT AN ALARM. Somebody whose password was reset has not done
     anything wrong, and the club gave them the temporary one on purpose. */
  .password-forced {
    margin: 0 0 1.25rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--mcc-border-strong);
    border-radius: var(--radius-card);
    background-color: var(--mcc-surface-page);
  }

  label {
    display: block;
    margin-bottom: 0.2rem;
    font-weight: 500;
  }

  .auth-hint {
    margin: 0 0 0.4rem;
    color: var(--mcc-text-secondary);
    font-size: 0.9rem;
  }

  input[type='password'],
  input[type='text'] {
    width: 100%;
    padding: 0.6rem 0.75rem;
    margin-bottom: 1.1rem;
    border: 1px solid var(--mcc-border-strong);
    border-radius: var(--radius-card);
    background-color: var(--mcc-surface-page);
    color: var(--mcc-text-primary);
    font: inherit;
  }

  input:focus-visible {
    outline: 2px solid var(--mcc-focus-ring);
    outline-offset: 1px;
  }

  .auth-reveal {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: -0.6rem 0 1rem;
  }

  .auth-reveal input {
    width: auto;
    margin: 0;
    min-width: 1.15rem;
    min-height: 1.15rem;
  }

  .auth-reveal label {
    margin: 0;
    font-weight: 400;
  }

  .btn-primary {
    padding: 0.7rem 1.4rem;
    border: 1px solid var(--mcc-primary);
    border-radius: var(--radius-card);
    background-color: var(--mcc-primary);
    color: var(--mcc-primary-contrast);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }

  .btn-primary:disabled {
    opacity: 0.7;
    cursor: default;
  }

  .auth-status {
    margin: 0.75rem 0 0;
    min-height: 1.2em;
  }

  .account-signed-out p {
    margin: 0 0 0.75rem;
  }
</style>
