---
/**
 * One step of `/apprendre-les-bases/`.
 *
 * ⚠️ NO NEW BOARD, AND NO NEW MODE. This mounts the existing `ExerciseBoard`,
 * which is the existing `ChessBoard` island in `mode="exercise"`.
 *
 * That already provides everything a beginner needs, and the reason is worth
 * writing down so nobody builds a "sandbox mode" later: exercise mode computes
 * `dests` from **every legal move in the position** (`destsOf()` in
 * `src/lib/chess/exercise.ts`), so tapping a piece already lights up exactly
 * where that piece may go. Demonstration and checking are the same board.
 *
 * Progress is stored under a `tutorial:` slug namespace in the same
 * `mcc:progress:v1` store as every other exercise — so v2-S3's sync picks these
 * up with no special-casing at all.
 */
import type { Locale } from '@config/site';
import type { CollectionEntry } from 'astro:content';
import { localizePath } from '@i18n/paths';
import { useTranslations } from '@i18n/ui';
import BaseLayout from '@layouts/BaseLayout.astro';
import Trail from '@components/nav/Trail.astro';
import ExerciseBoard from '@components/board/ExerciseBoard.astro';
import ScoreResolver from '@components/progress/ScoreResolver.astro';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'tutoriel'>;
  prev: CollectionEntry<'tutoriel'> | null;
  next: CollectionEntry<'tutoriel'> | null;
  total: number;
}

const { locale, entry, prev, next, total } = Astro.props;
const { data } = entry;
const t = useTranslations(locale);

const fr = locale === 'fr';
const title = fr ? data.title_fr : data.title_en;
const body = fr ? data.body_fr : data.body_en;
const task = fr ? data.task_fr : data.task_en;
const hint = fr ? data.hint_fr : data.hint_en;

/**
 * The copy uses `**bold**` for the one or two words that carry the rule. Full
 * Markdown would be overkill for that, and a Markdown body would also break the
 * one-language-per-field rule the JSON content model exists to enforce — so a
 * single deliberate transform, applied to text that is already escaped.
 */
function emphasise(text: string): string {
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
}

const indexPath = localizePath('/apprendre-les-bases/', locale);
---

<BaseLayout locale={locale} title={title} description={fr ? data.summary_fr : data.summary_en} board>
  <article class="step">
    {/* The parent, named. Same reasoning as LessonPage. */}
    <Trail locale={locale} href={indexPath} label={t('nav.basics')} />
    <header class="step-head">
      <p class="step-counter">
        <span>{t('tutorial.step')} {data.order} {t('tutorial.of')} {total}</span>
      </p>
      <h1>{title}</h1>
    </header>

    <div class="step-prose">
      {body.map((paragraph) => <p set:html={emphasise(paragraph)} />)}
    </div>

    <section class="step-task" aria-labelledby="task-heading">
      <h2 id="task-heading">{t('tutorial.yourTurn')}</h2>
      <p set:html={emphasise(task)} />
    </section>

    {/* ⚠️ A WRAPPER THIS COMPONENT DECLARES, so the scoped grid below can place
        it. `ExerciseBoard` renders `.mcc-board-block` from ANOTHER component,
        and a scoped rule cannot reach an element this template does not
        declare — the same rule that stranded the progress rows. */}
    <div class="step-board">
      <ExerciseBoard
        locale={locale}
        slug={`tutorial:${data.slug}`}
        fen={data.fen}
        solution={data.solution}
        opponentReplies={data.opponentReplies}
        onlyMove={data.onlyMove}
        hint={hint}
        {...(data.orientation ? { orientation: data.orientation } : {})}
      />
    </div>

    {
      !next && (
        <section class="step-finished">
          <h2>{t('tutorial.finished.title')}</h2>
          <p>{t('tutorial.finished.body')}</p>
          <p class="step-finished-links">
            <a class="btn-primary" href={localizePath('/exercices/', locale)}>
              {t('tutorial.toExercises')}
            </a>
            <a class="btn-ghost" href={localizePath('/jouer/', locale)}>
              {t('tutorial.toPlay')}
            </a>
          </p>
        </section>
      )
    }

    {/* The destination is NAMED, not just "next". A reader deciding whether to
        carry on wants to know what is coming — "Suivant : Le fou" answers that,
        "Suivant →" makes them click to find out. The index link is always
        present, not only on the first step. */}
    <nav class="step-nav" aria-label={t('tutorial.title')}>
      <div class="step-nav-row">
        {
          prev ? (
            <a
              class="step-nav-link"
              href={localizePath(`/apprendre-les-bases/${prev.data.slug}/`, locale)}
              rel="prev"
              data-testid="tutorial-prev"
            >
              <span class="step-nav-dir">← {t('tutorial.prev')}</span>
              <span class="step-nav-title">
                {locale === 'fr' ? prev.data.title_fr : prev.data.title_en}
              </span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a
              class="step-nav-link step-nav-next"
              href={localizePath(`/apprendre-les-bases/${next.data.slug}/`, locale)}
              rel="next"
              data-testid="tutorial-next"
            >
              <span class="step-nav-dir">{t('tutorial.next')} →</span>
              <span class="step-nav-title">
                {locale === 'fr' ? next.data.title_fr : next.data.title_en}
              </span>
            </a>
          )
        }
      </div>
      <p class="step-nav-index">
        <a href={indexPath} data-testid="tutorial-index">{t('tutorial.backToIndex')}</a>
      </p>
    </nav>
  </article>

  {/* E3 — the board islands call `refreshScore()` after a solve or a win, and
      this is what publishes the function and owns the achievement toast. A page
      with a judged board and no resolver still works: `src/lib/score.ts`
      returns null and the board simply shows no award. */}
  <ScoreResolver locale={locale} />
</BaseLayout>

<style>
  /* ══════════════════════════════════════════════════════════════════════
     ⚠️⚠️ THE READABLE MEASURE BELONGS TO THE PROSE, NOT TO THE CARD.

     This was `.step { max-width: 60ch }`, which capped the WHOLE step — the
     board and its controls included — at a width chosen for sentences.
     Measured at 1440px and at 1690px: `main` is 1184px and the card was
     606px, so the reader scrolled 1.84 screens past content that would have
     fitted, with more than half the page empty beside it.

     The cap now sits on the text blocks. The board is not prose and takes its
     own width (`--mcc-board-max`).
     ══════════════════════════════════════════════════════════════════════ */
  .step-head,
  .step-prose,
  .step-task,
  .step-finished {
    max-width: 60ch;
  }

  /* ── The board bleeds to the card's edges on a phone ───────────────────
     ⚠️ THIS IS WHAT KEEPS CRITICAL FEATURE 28 TRUE HERE — the controls
     compact, the board does not. Once the exercise grid stopped overflowing
     (see exercise.css), the board sized honestly to its column, and on THIS
     page the column is the narrowest on the site: the step card's 20px padding
     sits inside the page gutter, and the board block adds 12px of its own. At
     360px that left a 263px board — 28px squares, against 34px on
     `/exercices/` for the same phone.

     The text keeps its padding; the board is a figure and takes the full card.
     Measured at 360px: 263px → 303px, which is the same square size the
     exercise page gives. */
  @media (max-width: 47.99rem) {
    .step-board {
      margin-inline: calc(var(--mcc-card-pad) * -1);
    }
  }

  /* ── Two columns once there is genuinely room for two ──────────────────
     60ch + a 34rem board + the gap needs ~1140px of MAIN, and main is capped
     at --mcc-container-max (74rem = 1184px). Below this the single column is
     correct and unchanged: a board squeezed beside prose is worse than a
     board under it. */
  @media (min-width: 90rem) {
    .step {
      display: grid;
      /* ⚠️ THE PROSE COLUMN TAKES THE REMAINDER, AND THE BOARD IS 30rem RATHER
         THAN ITS 34rem MAXIMUM. Asking for `60ch` here and letting the board
         have its full width needs ~1232px inside a container capped at 1184,
         so the grid silently shrank the text instead: measured at 50
         characters, below the 55 the lesson measure spec treats as the floor.
         Sizing the board column down by 4rem buys the prose back — measured
         at 62 characters, inside the 60–70 rule, with the board still half as
         wide again as a phone's. */
      grid-template-columns: minmax(0, 60ch) minmax(0, 1fr);
      column-gap: var(--mcc-space-lg);
      align-items: start;
    }

    /* The trail spans, so it still reads as the way out of the whole step. */
    .step > :global(.trail) {
      grid-column: 1 / -1;
    }

    .step-head,
    .step-prose,
    .step-task {
      grid-column: 1;
    }

    /* ⚠️ SPANS THE TEXT ROWS RATHER THAN SITTING IN ONE. The board is taller
       than any single text block; pinning it to one row would leave the other
       two stranded beside white space. */
    .step-board {
      grid-column: 2;
      grid-row: 2 / span 3;
    }

    .step-finished,
    .step-nav {
      grid-column: 1 / -1;
    }
  }

  .step-counter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    color: var(--mcc-text-secondary);
    font-size: 0.875rem;
  }

  .step-counter a {
    color: var(--mcc-link);
  }

  .step h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    line-height: 1.1;
  }

  .step-prose p {
    margin: 0 0 0.9rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .step-task {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border-left: 4px solid var(--mcc-accent-strong);
    border-radius: var(--radius-card);
    background-color: var(--mcc-surface-sunken);
  }

  .step-task h2 {
    margin: 0 0 0.35rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mcc-accent-text);
  }

  .step-task p {
    margin: 0;
    line-height: 1.6;
  }

  .step-finished {
    margin-top: 2rem;
    padding: 1.25rem;
    border: 1px solid var(--mcc-border-subtle);
    border-radius: var(--radius-card);
    background-color: var(--mcc-surface-raised);
  }

  .step-finished h2 {
    margin: 0 0 0.4rem;
    font-size: 1.25rem;
  }

  .step-finished p {
    margin: 0 0 1rem;
    color: var(--mcc-text-secondary);
  }

  .step-finished-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
  }

  .step-nav {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--mcc-border-subtle);
  }

  .step-nav-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .step-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--mcc-border-subtle);
    border-radius: var(--radius-card);
    background-color: var(--mcc-surface-raised);
    color: var(--mcc-link);
    text-decoration: none;
  }

  .step-nav-link:hover {
    border-color: var(--mcc-border-strong);
  }

  .step-nav-next {
    text-align: right;
  }

  .step-nav-dir {
    color: var(--mcc-text-secondary);
    font-size: 0.8125rem;
  }

  .step-nav-title {
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .step-nav-index {
    margin: 1rem 0 0;
    text-align: center;
  }

  .step-nav-index a {
    color: var(--mcc-link);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  /* A single column when there is not room for two side by side. */
  @media (max-width: 30rem) {
    .step-nav-row {
      grid-template-columns: 1fr;
    }

    .step-nav-next {
      text-align: left;
    }
  }
</style>
