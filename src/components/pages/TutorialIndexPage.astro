---
/**
 * `/apprendre-les-bases/` — the guided sequence, listed.
 *
 * ⚠️ NO BOARD IS MOUNTED HERE. Thirteen live boards on one page would be
 * thirteen hydrated islands, and CLAUDE.md is explicit: a page needing several
 * diagrams uses static images or ONE board the reader steps through. The board
 * lives on each step's own route, exactly as `/exercices/` works.
 */
import type { Locale } from '@config/site';
import { getCollection } from 'astro:content';
import { localizePath } from '@i18n/paths';
import { useTranslations } from '@i18n/ui';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/PageIntro.astro';
import NumberedCard from '@components/NumberedCard.astro';
import ProgressStates from '@components/ProgressStates.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const steps = (await getCollection('tutoriel', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout locale={locale} title={t('tutorial.title')} description={t('tutorial.intro')} reveals>
  <PageIntro title={t('tutorial.title')} intro={t('tutorial.intro')} />

  <ol class="steps" data-reveal-stagger>
    {
      steps.map((step) => (
        <NumberedCard
          locale={locale}
          number={step.data.order}
          title={locale === 'fr' ? step.data.title_fr : step.data.title_en}
          summary={locale === 'fr' ? step.data.summary_fr : step.data.summary_en}
          href={localizePath(`/apprendre-les-bases/${step.data.slug}/`, locale)}
          progressKeys={[`tutorial:${step.data.slug}`]}
          doneLabel={t('tutorial.done')}
        />
      ))
    }
  </ol>

  {/* ⚠️ The tick script moved into ProgressStates (M3). It used to read
      `solvedSlugs()` and reveal a bare ✓, which could only ever say "done" —
      a step the reader had attempted and not solved looked identical to one
      they had never opened. The shared component says which of the three it
      is, from the same store under the same `tutorial:` namespace. */}
  <ProgressStates />
</BaseLayout>

<style>
  .steps {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  /* ⚠️ `.step` MOVED TO NumberedCard.astro (M3). It was a pixel-identical copy
     of CourseDetailPage's `.lesson-card`. One card, one definition; the
     surface vocabulary is in src/styles/cards.css. */
</style>
