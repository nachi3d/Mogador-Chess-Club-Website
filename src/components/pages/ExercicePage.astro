---
/**
 * A single exercise: the interactive board, the hint, and the share/back links.
 *
 * Shared by both locale routes. `getStaticPaths` lives in the route files, so
 * this component receives an already-resolved entry.
 */
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '@config/site';
import { site } from '@config/site';
import { exercisesPath, localizePath } from '@i18n/paths';
import { useTranslations } from '@i18n/ui';
import BaseLayout from '@layouts/BaseLayout.astro';
import Trail from '@components/nav/Trail.astro';
import LevelBadge from '@components/LevelBadge.astro';
import ExerciseBoard from '@components/board/ExerciseBoard.astro';
import ScoreResolver from '@components/progress/ScoreResolver.astro';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'exercices'>;
  /**
   * The neighbours in THE order — see `sortExercises`. Computed at build time
   * by the route, so this page never holds a list of every exercise.
   *
   * ⚠️ Optional on the type so the component still renders if a future caller
   * mounts it without them; the pager simply does not appear. An exercise with
   * no way onward is a worse page, not a broken one.
   */
  prev?: CollectionEntry<'exercices'> | null;
  next?: CollectionEntry<'exercices'> | null;
}

const { locale, entry, prev = null, next = null } = Astro.props;
const { data } = entry;
const t = useTranslations(locale);

const title = locale === 'fr' ? data.title_fr : data.title_en;
const hint = locale === 'fr' ? data.hint_fr : data.hint_en;

/**
 * The description does double duty as the OG description, so it must not give
 * the puzzle away — a link preview that spoils its own exercise is worse than
 * no preview. The hint is a nudge, not a solution, which is exactly right here.
 */
const description = `${t('exercises.title')} — ${title}`;

/**
 * Outbound share only. The club has no in-app messaging of any kind — no
 * comments, no chat, no reactions (CLAUDE.md → "No in-app communication").
 * This hands the reader's own WhatsApp a prefilled message and gets out of the
 * way; nothing is posted anywhere by us, and there is no recipient number.
 */
const shareUrl = new URL(Astro.url.pathname, site.url).href;
const shareText = `${title} — ${site.name}\n${shareUrl}`;
const whatsappShare = `https://wa.me/?text=${encodeURIComponent(shareText)}`;
---

<BaseLayout locale={locale} title={title} description={description} board>
  <article class="exercise-page">
    {/* ⚠️ THE PARENT, NAMED. See the note in TrapPage — the end-of-page link
        keeps the collection wording because it is a way onward, not up. */}
    <Trail locale={locale} href={exercisesPath(locale)} label={t('nav.exercises')} />

    <header class="exercise-header">
      <h1>{title}</h1>
      <div class="exercise-meta">
        <LevelBadge locale={locale} level={data.level} />
      </div>
      {
        data.themes.length > 0 && (
          <>
            <h2 class="exercise-themes-heading">{t('traps.themes')}</h2>
            <ul class="chip-list">
              {data.themes.map((theme) => (
                <li class="chip">{theme}</li>
              ))}
            </ul>
          </>
        )
      }
    </header>

    <ExerciseBoard
      locale={locale}
      slug={data.slug}
      fen={data.fen}
      solution={data.solution}
      opponentReplies={data.opponentReplies}
      onlyMove={data.onlyMove}
      hint={hint}
    />

    {/* The way out, at the end as well as at the top — see the note in
        TrapPage.astro. Same key as the link above it, so the two can never
        come to call the same destination by two names. */}
    <footer class="exercise-footer">
      <a class="share" href={whatsappShare} rel="noopener noreferrer" target="_blank">
        {t('exercises.share')}
      </a>
      <a
        class="exercise-footer-back"
        href={exercisesPath(locale)}
        data-testid="exercise-back-bottom"
      >
        ← {t('exercises.backToIndex')}
      </a>
    </footer>

    {/* ── Prev / next ───────────────────────────────────────────────────────
        ⚠️ WITHOUT THIS, FINISHING AN EXERCISE MEANT GOING BACK TO THE INDEX AND
        PICKING AGAIN. Every other sequence on the site — lessons, tutorial
        steps — carries a pager, and the exercises are the one place a student
        does several in a row, which is exactly where the friction compounds.

        ⚠️ IT NAMES THE DESTINATION, NEVER JUST "SUIVANT". Same rule as the
        lesson pager and the trail (Critical Feature 62): a control that does
        not say where it goes is a guess, and "next" on a list of 27 is a
        particularly unhelpful one. The direction word is the small grey line;
        the title is the link.

        ⚠️ AND IT IS NOT THE WAY UP (Critical Feature 64). The trail at the top
        and the "back to the index" link above still exist and still mean
        something different — stepping sideways in a sequence is not leaving
        it. Both survive. */}
    {
      (prev || next) && (
        <nav class="exercise-nav" aria-label={t('nav.exercises')}>
          <div class="exercise-nav-row">
            {prev ? (
              <a
                class="exercise-nav-link"
                href={localizePath(`/exercices/${prev.data.slug}/`, locale)}
                rel="prev"
                data-testid="exercise-prev"
              >
                <span class="exercise-nav-dir">← {t('tutorial.prev')}</span>
                <span class="exercise-nav-title">
                  {locale === 'fr' ? prev.data.title_fr : prev.data.title_en}
                </span>
              </a>
            ) : (
              /* ⚠️ AN EMPTY CELL, NOT A COLLAPSED GRID. Without it "next" jumps
                 to the left on the first exercise, and the pager appears to
                 move between pages. */
              <span />
            )}
            {next && (
              <a
                class="exercise-nav-link exercise-nav-next"
                href={localizePath(`/exercices/${next.data.slug}/`, locale)}
                rel="next"
                data-testid="exercise-next"
              >
                <span class="exercise-nav-dir">{t('tutorial.next')} →</span>
                <span class="exercise-nav-title">
                  {locale === 'fr' ? next.data.title_fr : next.data.title_en}
                </span>
              </a>
            )}
          </div>
        </nav>
      )
    }
  </article>

  {/* E3 — the board islands call `refreshScore()` after a solve or a win, and
      this is what publishes the function and owns the achievement toast. A page
      with a judged board and no resolver still works: `src/lib/score.ts`
      returns null and the board simply shows no award. */}
  <ScoreResolver locale={locale} />
</BaseLayout>

<style>
  .exercise-back {
    margin-bottom: 1.5rem;
    font-size: 0.9375rem;
  }

  .exercise-header {
    margin-bottom: 2rem;
  }

  .exercise-header h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.9rem, 5vw, 2.75rem);
    line-height: 1.1;
  }

  .exercise-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .exercise-themes-heading {
    margin: 1.5rem 0 0.5rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mcc-text-secondary);
  }

  /* ⚠️ `.chip` and the row that holds it live in src/styles/cards.css (M3).
     They were spelled here, in TrapPage and in CardGrid — three copies, two
     different paddings. Use `class="chip-list"` on the <ul> and `class="chip"`
     on each item; nothing chip-shaped belongs in a scoped block. */

  .exercise-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--mcc-border-subtle);
  }

  .exercise-footer-back {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--mcc-link);
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .share {
    padding: 0.7rem 1.4rem;
    background-color: var(--mcc-primary);
    color: var(--mcc-primary-contrast);
    border-radius: var(--radius-card);
    font-weight: 500;
    text-decoration: none;
  }

  .share:hover {
    background-color: var(--mcc-primary-hover);
  }

  /* ⚠️ THE SAME SHAPE AS THE LESSON PAGER, spelled again rather than shared.
     Two sequences that looked different would read as two different kinds of
     control, and the lesson pager's CSS is scoped to its own component. If a
     third sequence ever appears, that is the moment to extract one — not
     before, on the same reasoning as the three hub grids. */
  .exercise-nav {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--mcc-border-subtle);
  }

  .exercise-nav-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .exercise-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    /* ≥48px on a phone: this is a primary control at the end of a page a
       student reaches with a thumb. */
    min-block-size: 48px;
    justify-content: center;
    padding: 0.75rem 1rem;
    border: 1px solid var(--mcc-border-subtle);
    border-radius: var(--radius-card);
    background-color: var(--mcc-surface-raised);
    color: var(--mcc-link);
    text-decoration: none;
  }

  .exercise-nav-link:hover {
    border-color: var(--mcc-border-strong);
  }

  .exercise-nav-next {
    text-align: right;
  }

  .exercise-nav-dir {
    color: var(--mcc-text-secondary);
    font-size: 0.8125rem;
  }

  .exercise-nav-title {
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
