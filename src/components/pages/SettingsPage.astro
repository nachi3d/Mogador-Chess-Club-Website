---
/**
 * `/parametres/` — appearance settings, in both locales.
 *
 * ── THE THREE LEVELS (E6) ──────────────────────────────────────────────────
 * Decreasing prominence, and the ordering IS the design:
 *
 *   1. Thème         four coherent moods. One decision, taken by almost
 *                    everyone who ever opens this page.
 *   2. Apparence     clair / sombre / système — WITHIN the active theme.
 *                    "Bois de jour" and "Bois de nuit", not a second axis.
 *   3. Personnaliser a single collapsed disclosure holding the board presets
 *                    and the reader's own two colours.
 *
 * ⚠️ NEVER FLATTEN THIS INTO 4 THEMES × 6 PRESETS. Twenty-four equivalent
 * swatches is not more choice, it is the same choice made unusable. Each theme
 * names its own board, and a reader who wants a different one has to ask.
 *
 * ⚠️ LEVELS 2 AND 3 SHARE ONE DISCLOSURE, not two side by side. The hierarchy
 * is about how many decisions are visible at once; two collapsed panels is two
 * decisions again.
 *
 * ── NOT AN ISLAND, on purpose ──────────────────────────────────────────────
 * CLAUDE.md: the board is the only hydrated component on the site. This page
 * is native form controls — radios, a `<details>` and two `<input type=color>`
 * — wired up by a plain `<script>`, exactly as the solved-ticks on
 * `/exercices/` are. Everything is server-rendered and labelled before the
 * script runs, so the page is readable (if inert) without JS.
 *
 * ── The previews are the real thing ────────────────────────────────────────
 * Each theme tile carries `.theme-preview .theme-<id>` and each preset tile
 * carries `.board-<id>` — the SAME classes the theme script puts on `<html>`.
 * The swatch a reader picks from is painted by the rule that will paint their
 * site. No second copy of any colour, anywhere.
 */
import type { Locale } from '@config/site';
import { BOARD_THEMES, boardThemeClass } from '@config/board-themes';
import { SITE_THEMES } from '@config/site-themes';
import { useTranslations } from '@i18n/ui';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/PageIntro.astro';
import MiniBoard from '@components/MiniBoard.astro';
import ThemePreview from '@components/ThemePreview.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const MODES = [
  { id: 'light', label: t('settings.mode.light') },
  { id: 'dark', label: t('settings.mode.dark') },
  { id: 'system', label: t('settings.mode.system') },
] as const;

/** The theme's initial, set in its own heading face. See ThemePreview. */
const GLYPHS: Record<string, string> = {
  bois: 'B',
  marbre: 'M',
  souiri: 'S',
  terminal: 'T',
};

/** The sentinel for "no pin" in the preset radio group. Not a preset id. */
const FOLLOW = 'follow';
---

<BaseLayout
  locale={locale}
  title={t('settings.title')}
  description={t('settings.intro')}
  piecePreviews
>
  <PageIntro title={t('settings.title')} intro={t('settings.intro')} />

  <noscript>
    <p class="settings-noscript">{t('settings.noJs')}</p>
  </noscript>

  <div class="settings">
    {/* ── LEVEL 1 — Thème ──────────────────────────────────────────────── */}
    <section>
      <fieldset class="settings-fieldset">
        <legend>{t('theme.heading')}</legend>
        <p class="settings-hint">{t('theme.hint')}</p>
        <div class="settings-themes">
          {
            SITE_THEMES.map((theme) => (
              <label class="settings-theme">
                <input type="radio" name="mcc-theme" value={theme.id} data-theme-input />
                <span class="settings-theme-inner">
                  <ThemePreview theme={theme.id} glyph={GLYPHS[theme.id] ?? '?'} />
                  <span class="settings-theme-name">{t(theme.labelKey)}</span>
                  <span class="settings-theme-hint">{t(theme.hintKey)}</span>
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>
    </section>

    {/* ── LEVEL 2 — light / dark, INSIDE the theme ─────────────────────── */}
    <section>
      <fieldset class="settings-fieldset">
        <legend>{t('settings.mode.heading')}</legend>
        <div class="settings-options">
          {
            MODES.map((mode) => (
              <label class="settings-option">
                <input type="radio" name="mcc-mode" value={mode.id} data-mode-input />
                <span>{mode.label}</span>
              </label>
            ))
          }
        </div>
        <p class="settings-hint">{t('settings.mode.systemHint')}</p>
      </fieldset>
    </section>

    {/* ── SOUND (E2) ───────────────────────────────────────────────────────
        ⚠️ OFF BY DEFAULT, and the markup says so before any script runs: the
        checkbox is rendered UNCHECKED on the server and only ticked by the
        script if the stored record says so. A reader with no JavaScript, or
        one whose storage throws, therefore sees the true state — silent —
        rather than a control that claims something the site is not doing.

        Top level rather than inside "Personnaliser": sound is not a refinement
        of the board, it is a different sense, and it is the one preference here
        a reader may specifically have come to switch off. */}
    <section>
      <fieldset class="settings-fieldset">
        <legend>{t('settings.sound.heading')}</legend>
        <label class="settings-switch">
          <input type="checkbox" data-sound-toggle />
          <span>{t('settings.sound.toggle')}</span>
        </label>
        <p class="settings-hint">{t('settings.sound.hint')}</p>

        {/* Three steps, not a slider. Disabled while sound is off — a volume
            control that changes nothing audible is a control that lies. */}
        <div class="settings-volume" data-sound-volume-group>
          <span class="settings-volume-label" id="mcc-volume-label">
            {t('settings.sound.volume')}
          </span>
          <div class="settings-options" role="group" aria-labelledby="mcc-volume-label">
            {
              (['doux', 'moyen', 'fort'] as const).map((step) => (
                <label class="settings-option">
                  <input type="radio" name="mcc-volume" value={step} data-volume-input disabled />
                  <span>{t(`settings.sound.volume.${step}`)}</span>
                </label>
              ))
            }
          </div>
        </div>
      </fieldset>
    </section>

    {/* ── LEVEL 3 — one disclosure, two sections ──────────────────────────
        `<details>` rather than a scripted panel: it discloses without JS, it
        is keyboard-operable and correctly announced by every screen reader
        with no ARIA at all, and it cannot get out of step with its own
        state. The script only ever OPENS it — when the reader already has a
        pinned board or custom colours, so a setting they are using is never
        hidden behind a closed summary. */}
    <details class="settings-advanced" data-advanced>
      <summary>
        <span class="settings-advanced-title">{t('settings.advanced.heading')}</span>
        <span class="settings-advanced-hint">{t('settings.advanced.hint')}</span>
      </summary>

      <div class="settings-advanced-body">
        {/* Board presets */}
        <fieldset class="settings-fieldset">
          <legend>{t('settings.board.heading')}</legend>
          <p class="settings-hint">{t('settings.board.hint')}</p>

          {/* The un-pin option, FIRST and named, because following the theme
              is the default state and has to be reachable, not just losable. */}
          <label class="settings-option settings-follow">
            <input type="radio" name="mcc-board" value={FOLLOW} data-board-input />
            <span>
              <span class="settings-follow-name">{t('settings.board.follow')}</span>
              <span class="settings-hint settings-follow-hint">{t('settings.board.followHint')}</span>
            </span>
          </label>

          <div class="settings-boards">
            {
              BOARD_THEMES.map((theme) => (
                <label class="settings-board" data-board-label={theme.id}>
                  <input type="radio" name="mcc-board" value={theme.id} data-board-input />
                  <span class="settings-board-inner">
                    {/* The preset's own class — the swatch IS the board. */}
                    <MiniBoard class={boardThemeClass(theme.id)} />
                    <span class="settings-board-name">{t(theme.labelKey)}</span>
                  </span>
                </label>
              ))
            }
          </div>

          {/* Shown only while a preset is pinned: it explains the one thing
              about this control that is not obvious — that it now outranks
              the theme. Reserved in the DOM so revealing it shifts nothing. */}
          <p class="settings-pinned" data-board-pinned hidden>{t('settings.board.pinned')}</p>
        </fieldset>

        {/* Custom colours */}
        <fieldset class="settings-fieldset">
          <legend>{t('settings.custom.heading')}</legend>
          <p class="settings-hint">{t('settings.custom.hint')}</p>

          <div class="settings-custom">
            <div class="settings-pickers">
              <label class="settings-picker">
                <span>{t('settings.custom.light')}</span>
                <input type="color" value="#e8dcbe" data-custom-light />
              </label>
              <label class="settings-picker">
                <span>{t('settings.custom.dark')}</span>
                <input type="color" value="#4f7053" data-custom-dark />
              </label>
            </div>

            {/* Live preview of the reader's own pair, painted from inline
                properties the script sets — the same mechanism as the real board. */}
            <MiniBoard class="settings-custom-preview" testid="custom-preview" />
          </div>

          {/* Live contrast readout. Numbers, not just a verdict: someone nudging
              a colour can see which direction helps. */}
          <p class="settings-contrast" data-contrast-readout>
            <span>{t('settings.custom.contrast')}</span>
            <span class="settings-ratio" data-ratio-light>—</span>
            <span class="settings-ratio" data-ratio-dark>—</span>
          </p>

          {/* Always in the DOM, empty when fine: an inserted `role="alert"`
              announces unreliably, and a reserved line stops the buttons jumping. */}
          <div class="settings-warning" role="alert" data-contrast-warning hidden>
            <strong>{t('settings.warning.low')}</strong>
            <span>{t('settings.warning.detail')}</span>
          </div>

          <div class="settings-actions">
            <button type="button" class="settings-button is-primary" data-custom-apply>
              {t('settings.custom.apply')}
            </button>
            <button type="button" class="settings-button" data-custom-reset>
              {t('settings.custom.reset')}
            </button>
          </div>
        </fieldset>
      </div>
    </details>
  </div>

  {/* Polite: a setting applying is a confirmation, not an interruption.
      The confirmation TEXT rides on a data attribute so the script stays free
      of hardcoded FR/EN — every user-facing string goes through the i18n
      layer, including the ones only JavaScript ever shows. */}
  <p
    class="sr-only"
    role="status"
    aria-live="polite"
    data-settings-status
    data-saved={t('settings.saved')}
    data-sound-on={t('settings.sound.on')}
    data-sound-off={t('settings.sound.off')}
  >
  </p>
</BaseLayout>

<script>
  import {
    AA_TEXT,
    applyTheme,
    bestInkFor,
    clearCustomBoard,
    followThemeBoard,
    normaliseHex,
    readTheme,
    resolveMode,
    writeTheme,
    type ThemeMode,
  } from '@lib/theme';
  import { isBoardThemeId } from '@config/board-themes';
  import { isSiteThemeId } from '@config/site-themes';
  /* ⚠️ Sound is read and written ONLY through this module — it owns the key
     `mcc:sound:v1` and every parameter. See src/lib/sound.ts. */
  import { isSoundVolume, play, readSound, writeSound } from '@lib/sound';

  const root = document.documentElement;
  const status = document.querySelector<HTMLElement>('[data-settings-status]');
  /** Supplied by the server so no user-facing string is written in JS. */
  const SAVED = status?.dataset['saved'] ?? '';
  /** Matches the FOLLOW sentinel in the markup above. Not a preset id. */
  const FOLLOW = 'follow';

  /** Announce politely. The visual change is its own feedback for most readers. */
  const announce = () => {
    if (status) status.textContent = SAVED;
  };

  const themeInputs = [...document.querySelectorAll<HTMLInputElement>('[data-theme-input]')];
  const modeInputs = [...document.querySelectorAll<HTMLInputElement>('[data-mode-input]')];
  const boardInputs = [...document.querySelectorAll<HTMLInputElement>('[data-board-input]')];
  const previews = [...document.querySelectorAll<HTMLElement>('[data-theme-preview]')];
  const advanced = document.querySelector<HTMLDetailsElement>('[data-advanced]');
  const pinnedNote = document.querySelector<HTMLElement>('[data-board-pinned]');
  const lightPicker = document.querySelector<HTMLInputElement>('[data-custom-light]');
  const darkPicker = document.querySelector<HTMLInputElement>('[data-custom-dark]');
  const preview = document.querySelector<HTMLElement>('[data-testid="custom-preview"]');
  const ratioLight = document.querySelector<HTMLElement>('[data-ratio-light]');
  const ratioDark = document.querySelector<HTMLElement>('[data-ratio-dark]');
  const warning = document.querySelector<HTMLElement>('[data-contrast-warning]');
  const applyButton = document.querySelector<HTMLButtonElement>('[data-custom-apply]');
  const resetButton = document.querySelector<HTMLButtonElement>('[data-custom-reset]');

  /**
   * Show every theme tile in the reader's CURRENT light/dark mode.
   *
   * The tiles are painted by `site-themes.css`, whose mode blocks key on
   * `[data-theme]` — an attribute that only exists on `<html>` until we put it
   * here. Without this, all four tiles would render light while the site is
   * dark, and the picker would be advertising something it will not deliver.
   */
  function syncPreviewMode(mode: 'light' | 'dark') {
    for (const tile of previews) tile.dataset['theme'] = mode;
  }

  /** Reflect a stored state into every control on the page. */
  function syncControls(state: ReturnType<typeof readTheme>) {
    for (const input of themeInputs) input.checked = input.value === state.theme;
    for (const input of modeInputs) input.checked = input.value === state.mode;

    /* Absent `boardTheme` means "follow the theme" — a real state, not a
       missing value. See src/lib/theme.ts. */
    const selected = state.boardTheme ?? FOLLOW;
    for (const input of boardInputs) input.checked = input.value === selected;
    if (pinnedNote) pinnedNote.hidden = !state.boardTheme;

    syncPreviewMode(resolveMode(state.mode));
  }

  /** Paint the reader's candidate pair onto the little preview board. */
  function paintPreview(light: string, dark: string) {
    if (!preview) return;
    preview.style.setProperty('--mcc-board-light', light);
    preview.style.setProperty('--mcc-board-dark', dark);
    preview.style.setProperty('--mcc-board-light-ink', bestInkFor(light).ink);
    preview.style.setProperty('--mcc-board-dark-ink', bestInkFor(dark).ink);
  }

  /**
   * Show the ratio for each square, and warn below AA.
   *
   * The reader is NOT blocked — it is their board. The warning simply stays
   * while the colours are in use, so an unreadable board is a choice rather
   * than an accident.
   */
  function updateContrast(light: string, dark: string) {
    const lightInk = bestInkFor(light);
    const darkInk = bestInkFor(dark);
    if (ratioLight) ratioLight.textContent = `${lightInk.ratio.toFixed(1)}:1`;
    if (ratioDark) ratioDark.textContent = `${darkInk.ratio.toFixed(1)}:1`;

    const poor = lightInk.ratio < AA_TEXT || darkInk.ratio < AA_TEXT;
    ratioLight?.toggleAttribute('data-low', lightInk.ratio < AA_TEXT);
    ratioDark?.toggleAttribute('data-low', darkInk.ratio < AA_TEXT);
    if (warning) warning.hidden = !poor;
    return poor;
  }

  function currentPickerPair(): { light: string; dark: string } {
    const light = normaliseHex(lightPicker?.value) ?? '#e8dcbe';
    const dark = normaliseHex(darkPicker?.value) ?? '#4f7053';
    return { light, dark };
  }

  function refreshPickers() {
    const { light, dark } = currentPickerPair();
    paintPreview(light, dark);
    updateContrast(light, dark);
  }

  /* ── Initial state, read once ─────────────────────────────────────────── */
  const initial = readTheme();
  syncControls(initial);

  if (initial.custom) {
    if (lightPicker) lightPicker.value = initial.custom.light;
    if (darkPicker) darkPicker.value = initial.custom.dark;
  }
  /* Open the disclosure when there is something inside it in force. A setting
     the reader is actively using must not be hidden behind a closed summary —
     they would have no way to discover why their board ignores the theme. */
  if (advanced && (initial.boardTheme || initial.custom)) advanced.open = true;

  refreshPickers();

  /* ── Wiring ───────────────────────────────────────────────────────────── */
  for (const input of themeInputs) {
    input.addEventListener('change', () => {
      if (!input.checked || !isSiteThemeId(input.value)) return;
      /* The theme changes the board and the pieces too — unless the reader has
         pinned a preset, which survives deliberately. `applyTheme` resolves
         all of that; nothing here needs to know the rules. */
      const next = writeTheme({ theme: input.value });
      applyTheme(next, root);
      syncControls(next);
      announce();
    });
  }

  for (const input of modeInputs) {
    input.addEventListener('change', () => {
      if (!input.checked) return;
      const next = writeTheme({ mode: input.value as ThemeMode });
      applyTheme(next, root);
      /* The tiles must follow the mode they are previewing in. */
      syncPreviewMode(resolveMode(next.mode));
      announce();
    });
  }

  for (const input of boardInputs) {
    input.addEventListener('change', () => {
      if (!input.checked) return;

      if (input.value === FOLLOW) {
        /* Un-pin. Custom colours go with it: they are a pin too, just a
           hand-mixed one, and leaving them on top of "follow the theme" would
           make every tile in this grid look broken while appearing correct. */
        const next = followThemeBoard();
        applyTheme(next, root);
        syncControls(next);
        announce();
        return;
      }

      if (!isBoardThemeId(input.value)) return;
      /* Choosing a preset DROPS the custom colours, for the same reason. */
      writeTheme({ boardTheme: input.value });
      const next = clearCustomBoard();
      applyTheme(next, root);
      syncControls(next);
      announce();
    });
  }

  for (const picker of [lightPicker, darkPicker]) {
    picker?.addEventListener('input', refreshPickers);
  }

  applyButton?.addEventListener('click', () => {
    const { light, dark } = currentPickerPair();
    applyTheme(writeTheme({ custom: { light, dark } }), root);
    updateContrast(light, dark);
    announce();
  });

  resetButton?.addEventListener('click', () => {
    const next = clearCustomBoard();
    applyTheme(next, root);
    syncControls(next);
    refreshPickers();
    announce();
  });

  /* `system` follows the OS live. The tiles have to follow it too, or a reader
     whose phone flips to dark at sunset is left with four light previews on a
     dark page. Guarded: older Safari has no addEventListener here. */
  try {
    globalThis.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      const state = readTheme();
      if (state.mode === 'system') syncPreviewMode(resolveMode(state.mode));
    });
  } catch {
    /* the previews are simply not live on that browser; everything else works */
  }

  /* ── SOUND (E2) ──────────────────────────────────────────────────────────
     ⚠️ The markup ships UNCHECKED and the volume radios ship DISABLED, so the
     off-by-default state is true before this script runs and stays true if it
     never does. Everything below only ever moves the controls TOWARDS what is
     stored. */
  const soundToggle = document.querySelector<HTMLInputElement>('[data-sound-toggle]');
  const volumeInputs = [...document.querySelectorAll<HTMLInputElement>('[data-volume-input]')];
  const SOUND_ON = status?.dataset['soundOn'] ?? '';
  const SOUND_OFF = status?.dataset['soundOff'] ?? '';

  if (soundToggle) {
    const sound = readSound();
    soundToggle.checked = sound.enabled;
    for (const input of volumeInputs) {
      input.checked = input.value === sound.volume;
      input.disabled = !sound.enabled;
    }

    soundToggle.addEventListener('change', () => {
      const next = writeSound({ enabled: soundToggle.checked });
      for (const input of volumeInputs) input.disabled = !next.enabled;
      if (status) status.textContent = next.enabled ? SOUND_ON : SOUND_OFF;
      /* Turning it ON is itself a gesture, so the reader hears what they just
         asked for instead of having to go and find an exercise. Turning it off
         is silent, which is the whole point of turning it off. */
      if (next.enabled) play('place');
    });

    for (const input of volumeInputs) {
      input.addEventListener('change', () => {
        if (!input.checked || !isSoundVolume(input.value)) return;
        writeSound({ volume: input.value });
        announce();
        /* A volume you cannot hear while setting it is a volume you set twice. */
        play('place');
      });
    }
  }
</script>

<style>
  .settings {
    display: grid;
    gap: 2rem;
    max-width: 44rem;
  }

  .settings-noscript {
    max-width: 44rem;
    margin-bottom: 1.5rem;
    padding: 0.9rem 1rem;
    background-color: var(--mcc-surface-sunken);
    border-inline-start: 3px solid var(--mcc-accent);
    border-radius: var(--radius-card);
    font-size: 0.9375rem;
  }

  .settings-fieldset {
    margin: 0;
    padding: 1.1rem 1.2rem 1.3rem;
    background-color: var(--mcc-surface-raised);
    border: 1px solid var(--mcc-border-subtle);
    border-radius: var(--radius-card);
  }

  .settings-fieldset legend {
    padding-inline: 0.4rem;
    color: var(--mcc-text-secondary);
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .settings-hint {
    margin: 0.35rem 0 0.9rem;
    color: var(--mcc-text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .settings-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  /* ── Sound (E2) ── A plain checkbox, not a bespoke switch widget: a native
     control is announced correctly, keyboard-operable and 44px without any
     help, and this is a preference page rather than a place to be clever. */
  .settings-switch {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    cursor: pointer;
  }

  .settings-switch input {
    inline-size: 1.15rem;
    block-size: 1.15rem;
    accent-color: var(--mcc-primary);
    cursor: pointer;
  }

  .settings-volume {
    margin-block-start: 1rem;
  }

  .settings-volume-label {
    display: block;
    margin-block-end: 0.5rem;
    font-size: 0.9375rem;
    color: var(--mcc-text-secondary);
  }

  /* Disabled while sound is off — present rather than hidden, so the choice is
     visible and the section does not change height when sound is switched on.
     ⚠️ NO `opacity` ON THE TEXT. Dimming a label is the documented way to drop
     an audited pair below AA without any check noticing (CLAUDE.md — it cost a
     Lighthouse regression the whole Playwright suite passed). The native
     disabled radio already reads as disabled; the cursor confirms it. */
  .settings-option:has(input:disabled) {
    cursor: default;
  }

  .settings-option {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    cursor: pointer;
    font-size: 0.9375rem;
  }

  .settings-option input,
  .settings-board input {
    width: 1.15rem;
    height: 1.15rem;
    accent-color: var(--mcc-primary);
    cursor: pointer;
  }

  /* ---------- Level 1: the theme grid ---------- */
  .settings-themes {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
  }

  .settings-theme {
    cursor: pointer;
  }

  .settings-theme-inner {
    display: grid;
    gap: 0.35rem;
    padding: 0.55rem;
    border: 1px solid var(--mcc-border-subtle);
    border-radius: var(--radius-card);
  }

  /* Not colour alone — the chosen tile also gains a ring, so the selection is
     visible to someone who cannot distinguish the accent from the border. */
  .settings-theme input:checked + .settings-theme-inner {
    border-color: var(--mcc-accent);
    box-shadow: 0 0 0 2px var(--mcc-accent);
  }

  .settings-theme input,
  .settings-board input {
    /* Visually hidden but focusable, so the tile is the target and the ring
       below shows where focus is. */
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .settings-theme input:focus-visible + .settings-theme-inner,
  .settings-board input:focus-visible + .settings-board-inner {
    outline: 2px solid var(--mcc-focus-ring);
    outline-offset: 3px;
  }

  .settings-theme-name {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .settings-theme-hint {
    color: var(--mcc-text-secondary);
    font-size: 0.8125rem;
