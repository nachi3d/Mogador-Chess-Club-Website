---
/**
 * /connexion — email magic link, plus Google when it is configured.
 *
 * ⚠️ STILL NO PASSWORDS, AND THAT WAS RE-EXAMINED RATHER THAN INHERITED.
 * "Identifier + password" was raised as a way in for people without an email
 * address and was rejected again, on three grounds: Supabase's password grant
 * only accepts an email or a phone, so a username needs a synthetic
 * unroutable address; that address then feeds the placeholder-name rule
 * (Critical Feature 53), which derives a child's name from the email local
 * part and would put it on the attendance sheet; and an account whose only
 * credential is a password, with no address to send a reset to, cannot be
 * recovered by anyone — in a volunteer club with no support desk, for users
 * who are children. The no-email case belongs to prof-created accounts, and
 * the autonomous teenager is already served by graduation (CF41). See BACKLOG.
 *
 * So there is no reset flow, no strength meter and no credential to leak.
 *
 * ⚠️ NOT AN ISLAND. The one-hydrated-component rule still holds — the board is
 * the only Preact island on the site. This is a plain form plus a module script,
 * which is also what keeps `@supabase/supabase-js` out of every other page's
 * chunk graph.
 */
import type { Locale } from '@config/site';
import { GOOGLE_AUTH_ENABLED } from '@config/auth';
import { localizePath } from '@i18n/paths';
import { useTranslations } from '@i18n/ui';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/PageIntro.astro';
import Trail from '@components/nav/Trail.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={t('login.title')} description={t('login.intro')}>
  <Trail locale={locale} href={localizePath('/moi/', locale)} label={t('me.title')} />
  <PageIntro title={t('login.title')} intro={t('login.intro')} />

  <div class="auth-card">
    {/* ⚠️ BEHIND ITS OWN FLAG, AND ABSENT RATHER THAN DISABLED WHEN IT IS OFF.
        Google sign-in needs the provider configured in Supabase and an OAuth
        client in Google Cloud; neither lives in this repository, so nothing
        here can check them. A button that is present and fails on press is the
        defect Critical Feature 76 exists for — and unlike a hydration race
        this one would never resolve on its own, so DISABLED would be a lie
        too. It is not rendered at all until the configuration exists.
        See GOOGLE_AUTH_ENABLED in src/config/auth.ts. */}
    {
      GOOGLE_AUTH_ENABLED && (
        <>
          <button
            type="button"
            class="btn-block google-button"
            data-testid="login-google"
            data-msg-error={t('login.googleError')}
            data-callback-path="/auth/callback"
          >
            {/* Google's mark, inline: no request, and it inherits nothing —
                the four brand colours are fixed by their guidelines and are
                the one place on this site a colour is not a token. */}
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
              <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62z" />
              <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z" />
              <path fill="#FBBC05" d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33z" />
              <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.9 11.43 0 9 0A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z" />
            </svg>
            <span>{t('login.google')}</span>
          </button>

          {/* ⚠️⚠️ THE ONE LINE THAT PREVENTS A SILENT SECOND ACCOUNT.
              Automatic linking keys on the EMAIL ADDRESS: Supabase attaches a
              Google identity to an existing user only when the address matches
              and is confirmed. A reader who signed up as one address and
              presses this while signed into a different Google account gets a
              NEW auth user, a NEW child profile, and a ledger of zero — with
              their real progress intact and invisible on an account they cannot
              see from where they are standing.

              ⚠️ IT LOOKS LIKE DATA LOSS AND IT IS NOT, which is the worst
              combination: nothing errors, nothing is broken, and the reader has
              no way to tell what happened. Here that progress is a child's —
              points, rank and attendance earned over weeks.

              ⚠️ BEFORE THE PRESS, NOT AFTER. A message shown once the fork has
              happened is an explanation; this is a prevention, and it is the
              cheap half of the fix. The detection and manual-linking options
              are in BACKLOG and are not a reason to withhold this line. */}
          <p class="google-note" data-testid="login-google-note">
            {t('login.googleSameAddress')}
          </p>

          {/* ⚠️ A REAL SEPARATOR, NOT A HEADING. Two ways in need to read as
              alternatives; stacked flush they read as steps. */}
          <p class="auth-or" data-testid="login-or"><span>{t('login.or')}</span></p>
        </>
      )
    }

    {/* Translated strings ride on the element rather than through a global or
        `define:vars`: a bundled module script cannot take `define:vars`, and an
        `is:inline` one cannot `import` a bare specifier. Data attributes are
        the seam that lets the i18n layer stay server-side and the logic stay
        bundled. */}
    <form
      id="login-form"
      data-testid="login-form"
      novalidate
      data-msg-sending={t('login.sending')}
      data-msg-submit={t('login.submit')}
      data-msg-error={t('login.error')}
      data-msg-invalid={t('login.invalidEmail')}
      data-msg-unconfigured={t('login.unconfigured')}
      data-msg-retry={t('login.retry')}
      data-callback-path="/auth/callback"
    >
      <label for="login-email">{t('login.emailLabel')}</label>
      <input
        id="login-email"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        required
        data-testid="login-email"
      />

      {/* ── The honeypot ───────────────────────────────────────────────────
          ⚠️⚠️ THIS IS NOT SECURITY, AND NOTHING HERE MAY BE TREATED AS SUCH.

          The anon key ships to every browser by design, so anyone who wants an
          account can POST to Supabase's `/auth/v1/otp` endpoint and never load
          this page at all. Any check written into this form is bypassed by not
          using the form. What this buys is the cheap half: the naive scrapers
          that fill every input they find stop creating rows. That is noise
          reduction, and calling it anything more would be the same mistake as
          treating `isStaff()` as a gate.

          The real answers to junk sign-ups are elsewhere and are named in
          CLAUDE.md: Supabase's own per-address and per-IP rate limits, and
          `/admin/comptes/`, where an admin can SEE the sign-ups and remove one.

          ⚠️ IT FAILS VISIBLY AND RECOVERABLY — NEVER AS A FAKE SUCCESS. The
          usual honeypot advice is to pretend the send worked, which denies the
          bot its signal. It also means a parent whose password manager filled
          this field waits forever for an email that was never sent, with the
          page cheerfully telling them to check their inbox. On this site that
          trade goes the other way: show the error, CLEAR the field, and let the
          second press through. A bot loops; a human presses twice.

          ⚠️ HIDDEN FOR EVERYONE, INCLUDING ASSISTIVE TECH. `aria-hidden` plus
          `tabindex="-1"` keeps it out of the accessibility tree and out of the
          tab order, so it is not a mystery field a screen-reader user must
          skip. Positioned off-screen rather than `display: none`, because the
          scrapers worth catching skip what is explicitly not displayed. */}
      <div class="auth-hp" aria-hidden="true">
        <label for="login-website">{t('login.hpLabel')}</label>
        <input
          id="login-website"
          name="website"
          type="text"
          tabindex="-1"
          autocomplete="off"
          data-testid="login-hp"
        />
      </div>

      <button type="submit" class="btn-primary" data-testid="login-submit">
        {t('login.submit')}
      </button>

      {/* role="alert" so a screen reader hears the failure without hunting. */}
      <p class="auth-error" role="alert" data-testid="login-error" hidden></p>
    </form>

    {/* Rendered server-side and revealed on success rather than injected, so the
        success copy is real translated markup and not a string built in JS. */}
    <div class="auth-sent" data-testid="login-sent" hidden>
      <h2>{t('login.sent.title')}</h2>
      <p>{t('login.sent.body')}</p>
    </div>

    <p class="auth-guest">
      <a href={localizePath('/', locale)}>{t('login.guestNote')}</a>
    </p>
  </div>

  <script>
    /**
     * A bundled module, not inline: it needs the Supabase client, which is
     * itself reached with `await import()` so the ~30 KB only lands when
     * somebody actually submits the form — not merely by opening this page.
     */
    const form = document.getElementById('login-form') as HTMLFormElement | null;
    const email = document.querySelector('[data-testid="login-email"]') as HTMLInputElement | null;
    const submit = document.querySelector('[data-testid="login-submit"]') as HTMLButtonElement | null;
    const errorEl = document.querySelector('[data-testid="login-error"]') as HTMLElement | null;
    const sentEl = document.querySelector('[data-testid="login-sent"]') as HTMLElement | null;

    const honeypot = document.querySelector('[data-testid="login-hp"]') as HTMLInputElement | null;

    const msg = {
      sending: form?.dataset.msgSending ?? '',
      submit: form?.dataset.msgSubmit ?? '',
      error: form?.dataset.msgError ?? '',
      invalid: form?.dataset.msgInvalid ?? '',
      unconfigured: form?.dataset.msgUnconfigured ?? '',
      retry: form?.dataset.msgRetry ?? '',
    };
    const callbackPath = form?.dataset.callbackPath ?? '/auth/callback';

    function showError(message: string) {
      if (!errorEl) return;
      errorEl.textContent = message;
      errorEl.hidden = false;
    }

    /**
     * ⚠️ GOOGLE: THE TAB LEAVES, SO NOTHING AFTER THE CALL IS A SUCCESS PATH.
     *
     * `signInWithGoogle` resolves only when the redirect could NOT be started;
     * on success the browser has already navigated away and this handler is
     * gone with the page. So the button is restored on failure only, and there
     * is deliberately no "signed in" branch here — the session arrives on the
     * next load, through `completeSignIn()` on /auth/callback.
     *
     * ⚠️ The button is only in the DOM when GOOGLE_AUTH_ENABLED is on, so this
     * whole block is inert rather than absent in the default build. That is
     * the cheap half of the flag; the load-bearing half is that no reader sees
     * a control that cannot work.
     */
    const google = document.querySelector('[data-testid="login-google"]') as HTMLButtonElement | null;

    google?.addEventListener('click', async () => {
      if (errorEl) errorEl.hidden = true;
      const label = google.textContent;
      google.disabled = true;

      try {
        const { isConfigured, signInWithGoogle } = await import('@lib/supabase');
        if (!isConfigured()) {
          showError(msg.unconfigured);
          return;
        }
        const redirectTo = new URL(
          google.dataset.callbackPath ?? '/auth/callback',
          window.location.origin,
        ).toString();

        /* Resolves ONLY on failure — see above. */
        const result = await signInWithGoogle(redirectTo);
        showError(google.dataset.msgError ?? msg.error);
        if (import.meta.env.DEV) console.error('[google sign-in]', result.message);
      } catch {
        showError(google.dataset.msgError ?? msg.error);
      } finally {
        /* Reached on every failure path, and never on the success one, because
           the tab is gone by then. */
        google.disabled = false;
        if (label !== null) google.textContent = label;
      }
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!email || !submit) return;
      if (errorEl) errorEl.hidden = true;

      /**
       * ⚠️ THE HONEYPOT, AND THE ONE BEHAVIOUR THAT MATTERS: IT CLEARS ITSELF.
       *
       * A filled hidden field means a scraper — or, rarely, a password manager
       * that ignored `autocomplete="off"`. Refusing once and emptying the field
       * makes the second press succeed for the human and changes nothing for
       * the bot, which will fill it again. Pretending the link was sent would
       * be kinder to the bot and cruel to the parent.
       */
      if (honeypot && honeypot.value !== '') {
        honeypot.value = '';
        showError(msg.retry);
        return;
      }

      const value = email.value.trim();
      /* Deliberately loose. The server is the real validator; this only catches
         the obvious typo before spending a round trip. */
      if (!value || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(value)) {
        showError(msg.invalid);
        email.focus();
        return;
      }

      submit.disabled = true;
      submit.textContent = msg.sending;

      try {
        const { isConfigured, signInWithMagicLink } = await import('@lib/supabase');
        if (!isConfigured()) {
          showError(msg.unconfigured);
          return;
        }
        const redirectTo = new URL(callbackPath, window.location.origin).toString();
        const result = await signInWithMagicLink(value, redirectTo);

        if (!result.ok) {
          showError(msg.error);
          return;
        }
        /* Replace the form with the confirmation. The address is not echoed
           back — it is already in the reader's own field, and echoing it into
           the page is one more place it can be shoulder-surfed. */
        form.hidden = true;
        if (sentEl) sentEl.hidden = false;
      } catch {
        showError(msg.error);
      } finally {
        submit.disabled = false;
        submit.textContent = msg.submit;
      }
    });
  </script>
</BaseLayout>

<style>
  .auth-card {
    max-width: 32rem;
    padding: 1.5rem;
    border: 1px solid var(--mcc-border-subtle);
    border-radius: var(--radius-card);
    background-color: var(--mcc-surface-raised);
  }

  label {
    display: block;
    margin-bottom: 0.35rem;
    font-weight: 500;
  }

  /* ⚠️ THE ONE PLACE A COLOUR IS NOT A TOKEN. Google's mark has fixed brand
     colours in its guidelines, and the surface it sits on is ours — so the
     BUTTON is themed and only the glyph is not. check-contrast.mjs audits
     token pairs and cannot see the SVG, which is why the label is a real text
     node in --mcc-text-primary rather than part of the artwork. */
  .google-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-block-size: 48px;
    padding: 0.7rem 1.1rem;
    background-color: var(--mcc-surface-raised);
    color: var(--mcc-text-primary);
    border: 1px solid var(--mcc-border-strong);
    border-radius: var(--radius-card);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
  }

  .google-button:hover:not(:disabled) {
    background-color: var(--mcc-surface-sunken);
  }

  .google-button:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .google-button:focus-visible {
    outline: 2px solid var(--mcc-focus-ring);
    outline-offset: 2px;
  }

  /* ⚠️ SECONDARY TEXT, NOT A WARNING BANNER. It has to be read before the
     press, but it is guidance rather than an error — styling it as an alert
     would make the ordinary path look dangerous, and a reader who is told
     everything is alarming stops reading any of it.
     ⚠️ NO `opacity` — --mcc-text-secondary is an audited token, and an alpha
     on top of it is invisible to check-contrast.mjs (the rule in CLAUDE.md
     that cost a Lighthouse regression the whole suite passed). */
  .google-note {
    margin: 0.5rem 0 0;
    color: var(--mcc-text-secondary);
    font-size: 0.8125rem;
    line-height: 1.5;
    max-inline-size: 42ch;
  }

  /* A rule with the word sitting in it, rather than a bare word above a form. */
  .auth-or {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1.1rem 0;
    color: var(--mcc-text-secondary);
    font-size: 0.8125rem;
  }

  .auth-or::before,
  .auth-or::after {
    content: '';
    flex: 1;
    block-size: 1px;
    background-color: var(--mcc-border-subtle);
  }

  input[type='email'] {
    width: 100%;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--mcc-border-strong);
    border-radius: var(--radius-card);
    background-color: var(--mcc-surface-page);
    color: var(--mcc-text-primary);
    font: inherit;
  }

  input[type='email']:focus-visible {
    outline: 2px solid var(--mcc-focus-ring);
    outline-offset: 1px;
  }

  /* Appearance lives in controls.css. Only the margin is this page’s. */
  .btn-primary {
    margin-top: 1rem;
  }

  /* ⚠️ OFF-SCREEN, NOT `display: none` AND NOT `visibility: hidden`. A scraper
     worth catching skips a field the page has explicitly hidden; one that is
     merely positioned away still looks like a field to fill. The element is
     already out of the accessibility tree and out of the tab order via
     `aria-hidden` and `tabindex="-1"` on the markup, so nothing here is what
     keeps it from a screen reader. */
  .auth-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .auth-error {
    margin: 0.75rem 0 0;
    color: var(--mcc-danger-text);
  }

  .auth-sent h2 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }

  .auth-sent p {
    margin: 0;
    color: var(--mcc-text-secondary);
  }

  .auth-guest {
    margin: 1.25rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--mcc-border-subtle);
  }

  .auth-guest a {
    color: var(--mcc-link);
  }
</style>
