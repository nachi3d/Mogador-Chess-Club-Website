---
/**
 * /connexion — TWO DOORS, AND THE PSEUDO IS THE FRONT ONE.
 *
 * ═════════════════════════════════════════════════════════════════════════
 * ⚠️ THE ORDER ON THIS PAGE IS THE DECISION (v0.18.0).
 *
 * The club teaches teenagers in Essaouira. Many of them have no active email
 * address at all; the ones who do read it on a shared family phone, where a
 * Supabase-branded "Confirm your signup" arrives next to nothing they
 * recognise and reads, correctly, as spam. A sign-in page whose only control
 * asks for an email address is a sign-in page that locks out the people the
 * site is for.
 *
 * So: pseudo + password first, full width, no disclosure in front of it.
 *
 * ⚠️ AND THE MAGIC LINK STAYS, BELOW, IN A `<details>`. It is not legacy and
 * must not be removed: it is the path that works for anyone with a real inbox,
 * and it is how Seàn and Michael sign in. Two first-class paths, one of which
 * is right for most of the readers of this page.
 *
 * ⚠️ THERE IS NO SELF-SERVICE PASSWORD RESET, AND THE PAGE SAYS SO OUT LOUD.
 * A reset link needs an inbox and an SMS code needs a budget and a provider
 * (rejected long ago — see CLAUDE.md). What the club has is a person: the
 * WhatsApp block below is the actual recovery mechanism, written as an
 * instruction rather than hidden as a footnote, because a fourteen-year-old who
 * cannot get in and is not told how will simply stop coming.
 *
 * ⚠️ NOT AN ISLAND. The board is still the only hydrated component on the site.
 * Two plain forms plus a module script, which is also what keeps
 * `@supabase/supabase-js` out of every other page's chunk graph.
 * ═════════════════════════════════════════════════════════════════════════
 */
import type { Locale } from '@config/site';
import { whatsappUrl } from '@config/site';
import { localizePath } from '@i18n/paths';
import { useTranslations } from '@i18n/ui';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/PageIntro.astro';
import Trail from '@components/nav/Trail.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={t('login.title')} description={t('login.intro')}>
  <Trail locale={locale} href={localizePath('/moi/', locale)} label={t('me.title')} />
  <PageIntro title={t('login.title')} intro={t('login.intro')} />

  <div class="auth-card">
    {/* ══ 1. THE PSEUDO PATH ═══════════════════════════════════════════════
        Translated strings ride on the element rather than through a global or
        `define:vars`: a bundled module script cannot take `define:vars`, and an
        `is:inline` one cannot `import` a bare specifier. */}
    <h2 class="auth-heading">{t('login.pseudo.heading')}</h2>
    <form
      id="pseudo-form"
      data-testid="pseudo-form"
      novalidate
      data-msg-signing={t('login.signingIn')}
      data-msg-submit={t('login.pseudoSubmit')}
      data-msg-bad={t('login.badCredentials')}
      data-msg-unconfigured={t('login.unconfigured')}
    >
      <label for="login-pseudo">{t('login.pseudoLabel')}</label>
      {/* ⚠️ `autocapitalize="none"` AND `autocorrect="off"`: a phone keyboard
          capitalises the first letter by default, and the pseudo is stored
          lowercase. The client lowercases it anyway — this is so the reader
          sees what they will actually be signed in as. */}
      <input
        id="login-pseudo"
        name="pseudo"
        type="text"
        autocomplete="username"
        autocapitalize="none"
        autocorrect="off"
        spellcheck="false"
        required
        data-testid="login-pseudo"
      />

      <label for="login-password">{t('login.passwordLabel')}</label>
      <input
        id="login-password"
        name="password"
        type="password"
        autocomplete="current-password"
        required
        data-testid="login-password"
      />
      {/* ⚠️ A CHECKBOX, NOT AN EYE ICON INSIDE THE FIELD. A 44px target with a
          real label beats a 20px glyph on the phone this is typed on, and a
          student who cannot see what they typed retypes the whole password. */}
      <p class="auth-reveal">
        <input type="checkbox" id="login-reveal" data-testid="login-reveal" />
        <label for="login-reveal">{t('login.showPassword')}</label>
      </p>

      <button type="submit" class="btn-primary" data-testid="login-pseudo-submit">
        {t('login.pseudoSubmit')}
      </button>
      <p class="auth-error" role="alert" data-testid="login-pseudo-error" hidden></p>
    </form>

    <p class="auth-signup">
      <span>{t('login.noAccount')}</span>
      <a class="btn-ghost" href={localizePath('/inscription/', locale)} data-testid="login-signup-link">
        {t('login.createAccount')}
      </a>
    </p>

    {/* ══ 2. RECOVERY — a person, not a link ═══════════════════════════════
        ⚠️ OUTBOUND ONLY, AND THE SAME SHAPE AS EVERY OTHER SHARE ON THIS SITE:
        `wa.me/<club number>?text=…` hands the reader's own device a prefilled
        message. Nothing is posted, stored or received here. */}
    <section class="auth-forgot" data-testid="login-forgot">
      <h2 class="auth-heading">{t('login.forgot.heading')}</h2>
      <p>{t('login.forgot.body')}</p>
      <p>
        <a
          class="btn-ghost"
          href={whatsappUrl(locale, t('login.forgot.message'))}
          rel="noopener"
          target="_blank"
          data-testid="login-forgot-whatsapp"
        >
          {t('login.forgot.cta')}
        </a>
      </p>
    </section>

    {/* ══ 3. THE MAGIC LINK — kept, and second ═════════════════════════════ */}
    <details class="auth-block" data-testid="login-email-block">
      <summary>
        <span class="auth-block-title">{t('login.email.heading')}</span>
        <span class="auth-block-hint">{t('login.email.hint')}</span>
      </summary>

      <div class="auth-block-body">
        <form
          id="login-form"
          data-testid="login-form"
          novalidate
          data-msg-sending={t('login.sending')}
          data-msg-submit={t('login.submit')}
          data-msg-error={t('login.error')}
          data-msg-invalid={t('login.invalidEmail')}
          data-msg-unconfigured={t('login.unconfigured')}
          data-msg-retry={t('login.retry')}
          data-callback-path="/auth/callback"
        >
          <label for="login-email">{t('login.emailLabel')}</label>
          <input
            id="login-email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            required
            data-testid="login-email"
          />

          {/* ── The honeypot ─────────────────────────────────────────────────
              ⚠️⚠️ THIS IS NOT SECURITY, AND NOTHING HERE MAY BE TREATED AS SUCH.

              The anon key ships to every browser by design, so anyone who wants
              an account can POST to Supabase's `/auth/v1/otp` endpoint and never
              load this page at all. Any check written into this form is bypassed
              by not using the form. What this buys is the cheap half: the naive
              scrapers that fill every input they find stop creating rows. That
              is noise reduction, and calling it anything more would be the same
              mistake as treating `isStaff()` as a gate.

              The real answers to junk sign-ups are elsewhere and are named in
              CLAUDE.md: Supabase's own per-address and per-IP rate limits, and
              `/admin/comptes/`, where an admin can SEE the sign-ups and remove
              one.

              ⚠️ IT FAILS VISIBLY AND RECOVERABLY — NEVER AS A FAKE SUCCESS. The
              usual honeypot advice is to pretend the send worked, which denies
              the bot its signal. It also means a parent whose password manager
              filled this field waits forever for an email that was never sent,
              with the page cheerfully telling them to check their inbox. On this
              site that trade goes the other way: show the error, CLEAR the
              field, and let the second press through. A bot loops; a human
              presses twice.

              ⚠️ HIDDEN FOR EVERYONE, INCLUDING ASSISTIVE TECH. `aria-hidden`
              plus `tabindex="-1"` keeps it out of the accessibility tree and out
              of the tab order, so it is not a mystery field a screen-reader user
              must skip. Positioned off-screen rather than `display: none`,
              because the scrapers worth catching skip what is explicitly not
              displayed. */}
          <div class="auth-hp" aria-hidden="true">
            <label for="login-website">{t('login.hpLabel')}</label>
            <input
              id="login-website"
              name="website"
              type="text"
              tabindex="-1"
              autocomplete="off"
              data-testid="login-hp"
            />
          </div>

          <button type="submit" class="btn-primary" data-testid="login-submit">
            {t('login.submit')}
          </button>

          {/* role="alert" so a screen reader hears the failure without hunting. */}
          <p class="auth-error" role="alert" data-testid="login-error" hidden></p>
        </form>

        {/* Rendered server-side and revealed on success rather than injected, so
            the success copy is real translated markup and not a string built in
            JS. */}
        <div class="auth-sent" data-testid="login-sent" hidden>
          <h3>{t('login.sent.title')}</h3>
          <p>{t('login.sent.body')}</p>
        </div>
      </div>
    </details>

    <p class="auth-guest">
      <a href={localizePath('/', locale)}>{t('login.guestNote')}</a>
    </p>
  </div>

  <script>
    /**
     * A bundled module, not inline: it needs the Supabase client, which is
     * itself reached with `await import()` so the ~30 KB only lands when
     * somebody actually submits a form — not merely by opening this page.
     */
    const form = document.getElementById('login-form') as HTMLFormElement | null;
    const email = document.querySelector('[data-testid="login-email"]') as HTMLInputElement | null;
    const submit = document.querySelector('[data-testid="login-submit"]') as HTMLButtonElement | null;
    const errorEl = document.querySelector('[data-testid="login-error"]') as HTMLElement | null;
    const sentEl = document.querySelector('[data-testid="login-sent"]') as HTMLElement | null;

    const honeypot = document.querySelector('[data-testid="login-hp"]') as HTMLInputElement | null;

    const msg = {
      sending: form?.dataset.msgSending ?? '',
      submit: form?.dataset.msgSubmit ?? '',
      error: form?.dataset.msgError ?? '',
      invalid: form?.dataset.msgInvalid ?? '',
      unconfigured: form?.dataset.msgUnconfigured ?? '',
      retry: form?.dataset.msgRetry ?? '',
    };
    const callbackPath = form?.dataset.callbackPath ?? '/auth/callback';

    function showError(message: string) {
      if (!errorEl) return;
      errorEl.textContent = message;
      errorEl.hidden = false;
    }

    /* ── 1. Pseudo + password ─────────────────────────────────────────────── */

    const pseudoForm = document.getElementById('pseudo-form') as HTMLFormElement | null;
    const pseudoInput = document.querySelector('[data-testid="login-pseudo"]') as HTMLInputElement | null;
    const passwordInput = document.querySelector('[data-testid="login-password"]') as HTMLInputElement | null;
    const reveal = document.querySelector('[data-testid="login-reveal"]') as HTMLInputElement | null;
    const pseudoSubmit = document.querySelector('[data-testid="login-pseudo-submit"]') as HTMLButtonElement | null;
    const pseudoError = document.querySelector('[data-testid="login-pseudo-error"]') as HTMLElement | null;

    const pseudoMsg = {
      signing: pseudoForm?.dataset.msgSigning ?? '',
      submit: pseudoForm?.dataset.msgSubmit ?? '',
      bad: pseudoForm?.dataset.msgBad ?? '',
      unconfigured: pseudoForm?.dataset.msgUnconfigured ?? '',
    };

    reveal?.addEventListener('change', () => {
      if (passwordInput) passwordInput.type = reveal.checked ? 'text' : 'password';
    });

    pseudoForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!pseudoInput || !passwordInput || !pseudoSubmit) return;
      if (pseudoError) pseudoError.hidden = true;

      const pseudo = pseudoInput.value.trim();
      const password = passwordInput.value;
      /* ⚠️ NO CLIENT-SIDE SHAPE CHECK ON SIGN-IN, DELIBERATELY. On the sign-up
         form an invalid pseudo is a typo worth catching early; here it is an
         existing account or it is not, and telling somebody their pseudo is
         "invalid" when they typed the one they have used all term would be
         a message about our rules rather than about their credentials. */
      if (!pseudo || !password) {
        if (pseudoError) {
          pseudoError.textContent = pseudoMsg.bad;
          pseudoError.hidden = false;
        }
        return;
      }

      pseudoSubmit.disabled = true;
      pseudoSubmit.textContent = pseudoMsg.signing;

      try {
        const { isConfigured, signInWithPseudo, landingAfterSignIn } = await import('@lib/supabase');
        if (!isConfigured()) {
          if (pseudoError) {
            pseudoError.textContent = pseudoMsg.unconfigured;
            pseudoError.hidden = false;
          }
          return;
        }
        const result = await signInWithPseudo(pseudo, password);
        if (!result.ok) {
          if (pseudoError) {
            /* ⚠️ ONE MESSAGE FOR BOTH CAUSES. "No such pseudo" would turn this
               form into a roster of who has an account at the club. */
            pseudoError.textContent = pseudoMsg.bad;
            pseudoError.hidden = false;
          }
          passwordInput.value = '';
          passwordInput.focus();
          return;
        }
        /* ⚠️ ONE LANDING RULE, IN `@lib/supabase`, SHARED WITH THE CALLBACK AND
           THE SIGN-UP PAGE — a forced password change first, then the welcome
           screen, then the account. A copy here is how two doors into the same
           house come to disagree. */
        window.location.assign(await landingAfterSignIn());
      } catch {
        if (pseudoError) {
          pseudoError.textContent = pseudoMsg.bad;
          pseudoError.hidden = false;
        }
      } finally {
        pseudoSubmit.disabled = false;
        pseudoSubmit.textContent = pseudoMsg.submit;
      }
    });

    /* ── 2. The magic link ────────────────────────────────────────────────── */

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!email || !submit) return;
      if (errorEl) errorEl.hidden = true;

      /**
       * ⚠️ THE HONEYPOT, AND THE ONE BEHAVIOUR THAT MATTERS: IT CLEARS ITSELF.
       *
       * A filled hidden field means a scraper — or, rarely, a password manager
       * that ignored `autocomplete="off"`. Refusing once and emptying the field
       * makes the second press succeed for the human and changes nothing for
       * the bot, which will fill it again. Pretending the link was sent would
       * be kinder to the bot and cruel to the parent.
       */
      if (honeypot && honeypot.value !== '') {
        honeypot.value = '';
        showError(msg.retry);
        return;
      }

      const value = email.value.trim();
      /* Deliberately loose. The server is the real validator; this only catches
         the obvious typo before spending a round trip. */
      if (!value || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(value)) {
        showError(msg.invalid);
        email.focus();
        return;
      }

      submit.disabled = true;
      submit.textContent = msg.sending;

      try {
        const { isConfigured, signInWithMagicLink } = await import('@lib/supabase');
        if (!isConfigured()) {
          showError(msg.unconfigured);
          return;
        }
        const redirectTo = new URL(callbackPath, window.location.origin).toString();
        const result = await signInWithMagicLink(value, redirectTo);

        if (!result.ok) {
          showError(msg.error);
          return;
        }
        /* Replace the form with the confirmation. The address is not echoed
           back — it is already in the reader's own field, and echoing it into
           the page is one more place it can be shoulder-surfed. */
        form.hidden = true;
        if (sentEl) sentEl.hidden = false;
      } catch {
        showError(msg.error);
      } finally {
        submit.disabled = false;
        submit.textContent = msg.submit;
      }
    });
  </script>
</BaseLayout>

<style>
  .auth-card {
    max-width: 32rem;
    padding: 1.5rem;
    border: 1px solid var(--mcc-border-subtle);
    border-radius: var(--radius-card);
    background-color: var(--mcc-surface-raised);
  }

  .auth-heading {
    margin: 0 0 0.75rem;
    font-size: 1.15rem;
  }

  label {
    display: block;
    margin-bottom: 0.35rem;
    font-weight: 500;
  }

  input[type='email'],
  input[type='text'],
  input[type='password'] {
    width: 100%;
    padding: 0.6rem 0.75rem;
    margin-bottom: 0.9rem;
    border: 1px solid var(--mcc-border-strong);
    border-radius: var(--radius-card);
    background-color: var(--mcc-surface-page);
    color: var(--mcc-text-primary);
    font: inherit;
  }

  input:focus-visible {
    outline: 2px solid var(--mcc-focus-ring);
    outline-offset: 1px;
  }

  /* The reveal checkbox is a row, not a block: the label belongs beside the box
     and the whole row is the target. */
  .auth-reveal {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
  }

  .auth-reveal input {
    width: auto;
    margin: 0;
    min-width: 1.15rem;
    min-height: 1.15rem;
  }

  .auth-reveal label {
    margin: 0;
    font-weight: 400;
  }

  .btn-primary {
    margin-top: 1rem;
    padding: 0.7rem 1.4rem;
    border: 1px solid var(--mcc-primary);
    border-radius: var(--radius-card);
    background-color: var(--mcc-primary);
    color: var(--mcc-primary-contrast);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }

  .btn-primary:disabled {
    opacity: 0.7;
    cursor: default;
  }

  .auth-signup {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    align-items: center;
    margin: 1.25rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--mcc-border-subtle);
  }

  .auth-forgot {
    margin-top: 1.5rem;
    padding: 1rem;
    border: 1px solid var(--mcc-border-subtle);
    border-radius: var(--radius-card);
    background-color: var(--mcc-surface-page);
  }

  .auth-forgot p {
    margin: 0.5rem 0 0;
    color: var(--mcc-text-secondary);
  }

  /* ⚠️ NATIVE `<details>`, STYLED — not reimplemented. Same rule as `/compte/`:
     it works with no JavaScript, it is keyboard-operable and announced for
     free, and find-in-page opens it. */
  .auth-block {
    margin-top: 1.5rem;
    border: 1px solid var(--mcc-border-subtle);
    border-radius: var(--radius-card);
    background-color: var(--mcc-surface-page);
  }

  .auth-block summary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.75rem;
    align-items: baseline;
    min-height: 3rem;
    padding: 0.85rem 1.1rem;
    border-radius: var(--radius-card);
    cursor: pointer;
  }

  .auth-block-title {
    font-weight: 500;
  }

  .auth-block-hint {
    color: var(--mcc-text-secondary);
    font-size: 0.9rem;
  }

  .auth-block-body {
    padding: 0 1.1rem 1.1rem;
  }

  /* ⚠️ OFF-SCREEN, NOT `display: none` AND NOT `visibility: hidden`. A scraper
     worth catching skips a field the page has explicitly hidden; one that is
     merely positioned away still looks like a field to fill. The element is
     already out of the accessibility tree and out of the tab order via
     `aria-hidden` and `tabindex="-1"` on the markup, so nothing here is what
     keeps it from a screen reader. */
  .auth-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .auth-error {
    margin: 0.75rem 0 0;
    color: var(--mcc-danger-text);
  }

  .auth-sent h3 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
  }

  .auth-sent p {
    margin: 0;
    color: var(--mcc-text-secondary);
  }

  .auth-guest {
    margin: 1.25rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--mcc-border-subtle);
  }

  .auth-guest a {
    color: var(--mcc-link);
  }
</style>
