---
/**
 * One lesson of a course.
 *
 * ⚠️ BOARDS ARE PLACED INLINE, and this is how.
 *
 * The body is Markdown, and the copy puts boards in the middle of the prose —
 * a diagram after the paragraph it illustrates, not all of them dumped at the
 * end. Astro renders a Markdown body as one `<Content />` component, which
 * cannot be interleaved.
 *
 * So the body carries `<!--board-->` markers, and we split the RENDERED HTML on
 * them (`entry.rendered.html`, which the glob loader provides) and drop the
 * boards into the gaps. Zero dependencies, no MDX integration, and the prose
 * stays ordinary Markdown that a non-programmer can edit.
 *
 * ⚠️ MDX was NOT added. It would allow `<Board />` inline and is the "proper"
 * answer, but it is an integration — an architecture change this batch was
 * explicitly scoped out of. If lessons ever need real components inline, that is
 * the moment to reconsider, not before.
 *
 * ⚠️ This page can mount SEVERAL islands — lesson 5 has three replayers. The
 * "not N live boards" rule is about index pages and diagram galleries; a
 * long-form lesson legitimately needs a board per idea, and every one is
 * `client:visible`, so only those actually scrolled to ever hydrate.
 */
import type { Locale } from '@config/site';
import type { CollectionEntry } from 'astro:content';
import { localizePath } from '@i18n/paths';
import { useTranslations } from '@i18n/ui';
import BaseLayout from '@layouts/BaseLayout.astro';
import ReplayBoard from '@components/board/ReplayBoard.astro';
import ExerciseBoard from '@components/board/ExerciseBoard.astro';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'lessons'>;
  course: CollectionEntry<'cours'>;
  prev: CollectionEntry<'lessons'> | null;
  next: CollectionEntry<'lessons'> | null;
  total: number;
}

const { locale, entry, course, prev, next, total } = Astro.props;
const { data } = entry;
const t = useTranslations(locale);
const courseTitle = locale === 'fr' ? course.data.title_fr : course.data.title_en;

/**
 * Split the rendered body on the board markers.
 *
 * The comment survives Astro's Markdown pipeline as a literal `<!--board-->` in
 * the HTML. If that ever stops being true the split yields one chunk, the prose
 * still renders in full, and the boards follow it — degraded, never broken.
 */
const html = entry.rendered?.html ?? '';
const chunks = html.split('<!--board-->');

const coursePath = localizePath(`/cours/${course.data.slug}/`, locale);

/**
 * `**bold**` in a task string, and nothing else. The tasks are short one-liners
 * held in frontmatter rather than in the Markdown body, so they do not go
 * through the Markdown pipeline — but the copy uses bold in them. Escaped first,
 * so this can never inject markup from content.
 */
function emphasise(text: string): string {
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
}

/** Paired with the prose chunk of the same index; may be undefined for the tail. */
/**
 * A board with no moves: a still diagram.
 *
 * The replayer takes a PGN, so a position becomes a PGN carrying only its start
 * FEN. ReplayView hides the launch button, the controls and the hint when there
 * are no plies, so this renders as a plain labelled board rather than a
 * replayer with nothing to replay.
 *
 * This is what batch 1 could not do — it converted its two diagrams into short
 * replays that reached them. Batch 2's diagrams are terminal states (a
 * stalemate, a finished mate) that no legal line arrives at, so they need to be
 * shown as they are.
 */
function positionPgn(fen: string): string {
  return `[SetUp "1"]\n[FEN "${fen}"]\n\n*`;
}

const pairs = chunks.map((chunk, i) => ({ chunk, board: data.boards[i] }));
---

<BaseLayout locale={locale} title={data.title} description={data.summary}>
  <article class="lesson">
    <header class="lesson-head">
      <p class="lesson-counter">
        <a href={coursePath}>{courseTitle}</a>
        <span aria-hidden="true">·</span>
        <span>{t('tutorial.step')} {data.order} {t('tutorial.of')} {total}</span>
      </p>
      <h1>{data.title}</h1>
      <p class="lesson-summary">{data.summary}</p>
    </header>

    <div class="lesson-body">
      {
        pairs.map(({ chunk, board }) => (
          <>
            <div class="prose" set:html={chunk} />
            {board && (
              <figure class="lesson-board">
                {(board.kind === 'replay' || board.kind === 'position') && (
                  <ReplayBoard
                    locale={locale}
                    pgn={board.kind === 'position' ? positionPgn(board.fen) : board.pgn}
                    moveComments={(board.kind === 'replay' ? board.comments : []).map((c) => ({ ply: c.ply, fr: c.text, en: c.text }))}
                    {...(board.orientation ? { orientation: board.orientation } : {})}
                  />
                )}
                {board.kind === 'exercise' && (
                  <ExerciseBoard
                    locale={locale}
                    slug={`lesson:${course.data.slug}:${data.slug}:${data.boards.indexOf(board)}`}
                    fen={board.fen}
                    solution={board.solution}
                    opponentReplies={board.opponentReplies}
                    onlyMove={board.onlyMove}
                    hint={board.hint}
                    {...(board.orientation ? { orientation: board.orientation } : {})}
                  />
                )}
                {board.kind === 'exercise' && <figcaption set:html={emphasise(board.task)} />}
                {(board.kind === 'replay' || board.kind === 'position') && board.caption && (
                  <figcaption>{board.caption}</figcaption>
                )}
              </figure>
            )}
          </>
        ))
      }
    </div>

    {/* The end of a course must lead somewhere. Without this, finishing lesson
        six is a dead end — the reader has just been told to practise and has
        nowhere to click. */}
    {
      !next && (
        <section class="lesson-next-up">
          <h2>{t('nav.whatNext')}</h2>
          <p class="lesson-next-links">
            <a class="btn-primary" href={localizePath('/exercices/', locale)}>
              {t('tutorial.toExercises')}
            </a>
            <a class="btn-ghost" href={localizePath('/pieges/', locale)}>
              {t('nav.toTraps')}
            </a>
          </p>
        </section>
      )
    }

    <nav class="lesson-nav" aria-label={courseTitle}>
      <div class="lesson-nav-row">
        {
          prev ? (
            <a
              class="lesson-nav-link"
              href={localizePath(`/cours/${course.data.slug}/${prev.data.slug}/`, locale)}
              rel="prev"
              data-testid="lesson-prev"
            >
              <span class="lesson-nav-dir">← {t('tutorial.prev')}</span>
              <span class="lesson-nav-title">{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a
              class="lesson-nav-link lesson-nav-next"
              href={localizePath(`/cours/${course.data.slug}/${next.data.slug}/`, locale)}
              rel="next"
              data-testid="lesson-next"
            >
              <span class="lesson-nav-dir">{t('tutorial.next')} →</span>
              <span class="lesson-nav-title">{next.data.title}</span>
            </a>
          )
        }
      </div>
      <p class="lesson-nav-index">
        <a href={coursePath} data-testid="lesson-index">{t('nav.backToCourse')}</a>
      </p>
    </nav>
  </article>
</BaseLayout>

<style>
  .lesson {
    max-width: 66ch;
  }

  .lesson-counter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    color: var(--mcc-text-secondary);
    font-size: 0.875rem;
  }

  .lesson-counter a {
    color: var(--mcc-link);
  }

  .lesson h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    line-height: 1.1;
  }

  .lesson-summary {
    margin: 0 0 2rem;
    color: var(--mcc-text-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .prose :global(p),
  .prose :global(li) {
    line-height: 1.7;
    text-wrap: pretty;
  }

  .prose :global(h2) {
    margin: 2rem 0 0.75rem;
    font-size: 1.375rem;
  }

  .prose :global(a) {
    color: var(--mcc-link);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .prose :global(code) {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background-color: var(--mcc-surface-sunken);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .lesson-board {
    margin: 2rem 0;
  }

  .lesson-board figcaption {
    margin-top: 0.75rem;
    color: var(--mcc-text-secondary);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .lesson-next-up {
    margin-top: 2.5rem;
    padding: 1.25rem;
    border: 1px solid var(--mcc-border-subtle);
    border-radius: var(--radius-card);
    background-color: var(--mcc-surface-raised);
  }

  .lesson-next-up h2 {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
  }

  .lesson-next-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
  }

  .btn-primary,
  .btn-ghost {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius-card);
    font-weight: 500;
    text-decoration: none;
  }

  .btn-primary {
    border: 1px solid var(--mcc-primary);
    background-color: var(--mcc-primary);
    color: var(--mcc-primary-contrast);
  }

  .btn-ghost {
    border: 1px solid var(--mcc-border-strong);
    color: var(--mcc-link);
  }

  .lesson-nav {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--mcc-border-subtle);
  }

  .lesson-nav-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .lesson-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--mcc-border-subtle);
    border-radius: var(--radius-card);
    background-color: var(--mcc-surface-raised);
    color: var(--mcc-link);
    text-decoration: none;
  }

  .lesson-nav-link:hover {
    border-color: var(--mcc-border-strong);
  }

  .lesson-nav-next {
    text-align: right;
  }

  .lesson-nav-dir {
    color: var(--mcc-text-secondary);
    font-size: 0.8125rem;
  }

  .lesson-nav-title {
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .lesson-nav-index {
    margin: 1rem 0 0;
    text-align: center;
  }

  .lesson-nav-index a {
    color: var(--mcc-link);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  @media (max-width: 30rem) {
    .lesson-nav-row {
      grid-template-columns: 1fr;
    }

    .lesson-nav-next {
      text-align: left;
    }
  }
</style>
