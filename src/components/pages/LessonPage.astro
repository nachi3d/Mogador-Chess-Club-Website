---
/**
 * One lesson of a course.
 *
 * ⚠️ BOARDS ARE PLACED INLINE, and this is how.
 *
 * The body is Markdown, and the copy puts boards in the middle of the prose —
 * a diagram after the paragraph it illustrates, not all of them dumped at the
 * end. Astro renders a Markdown body as one `<Content />` component, which
 * cannot be interleaved.
 *
 * So the body carries `<!--board-->` markers, and we split the RENDERED HTML on
 * them (`entry.rendered.html`, which the glob loader provides) and drop the
 * boards into the gaps. Zero dependencies, no MDX integration, and the prose
 * stays ordinary Markdown that a non-programmer can edit.
 *
 * ⚠️ MDX was NOT added. It would allow `<Board />` inline and is the "proper"
 * answer, but it is an integration — an architecture change this batch was
 * explicitly scoped out of. If lessons ever need real components inline, that is
 * the moment to reconsider, not before.
 *
 * ⚠️ This page can mount SEVERAL islands — lesson 5 has three replayers. The
 * "not N live boards" rule is about index pages and diagram galleries; a
 * long-form lesson legitimately needs a board per idea, and every one is
 * `client:visible`, so only those actually scrolled to ever hydrate.
 */
import type { Locale } from '@config/site';
import type { CollectionEntry } from 'astro:content';
import { localizePath } from '@i18n/paths';
import { useTranslations } from '@i18n/ui';
import BaseLayout from '@layouts/BaseLayout.astro';
import ReplayBoard from '@components/board/ReplayBoard.astro';
import ExerciseBoard from '@components/board/ExerciseBoard.astro';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'lessons'>;
  course: CollectionEntry<'cours'>;
  prev: CollectionEntry<'lessons'> | null;
  next: CollectionEntry<'lessons'> | null;
  total: number;
}

const { locale, entry, course, prev, next, total } = Astro.props;
const { data } = entry;
const t = useTranslations(locale);
const courseTitle = locale === 'fr' ? course.data.title_fr : course.data.title_en;

/**
 * Split the rendered body on the board markers.
 *
 * The comment survives Astro's Markdown pipeline as a literal `<!--board-->` in
 * the HTML. If that ever stops being true the split yields one chunk, the prose
 * still renders in full, and the boards follow it — degraded, never broken.
 */
const html = entry.rendered?.html ?? '';
const chunks = html.split('<!--board-->');

const coursePath = localizePath(`/cours/${course.data.slug}/`, locale);

/**
 * `**bold**` in a task string, and nothing else. The tasks are short one-liners
 * held in frontmatter rather than in the Markdown body, so they do not go
 * through the Markdown pipeline — but the copy uses bold in them. Escaped first,
 * so this can never inject markup from content.
 */
function emphasise(text: string): string {
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
}

/** Paired with the prose chunk of the same index; may be undefined for the tail. */
const pairs = chunks.map((chunk, i) => ({ chunk, board: data.boards[i] }));
---

<BaseLayout locale={locale} title={data.title} description={data.summary}>
  <article class="lesson">
    <header class="lesson-head">
      <p class="lesson-counter">
        <a href={coursePath}>{courseTitle}</a>
        <span aria-hidden="true">·</span>
        <span>{t('tutorial.step')} {data.order} {t('tutorial.of')} {total}</span>
      </p>
      <h1>{data.title}</h1>
      <p class="lesson-summary">{data.summary}</p>
    </header>

    <div class="lesson-body">
      {
        pairs.map(({ chunk, board }) => (
          <>
            <div class="prose" set:html={chunk} />
            {board && (
              <figure class="lesson-board">
                {board.kind === 'replay' && (
                  <ReplayBoard
                    locale={locale}
                    pgn={board.pgn}
                    moveComments={board.comments.map((c) => ({ ply: c.ply, fr: c.text, en: c.text }))}
                    {...(board.orientation ? { orientation: board.orientation } : {})}
                  />
                )}
                {board.kind === 'exercise' && (
                  <ExerciseBoard
                    locale={locale}
                    slug={`lesson:${course.data.slug}:${data.slug}:${data.boards.indexOf(board)}`}
                    fen={board.fen}
                    solution={board.solution}
                    opponentReplies={board.opponentReplies}
                    onlyMove={board.onlyMove}
                    hint={board.hint}
                    {...(board.orientation ? { orientation: board.orientation } : {})}
                  />
                )}
                {board.kind === 'exercise' && <figcaption set:html={emphasise(board.task)} />}
                {board.kind === 'replay' && board.caption && (
                  <figcaption>{board.caption}</figcaption>
                )}
              </figure>
            )}
          </>
        ))
      }
    </div>

    <nav class="lesson-nav" aria-label={courseTitle}>
      {
        prev ? (
          <a
            class="lesson-nav-link"
            href={localizePath(`/cours/${course.data.slug}/${prev.data.slug}/`, locale)}
            rel="prev"
            data-testid="lesson-prev"
          >
            ← {prev.data.title}
          </a>
        ) : (
          <a class="lesson-nav-link" href={coursePath}>
            ← {courseTitle}
          </a>
        )
      }
      {
        next && (
          <a
            class="lesson-nav-link lesson-nav-next"
            href={localizePath(`/cours/${course.data.slug}/${next.data.slug}/`, locale)}
            rel="next"
            data-testid="lesson-next"
          >
            {next.data.title} →
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .lesson {
    max-width: 66ch;
  }

  .lesson-counter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    color: var(--mcc-text-secondary);
    font-size: 0.875rem;
  }

  .lesson-counter a {
    color: var(--mcc-link);
  }

  .lesson h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    line-height: 1.1;
  }

  .lesson-summary {
    margin: 0 0 2rem;
    color: var(--mcc-text-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .prose :global(p),
  .prose :global(li) {
    line-height: 1.7;
    text-wrap: pretty;
  }

  .prose :global(h2) {
    margin: 2rem 0 0.75rem;
    font-size: 1.375rem;
  }

  .prose :global(a) {
    color: var(--mcc-link);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .prose :global(code) {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background-color: var(--mcc-surface-sunken);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .lesson-board {
    margin: 2rem 0;
  }

  .lesson-board figcaption {
    margin-top: 0.75rem;
    color: var(--mcc-text-secondary);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .lesson-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--mcc-border);
  }

  .lesson-nav-link {
    color: var(--mcc-link);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .lesson-nav-next {
    margin-left: auto;
    font-weight: 500;
  }
</style>
