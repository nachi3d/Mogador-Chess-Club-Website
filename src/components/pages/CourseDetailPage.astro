---
/**
 * `/cours/<course>/` — the lessons of one course, listed.
 *
 * No board here: it is an index, and the boards live on each lesson's route.
 */
import type { Locale } from '@config/site';
import type { CollectionEntry } from 'astro:content';
import { localizePath } from '@i18n/paths';
import { useTranslations } from '@i18n/ui';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/PageIntro.astro';
import Trail from '@components/nav/Trail.astro';
import LevelBadge from '@components/LevelBadge.astro';
import NumberedCard from '@components/NumberedCard.astro';
import ProgressStates from '@components/ProgressStates.astro';
import VideoFacade from '@components/VideoFacade.astro';

interface Props {
  locale: Locale;
  course: CollectionEntry<'cours'>;
  lessons: CollectionEntry<'lessons'>[];
}

const { locale, course, lessons } = Astro.props;
const t = useTranslations(locale);
const title = locale === 'fr' ? course.data.title_fr : course.data.title_en;
const summary = locale === 'fr' ? course.data.summary_fr : course.data.summary_en;

/**
 * The exercise-board keys one lesson records under.
 *
 * ⚠️ SAME SCHEME AS LessonPage MOUNTS THEM WITH —
 * `lesson:<course>:<lesson>:<boardIndex>`, indexed against the FULL boards
 * array so a lesson whose second board is the exercise is key `:1`, not `:0`.
 * Re-deriving it from a filtered list would silently renumber every lesson
 * that opens with a demonstration, which is most of them.
 */
function lessonKeys(lesson: CollectionEntry<'lessons'>): string[] {
  return lesson.data.boards
    .map((board, index) => ({ board, index }))
    .filter(({ board }) => board.kind === 'exercise')
    .map(({ index }) => `lesson:${course.data.slug}:${lesson.data.slug}:${index}`);
}
---

<BaseLayout locale={locale} title={title} description={summary} reveals>
  <Trail locale={locale} href={localizePath('/cours/', locale)} label={t('nav.courses')} />
  <PageIntro title={title} intro={summary} />

  <p class="course-level">
    <LevelBadge locale={locale} level={course.data.level} />
  </p>

  <ol class="lessons" data-reveal-stagger>
    {
      lessons.map((lesson) => (
        <NumberedCard
          locale={locale}
          number={lesson.data.order}
          title={lesson.data.title}
          summary={lesson.data.summary}
          href={localizePath(`/cours/${course.data.slug}/${lesson.data.slug}/`, locale)}
          progressKeys={lessonKeys(lesson)}
          doneLabel={t('progress.state.lessonDone')}
        />
      ))
    }
  </ol>

  <ProgressStates />

  {/*
    ⚠️ SAME RULE AS THE TRAP PAGE: after the page's primary content, before
    the way onward. Here the primary content is the LESSON LIST — this page
    is a chooser (Critical Feature 65), and a video above the list would put
    a 16:9 block between a reader and the lesson they came to start.

    A course intro video is genuinely useful, so it is not buried: it sits
    under its own heading immediately after the list, above the fold on a
    desktop and one flick away on a phone.
  */}
  <VideoFacade locale={locale} videoId={course.data.youtube} title={title} />

  <p class="course-back">
    <a href={localizePath('/cours/', locale)}>← {t('courses.title')}</a>
  </p>
</BaseLayout>

<style>
  .course-level {
    margin: 0 0 1.5rem;
  }

  .lessons {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ⚠️ THE CARD MOVED TO NumberedCard.astro (M3). It was a pixel-identical
     copy of TutorialIndexPage's `.step` — same disc, same grid, same stretched
     link — and both were missing the shadow CardGrid's `.card` had, so a
     lesson list and a course list looked like two different sites. The
     surface vocabulary now lives in src/styles/cards.css. */

  .course-back {
    margin-top: 2rem;
  }

  .course-back a {
    color: var(--mcc-link);
  }
</style>
