---
/**
 * `/cours/<course>/` — the lessons of one course, listed.
 *
 * No board here: it is an index, and the boards live on each lesson's route.
 */
import type { Locale } from '@config/site';
import type { CollectionEntry } from 'astro:content';
import { localizePath } from '@i18n/paths';
import { useTranslations } from '@i18n/ui';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/PageIntro.astro';
import LevelBadge from '@components/LevelBadge.astro';

interface Props {
  locale: Locale;
  course: CollectionEntry<'cours'>;
  lessons: CollectionEntry<'lessons'>[];
}

const { locale, course, lessons } = Astro.props;
const t = useTranslations(locale);
const title = locale === 'fr' ? course.data.title_fr : course.data.title_en;
const summary = locale === 'fr' ? course.data.summary_fr : course.data.summary_en;
---

<BaseLayout locale={locale} title={title} description={summary} reveals>
  <PageIntro title={title} intro={summary} />

  <p class="course-level">
    <LevelBadge locale={locale} level={course.data.level} />
  </p>

  <ol class="lessons" data-reveal-stagger>
    {
      lessons.map((lesson) => (
        <li class="lesson-card" data-reveal>
          <span class="lesson-number" aria-hidden="true">
            {lesson.data.order}
          </span>
          <div>
            <h2>
              <a href={localizePath(`/cours/${course.data.slug}/${lesson.data.slug}/`, locale)}>
                {lesson.data.title}
              </a>
            </h2>
            <p>{lesson.data.summary}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <p class="course-back">
    <a href={localizePath('/cours/', locale)}>← {t('courses.title')}</a>
  </p>
</BaseLayout>

<style>
  .course-level {
    margin: 0 0 1.5rem;
  }

  .lessons {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lesson-card {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--mcc-border-subtle);
    border-radius: var(--radius-card);
    background-color: var(--mcc-surface-raised);
    transition: border-color var(--motion-response) var(--ease-response);
  }

  .lesson-card:hover {
    border-color: var(--mcc-border-strong);
  }

  .lesson-card:focus-within {
    outline: 2px solid var(--mcc-focus-ring);
    outline-offset: 2px;
  }

  .lesson-number {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background-color: var(--color-brass-300);
    color: var(--color-ink-950);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .lesson-card h2 {
    margin: 0 0 0.2rem;
    font-size: 1.125rem;
  }

  .lesson-card h2 a {
    color: var(--mcc-text-heading);
    text-decoration: none;
  }

  .lesson-card h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .lesson-card h2 a:hover {
    color: var(--mcc-link);
  }

  .lesson-card h2 a:focus-visible {
    outline: none;
  }

  .lesson-card p {
    margin: 0;
    color: var(--mcc-text-secondary);
    line-height: 1.5;
  }

  .course-back {
    margin-top: 2rem;
  }

  .course-back a {
    color: var(--mcc-link);
  }
</style>
