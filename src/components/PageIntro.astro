---
/**
 * The h1 + lede block every index page opens with. One component so the
 * heading level and the lede width stay consistent across the six routes.
 */
interface Props {
  title: string;
  intro: string;
}

const { title, intro } = Astro.props;
---

{/* `data-reveal` is inert unless the page opted in via BaseLayout's `reveals`
    prop — the CSS gate needs body[data-reveals] too. Safe to mark here
    unconditionally; pages that never opt in are unaffected. */}
<div class="page-intro" data-reveal>
  <h1>{title}</h1>
  <p class="lede">{intro}</p>
</div>

<style>
  /* ⚠️⚠️ --mcc-space-xl, NOT --mcc-section-gap. This block is a page's TITLE
     and the thing under it is what the title announces; they are one unit, not
     two sections. `--mcc-section-gap` is 6rem above 768px and it put 96px of
     nothing between a heading and its own content on EVERY page that uses this
     component — measured identically on all eleven of them.

     ⚠️ ONE CHANGE, NOT ELEVEN. The gap belongs to the head, so it is set here
     and nowhere else; a page that wants a different figure is a design
     decision to argue, not a margin to override quietly. */
  .page-intro {
    margin-bottom: var(--mcc-space-xl);
  }

  .page-intro h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
  }

  .lede {
    max-width: 46ch;
    margin: 0;
    color: var(--mcc-text-secondary);
    font-size: 1.125rem;
    line-height: 1.6;
    text-wrap: pretty;
  }
</style>
