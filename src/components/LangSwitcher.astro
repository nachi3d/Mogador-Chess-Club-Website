---
/**
 * Language switcher.
 *
 * CRITICAL: it must PRESERVE THE PATH. A visitor two pages deep into the traps
 * library who switches to English lands on the English traps library, not on
 * the English home page. `alternatePath()` does the mapping; route segments are
 * shared across locales precisely so this can never fail to find a counterpart.
 */
import type { Locale } from '@config/site';
import { alternatePath, otherLocale } from '@i18n/paths';
import { useTranslations } from '@i18n/ui';

interface Props {
  locale: Locale;
  /** The CURRENT pathname — pass Astro.url.pathname from the page. */
  pathname: string;
}

const { locale, pathname } = Astro.props;
const target = otherLocale(locale);
const href = alternatePath(pathname, target);
const t = useTranslations(locale);
---

<a
  class="lang-switch"
  href={href}
  hreflang={target}
  lang={target}
  aria-label={t('lang.label')}
  data-testid="lang-switch"
>
  {t('lang.switchTo')}
</a>

<style>
  .lang-switch {
    display: inline-block;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--mcc-accent-on-inverse);
    border-radius: var(--radius-pill);
    color: var(--mcc-accent-on-inverse);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--duration-fast) var(--ease-soft);
  }

  .lang-switch:hover {
    background-color: var(--color-green-900);
  }
</style>
