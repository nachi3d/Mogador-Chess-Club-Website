---
/**
 * The settings entry in the header.
 *
 * ── WHERE IT GOES, AND WHY THERE (Task 3, Seàn's request) ─────────────────
 * Settings lived only in the FOOTER on desktop, which meant reaching them
 * required scrolling to the bottom of whatever page you happened to be on.
 *
 * It is placed in `header-tools`, beside the theme toggle and the language
 * switcher — NOT inside the "Le club" nav group. Three reasons, in order:
 *
 *  1. **It is a preference control, not a destination.** The two things it now
 *     sits between are also preference controls. "Le club" is about the
 *     ORGANISATION — when it meets, how to write to it — and filing a personal
 *     display preference under it is precisely where nobody would look.
 *  2. **The theme toggle beside it is a shortcut to ONE of these settings.**
 *     Putting the full page next to its own shortcut makes that relationship
 *     legible: press the icon for a quick flip, press the gear for everything.
 *  3. **The nav groups are content sections** and are walked by readers looking
 *     for something to read. Adding a settings page to that walk makes the
 *     group answer two different questions.
 *
 * ⚠️ Unlike the theme toggle it is a REAL LINK and is NOT gated on `html.js`.
 * The toggle needs scripting to do anything, so it hides without it; this
 * navigates to a page that exists either way, and `/parametres/` explains in
 * its own `<noscript>` that the controls there need JS. A reader without
 * scripting should still be able to find the page rather than have it vanish.
 *
 * The footer link stays. Two entry points to one page is not redundancy here —
 * the footer is where a reader looks for "the boring pages" and the header is
 * where they look for "change something now".
 */
import type { Locale } from '@config/site';
import { localizePath } from '@i18n/paths';
import { useTranslations } from '@i18n/ui';

interface Props {
  locale: Locale;
  /** True when the reader is already on `/parametres/`. */
  current?: boolean | undefined;
}

const { locale, current = false } = Astro.props;
const t = useTranslations(locale);
---

<a
  class:list={['settings-link', { 'is-current': current }]}
  href={localizePath('/parametres/', locale)}
  aria-label={t('settings.title')}
  aria-current={current ? 'page' : undefined}
  data-testid="header-settings"
>
  {/* Decorative: the accessible name is on the link. A gear is the one icon
      every reader already knows means "settings", which is why it is not
      accompanied by a visible label in a row that is otherwise all icons. */}
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="20" height="20">
    <path
      fill="currentColor"
      d="M12 15.4a3.4 3.4 0 1 1 0-6.8 3.4 3.4 0 0 1 0 6.8Zm0-1.8a1.6 1.6 0 1 0 0-3.2 1.6 1.6 0 0 0 0 3.2Z"
    ></path>
    <path
      fill="currentColor"
      d="m19.4 12 1.4-1.7a.9.9 0 0 0 .1-1l-1.6-2.7a.9.9 0 0 0-.9-.4l-2.2.4-1.5-1a.9.9 0 0 0-.4-.6L13.5 2.6a.9.9 0 0 0-.8-.6h-3.2a.9.9 0 0 0-.9.7L8 4.9l-1.6 1-2.1-.5a.9.9 0 0 0-1 .5L1.8 9.5a.9.9 0 0 0 .2 1.1L3.5 12l-1.5 1.4a.9.9 0 0 0-.2 1.1l1.6 2.7a.9.9 0 0 0 1 .4l2.1-.5 1.6 1 .6 2.2a.9.9 0 0 0 .9.7h3.2a.9.9 0 0 0 .9-.7l.6-2.2 1.6-1 2.1.5a.9.9 0 0 0 1-.4l1.6-2.7a.9.9 0 0 0-.2-1.1Zm-2.6 1.3.9.8-.9 1.5-1.8-.4a.9.9 0 0 0-.7.1l-2.2 1.3a.9.9 0 0 0-.4.6l-.5 1.9h-1.7l-.5-1.9a.9.9 0 0 0-.4-.6l-2.2-1.3a.9.9 0 0 0-.7-.1l-1.8.4-.9-1.5.9-.8a.9.9 0 0 0 .3-.7v-2.6a.9.9 0 0 0-.3-.7l-.9-.8.9-1.5 1.8.4a.9.9 0 0 0 .7-.1L8.6 6.3a.9.9 0 0 0 .4-.6l.5-1.9h1.7l.5 1.9a.9.9 0 0 0 .4.6l2.2 1.3a.9.9 0 0 0 .7.1l1.8-.4.9 1.5-.9.8a.9.9 0 0 0-.3.7v2.6a.9.9 0 0 0 .3.7Z"
    ></path>
  </svg>
</a>

<style>
  /* Matches `.theme-toggle` deliberately — three controls in a row that look
     like three different things would read as an accident. Same 44px target,
     same border, same hover. */
  .settings-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    color: inherit;
    border: 1px solid var(--mcc-border-on-inverse);
    border-radius: var(--radius-card);
    text-decoration: none;
  }

  .settings-link:hover {
    border-color: var(--mcc-accent-on-inverse);
    color: var(--mcc-accent-on-inverse);
  }

  /* Same treatment the nav links use for the page you are on. */
  .settings-link.is-current {
    border-color: var(--mcc-accent-on-inverse);
    color: var(--mcc-accent-on-inverse);
  }
</style>
