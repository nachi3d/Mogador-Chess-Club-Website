---
/**
 * Site header — logo placeholder, nav, language switcher.
 * Skeleton: the mark is the placeholder SVG and the layout is deliberately
 * plain. Real design lands in a later session.
 */
import type { Locale } from '@config/site';
import { site } from '@config/site';
import { localizePath, stripLocale } from '@i18n/paths';
import { NAV_GROUPS, useTranslations } from '@i18n/ui';
import LangSwitcher from '@components/LangSwitcher.astro';
import AccountButton from '@components/AccountButton.astro';
import ThemeToggle from '@components/ThemeToggle.astro';
import SettingsLink from '@components/SettingsLink.astro';

interface Props {
  locale: Locale;
  pathname: string;
  /** This page exists in one language only — see BaseLayout's prop. */
  singleLocale?: boolean;
}

const { locale, pathname, singleLocale = false } = Astro.props;
const t = useTranslations(locale);
const current = stripLocale(pathname);
---

<header class="surface-inverse site-header">
  <div class="container-page header-inner">
    <a class="brand" href={localizePath('/', locale)}>
      <!-- Placeholder mark — see src/assets/brand/mark.svg -->
      <img class="brand-mark" src="/icons/favicon.svg" alt="" width="36" height="36" aria-hidden="true" />
      <span class="brand-name">{site.name}</span>
    </a>

    {/*
      ⚠️ DISCLOSURE NAVIGATION, NOT `role="menu"`.

      A `role="menu"` / `menuitem` tree is for APPLICATION menus. Screen readers
      then announce "menu", expect arrow-key roving focus, and stop announcing
      the links inside as links. These are site navigation links, so the WAI
      disclosure pattern is the correct semantics: a button carrying
      `aria-expanded` + `aria-controls` that reveals a plain list of links. Tab
      walks them, which is what everyone already expects of a website.

      ⚠️ CLICK, NEVER HOVER. The phone is the primary device and hover does not
      exist there — a hover-only dropdown is simply unreachable.

      ⚠️ NO LAYOUT SHIFT, AND NO NO-JS TRAP. Panels are hidden by CSS gated on
      `html.js`, exactly as the theme toggle and the scroll reveals are. Without
      JS every link renders, visible. With JS they are hidden from the FIRST
      paint, so nothing flashes open and then collapses.
    */}
    <nav class="site-nav" aria-label={t('nav.label')}>
      <ul class="nav-root">
        <li>
          <a
            href={localizePath('/', locale)}
            aria-current={current === '/' ? 'page' : undefined}
            class:list={['nav-link', { 'is-current': current === '/' }]}
          >
            {t('nav.home')}
          </a>
        </li>
        {
          NAV_GROUPS.map((group) => {
            const inSection = group.items.some((i) => current === i.path);
            const panelId = `nav-group-${group.id}`;
            return (
              <li class="nav-group" data-nav-group>
                <button
                  type="button"
                  class:list={['nav-toggle', { 'is-current': inSection }]}
                  aria-expanded="false"
                  aria-controls={panelId}
                  data-nav-toggle
                >
                  {t(group.key)}
                  <span class="nav-chevron" aria-hidden="true" />
                </button>
                <ul class="nav-panel" id={panelId} data-nav-panel>
                  {group.items.map((item) => (
                    <li>
                      <a
                        href={localizePath(item.path, locale)}
                        aria-current={current === item.path ? 'page' : undefined}
                        class:list={['nav-link', { 'is-current': current === item.path }]}
                      >
                        {t(item.key)}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            );
          })
        }
        {/*
          ⚠️ TOP-LEVEL, NOT IN A GROUP AND NOT IN THE TOOLS CLUSTER.

          `/progres/` was reachable from the mobile bottom bar and from NOWHERE
          on desktop — a route that existed on one layout only, which is the
          same defect as an index card with no destination (Critical Feature
          32): the page is fine, the way in is missing, and nothing errors.

          Three placements were possible and two are wrong:

          - **Inside a nav group.** It is not "Apprendre" (nothing to read) and
            not "S'entraîner" (nothing to do); it is about the READER. Filing
            it under a content section is the same category error CLAUDE.md
            already rejects for putting settings under "Le club".
          - **In the header-tools cluster.** Those are PREFERENCE controls —
            theme, language, settings — and they are icon-only. Progress is not
            a preference, it is a destination you return to and read, and it
            deserves a name rather than a glyph. See SettingsLink for the
            reasoning this mirrors.
          - **Top-level, beside Accueil.** What ships. The nav root already
            carries one plain link, so this is not a new shape; it is a link
            rather than a disclosure, so it adds no fourth panel; and it sits
            last, exactly where the bottom bar puts it.

          The label is `nav.progress` — the SAME key the bar uses. Two names for
          one destination reads as two different sites (Critical Feature 20),
          and until now that key had only one caller.
        */}
        <li>
          <a
            href={localizePath('/progres/', locale)}
            aria-current={current === '/progres/' ? 'page' : undefined}
            class:list={['nav-link', { 'is-current': current === '/progres/' }]}
            data-testid="header-progress"
          >
            {t('nav.progress')}
          </a>
        </li>
      </ul>
    </nav>

    <div class="header-tools">
      <AccountButton locale={locale} />
      {/* ⚠️ DESKTOP ONLY. On a phone the header is one line — name plus theme
          plus language — and settings is reachable from the bottom bar's
          sections and the footer. Adding a fourth icon to a 390px line is
          exactly the crowding M1 exists to undo. See SettingsLink for why it
          sits here rather than in the "Le club" nav group. */}
      <span class="tools-desktop">
        <SettingsLink locale={locale} current={current === '/parametres/'} />
      </span>
      <ThemeToggle locale={locale} />
      {/* ⚠️ OMITTED ON A SINGLE-LOCALE PAGE (v2-S4). `/admin*` is French only,
          so there is no counterpart to switch to and the switcher would offer a
          one-way trip to a 404. It is omitted rather than disabled: a control
          that is present and does nothing is worse than one that is absent. */}
      {!singleLocale && <LangSwitcher locale={locale} pathname={pathname} />}
    </div>
  </div>
</header>

<script is:inline>
  /**
   * Disclosure navigation. ~40 lines, no framework — the board is still the
   * only hydrated component on the site.
   *
   * `is:inline` so the header is interactive on the first paint rather than
   * after a module round-trip.
   */
  (function () {
    try {
      var groups = [].slice.call(document.querySelectorAll('[data-nav-group]'));
      if (!groups.length) return;

      function close(group) {
        group.removeAttribute('data-open');
        var btn = group.querySelector('[data-nav-toggle]');
        if (btn) btn.setAttribute('aria-expanded', 'false');
      }
      function closeAll(except) {
        groups.forEach(function (g) {
          if (g !== except) close(g);
        });
      }

      groups.forEach(function (group) {
        var btn = group.querySelector('[data-nav-toggle]');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var open = group.hasAttribute('data-open');
          /* One panel at a time: two open panels overlap on a narrow screen. */
          closeAll(group);
          if (open) {
            close(group);
          } else {
            group.setAttribute('data-open', '');
            btn.setAttribute('aria-expanded', 'true');
          }
        });
      });

      /* Escape closes and RETURNS FOCUS to the button that opened the panel —
         without that a keyboard reader is dropped at the top of the document. */
      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        var open = document.querySelector('[data-nav-group][data-open]');
        if (!open) return;
        var btn = open.querySelector('[data-nav-toggle]');
        close(open);
        if (btn) btn.focus();
      });

      /* A click anywhere else closes. Uses the captured target rather than
         relatedTarget so it works for touch as well as mouse. */
      document.addEventListener('click', function (e) {
        var inside = e.target && e.target.closest && e.target.closest('[data-nav-group]');
        if (!inside) closeAll(null);
      });

      /* Tabbing out of a group closes it — otherwise a panel stays open behind
         the reader as they move on through the page. */
      document.addEventListener('focusin', function (e) {
        var inside = e.target && e.target.closest && e.target.closest('[data-nav-group]');
        if (!inside) closeAll(null);
      });
    } catch (e) {
      /* A broken menu must never be a menu you cannot use: with no JS at all
         the CSS gate below leaves every panel visible. */
    }
  })();
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--mcc-border-on-inverse);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    padding-block: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    margin-inline-end: auto;
  }

  .brand-mark {
    display: block;
    border-radius: 6px;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .header-tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* ══ THE MOBILE HEADER IS ONE LINE (M1) ═══════════════════════════════
     Direction: mcc-direction-mobile-app.md § 1. Below 768px the header was
     eating a third of the screen — logo, four nav groups, two setting
     buttons — and then the menu below it repeated the same entries.

     What survives on a phone: the club name, the theme toggle, the language
     switcher. Navigation moved to the bottom bar, where the thumb is.

     ⚠️ `display: none` on the nav, NOT a visually-hidden class. These links
     are all reachable from the bottom bar and the pages it leads to, so
     leaving them in the a11y tree would give a screen-reader user two full
     navigations to walk past on every page. The bar carries `aria-label`
     and is the navigation on this breakpoint.

     ⚠️ Everything here is inside a max-width query. The desktop header is
     UNCHANGED — that is a regression guard in main-menu.spec.ts and
     mobile-app.spec.ts, not a style preference. */
  @media (max-width: 767.98px) {
    .site-nav,
    .tools-desktop {
      display: none;
    }

    .header-inner {
      /* One line: name left, tools right. */
      gap: 0.5rem;
      padding-block: 0.5rem;
    }

    .brand-mark {
      width: 28px;
      height: 28px;
    }

    .brand-name {
      font-size: 1rem;
    }
  }

  /* ── Grouped navigation ─────────────────────────────────────────────
     Seven flat links had outgrown one row, especially on a phone where they
     wrapped into a block nobody could scan. Three disclosure groups. */

  .nav-root {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-group {
    position: relative;
  }

  .nav-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0;
    border: 0;
    background: none;
    color: var(--mcc-text-inverse);
    font: inherit;
    font-size: 0.9375rem;
    cursor: pointer;
  }

  .nav-toggle:hover {
    color: var(--mcc-accent-on-inverse);
  }

  .nav-toggle:focus-visible,
  .nav-root a:focus-visible {
    outline: 2px solid var(--mcc-focus-ring-inverse);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* Current SECTION, not current page — the group whose contents you are in. */
  .nav-toggle.is-current {
    color: var(--mcc-accent-on-inverse);
    font-weight: 600;
  }

  .nav-chevron {
    width: 0.4em;
    height: 0.4em;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-0.15em) rotate(45deg);
    /* The chevron answers the click, so it is a Réponse — faster than the
       panel it labels. Both start together; the arrow lands first. */
    transition: transform var(--motion-response) var(--ease-response);
  }

  .nav-panel {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ⚠️ THE GATE. Panels are open by default so a reader without JavaScript
     gets every link. `html.js` is set by the inline head script BEFORE
     <body> exists, so with JS they are closed from the first paint and
     nothing flashes open then collapses. Same mechanism as the theme
     toggle and the scroll reveals. */
  :global(html.js) .nav-panel {
    display: none;
  }

  :global(html.js) .nav-group[data-open] .nav-panel {
    display: flex;
    /* Absolute so opening a panel cannot push the page around — the
       no-layout-shift requirement. */
    position: absolute;
    z-index: 20;
    top: calc(100% + 0.35rem);
    left: 0;
    min-width: max-content;
    padding: 0.5rem;
    border: 1px solid var(--mcc-border-on-inverse);
    border-radius: var(--radius-card);
    background-color: var(--mcc-surface-inverse);
    box-shadow: 0 8px 24px rgb(0 0 0 / 25%);
    /* Transition family: a panel opening is a visible state change.

       An ANIMATION, not a transition, and that is forced rather than chosen —
       the panel is gated by `display`, which no transition can interpolate.
       (`transition-behavior: allow-discrete` plus `@starting-style` would do
       it, but the support floor is higher than this project's and the failure
       mode is a panel that never appears.) An animation simply runs when the
       element becomes displayed, which is exactly the moment we want it. */
    animation: mcc-panel-in var(--motion-transition) var(--ease-transition);
    transform-origin: top center;
  }

  @keyframes mcc-panel-in {
    from {
      opacity: 0;
      transform: translateY(-0.35rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  :global(html.js) .nav-group[data-open] .nav-chevron {
    transform: translateY(0.1em) rotate(-135deg);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .nav-group[data-open] .nav-panel {
      animation: none;
    }
  }

  .nav-panel a {
    display: block;
    padding: 0.4rem 0.6rem;
    border-radius: 4px;
    white-space: nowrap;
  }

  .nav-panel a:hover {
    background-color: var(--mcc-border-on-inverse);
  }

  .nav-link {
    display: inline-block;
    padding-block: 0.25rem;
    font-size: 0.9375rem;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  .nav-link:hover {
    border-bottom-color: var(--mcc-accent-on-inverse);
  }

  /* The current page is marked with colour AND a rule — colour alone would
     leave it unmarked for anyone who cannot distinguish brass from cream. */
  .nav-link.is-current {
    color: var(--mcc-accent-on-inverse);
    border-bottom-color: var(--mcc-accent-on-inverse);
  }
</style>
