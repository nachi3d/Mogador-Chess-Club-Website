---
/**
 * THE PROFILES BLOCK — the top of `/compte/`, and the page's subject.
 *
 * ═════════════════════════════════════════════════════════════════════════
 * ⚠️ THIS IS WHAT A READER CAME FOR, SO IT IS FIRST AND IT CARRIES NUMBERS.
 *
 * `/compte/` used to be one flat column in which the account's email address,
 * the interface language and permanent deletion all had exactly the same weight
 * as the children's progress. Ordering by what a reader came for puts the
 * profiles at the top, the settings behind a disclosure, and deletion behind a
 * second one.
 *
 * ⚠️ THE VOCABULARY COMES FROM THE ANSWER GIVEN AT `/bienvenue/`, resolved by
 * `effectiveShape()` — « votre profil » / « vos enfants » / both / neutral. It
 * is NOT inferred from the roster's size, because a lone profile is genuinely
 * ambiguous (Critical Feature 40) and guessing is what Critical Feature 54
 * forbids. An account that skipped the question keeps the neutral,
 * structure-naming copy, which is true for every reader.
 *
 * ⚠️ TWO RULES, AND COUPLING THEM IS THE BUG THIS FILE EXISTS TO HAVE FIXED.
 *
 * 1. THE SECTION RENDERS FOR EVERY SIGNED-IN ACCOUNT. Adding, renaming and
 *    removing a profile are things a parent does with one child exactly as
 *    much as with three.
 * 2. THE PICKER — "Qui joue ?" — IS THE CONDITIONAL HALF, and only it. Above
 *    one profile there is genuinely nothing to ask: `resolveChild()` adopts a
 *    lone profile silently, which is the autonomous-teenager path.
 *
 * Until v0.11.x these were one rule. The whole section was hidden whenever the
 * account held one profile or none — and a brand-new account is given exactly
 * one — so the add form was invisible to every account that had never had a
 * second profile inserted by SQL. RLS permitted the insert throughout; the form
 * was simply unreachable, and nothing in the suite looked for it.
 *
 * ⚠️ THE ROSTER AND THE PICKER ARE TWO LISTS OF THE SAME NAMES, ON PURPOSE.
 * The picker is tapped by a child on a shared family tablet. "Retirer" must not
 * sit beside the button they are aiming for.
 *
 * ⚠️ A CHOICE, NOT A PASSWORD. There is no PIN, no lock and no "are you sure"
 * on the picker (Critical Feature 42). The account is the security boundary.
 * The two-step confirm on REMOVAL is a different thing entirely — that one
 * erases a profile's whole history by cascade.
 *
 * ⚠️ EVERY NUMBER ON A CARD IS DERIVED BY `computeLedger()`, THE ONE SUMMATION
 * (Critical Feature 47). Nothing here stores or fetches a total; the rows come
 * from `exercise_progress`, `game_results` and `point_awards`, and the same
 * function a prof's screen uses turns them into points and a rank. A parent and
 * a prof reading different totals is the worst failure a progression display
 * can have, because both numbers look plausible.
 *
 * ⚠️ THE ROWS ARE FETCHED IN THREE REQUESTS, NOT THREE PER PROFILE. RLS filters
 * to this account either way; the shape of the query is a latency decision on a
 * phone, not a security one. Same reasoning as `listProgress()` in `admin.ts`.
 *
 * ⚠️ IT MUST NOT IMPORT `@lib/admin`. That module statically imports
 * `@lib/supabase`, which is safe under `/admin*` and would break the guest
 * zero-request rule everywhere else. The queries below are deliberately its
 * twins rather than its callers.
 *
 * ⚠️ UNREACHABLE WITH THE FLAG OFF. `/compte/` is not emitted at all when
 * `PUBLIC_AUTH_ENABLED` is unset, so a guest never renders a byte of this.
 * ═════════════════════════════════════════════════════════════════════════
 */
import type { Locale } from '@config/site';
import { useTranslations } from '@i18n/ui';
import { scoreCatalogue } from '@lib/scoreboard';
/* ⚠️ A REAL STYLESHEET, NOT A SCOPED `<style>`. Every card below is built at
   runtime and would not carry Astro's build-time scoping attribute. See the
   header of `family.css` — this had already silently killed the picker's own
   button styling. */
import '@styles/family.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/* ⚠️ THE POLICY IS DATA, COMPUTED AT BUILD TIME. No award value, threshold or
   condition is written in the script below — `scoreboard.ts` derives all of it
   from `points.ts`, exactly as `/progres/` and the admin surfaces do. The
   achievements are dropped: this block shows a rank and a total, and shipping
   the achievement definitions to a page that never draws them is pure weight. */
const full = await scoreCatalogue(locale);
const catalogue = {
  entries: full.entries,
  wins: full.wins,
  winCap: full.winCap,
  ranks: full.ranks,
};

const rankLabels: Record<string, string> = {
  pion: t('score.rank.pion'),
  cavalier: t('score.rank.cavalier'),
  fou: t('score.rank.fou'),
  tour: t('score.rank.tour'),
  dame: t('score.rank.dame'),
};
---

<section
  class="family"
  data-testid="family"
  data-shape="unknown"
  data-msg-add-error={t('child.addError')}
  data-msg-add-label={t('child.addLabel')}
  data-msg-add-label-child={t('child.addLabelChild')}
  data-msg-rename={t('family.rename')}
  data-msg-rename-label={t('family.renameLabel')}
  data-msg-rename-error={t('family.renameError')}
  data-msg-save={t('family.save')}
  data-msg-cancel={t('family.cancel')}
  data-msg-remove={t('family.remove')}
  data-msg-remove-confirm={t('family.removeConfirm')}
  data-msg-remove-yes={t('family.removeYes')}
  data-msg-remove-error={t('family.removeError')}
  data-msg-only-child={t('family.onlyChild')}
  data-msg-you={t('profiles.you')}
  data-msg-you-label={t('profiles.youLabel')}
  data-msg-points={t('profiles.points')}
  data-msg-solved={t('profiles.solved')}
  data-msg-loading={t('profiles.loading')}
  data-msg-mark-self={t('profiles.markSelf')}
  data-msg-mark-self-label={t('profiles.markSelfLabel')}
  data-msg-mark-self-error={t('profiles.markSelfError')}
  data-msg-next={t('score.next')}
  data-msg-top={t('score.top')}
  data-head-self={t('profiles.heading.self')}
  data-head-children={t('profiles.heading.children')}
  data-head-both={t('profiles.heading.both')}
  data-head-unknown={t('profiles.heading.unknown')}
  data-intro-self={t('profiles.intro.self')}
  data-intro-children-one={t('profiles.intro.childrenOne')}
  data-intro-children-many={t('profiles.intro.childrenMany')}
  data-intro-both={t('profiles.intro.both')}
  data-intro-unknown-one={t('profiles.intro.unknownOne')}
  data-intro-unknown-many={t('profiles.intro.unknownMany')}
  hidden
>
  {/* ⚠️ THE POLICY AND THE LABELS RIDE AS JSON, NOT AS A BUNDLED IMPORT.
      `scoreboard.ts` imports `astro:content` and chess.js; pulling it into a
      page script would put the whole content collection into this page's
      chunk. Same seam `/progres/` and `/admin/eleves/` use. */}
  <script type="application/json" data-ledger-catalogue set:html={JSON.stringify(catalogue)} />
  <script type="application/json" data-rank-labels set:html={JSON.stringify(rankLabels)} />

  {/* ⚠️ SERVER-RENDERED NEUTRAL, SWAPPED ONCE THE SHAPE IS KNOWN. A static page
      cannot know how an account answered, and the text has to read correctly
      for the half-second before it is replaced. The neutral register is the one
      that is true in every case, which is exactly why it is the fallback. */}
  <h2 data-testid="profiles-heading">{t('profiles.heading.unknown')}</h2>
  <p class="family-intro" data-testid="family-intro">{t('profiles.intro.unknownOne')}</p>

  {/* ── The roster. Always. ──────────────────────────────────────────────── */}
  <ul class="child-roster" data-testid="child-roster"></ul>

  {/* ── The conditional half. Hidden at one profile, and ONLY this part. ─── */}
  <div class="child-picker" data-testid="child-picker" hidden>
    <h3>{t('child.heading')}</h3>
    <p class="child-intro">{t('child.intro')}</p>
    <ul class="child-list" data-testid="child-list"></ul>
  </div>

  <form class="child-add" data-testid="child-add">
    <label for="child-name" data-testid="child-add-label">{t('child.addLabel')}</label>
    <input id="child-name" type="text" maxlength="40" autocomplete="off" data-testid="child-name" />
    {/* ⚠️ `child-action` as well as `btn-ghost`: `controls.css` owns the 44px
        target and the press but sets no colour at all, and this button's only
        border used to come from a SCOPED rule that never matched it. It
        rendered borderless and un-inked. */}
    <button type="submit" class="btn-ghost child-action" data-testid="child-add-submit">
      {t('child.add')}
    </button>
  </form>
  <p class="child-status" role="status" data-testid="child-status"></p>
</section>

<script>
  /* ⚠️ Through `@lib/child` only for RESOLUTION. This surface never decides for
     itself who is playing — that rule lives in one file, exactly as the resume
     rule lives in `ResumeResolver`. A second copy is how two surfaces come to
     disagree about who is playing. The plain `child_profiles` reads and writes
     below are roster management, which is not resolution. */
  import {
    CHILD_EVENT,
    activeChild,
    chooseChild,
    fetchChildren,
    forgetChild,
    pendingChoices,
    resolveChild,
    type Child,
  } from '@lib/child';
  import { effectiveShape, type EffectiveShape } from '@lib/account-shape';
  import { computeLedger, type LedgerCatalogue } from '@lib/ledger';

  const root = document.querySelector('[data-testid="family"]') as HTMLElement | null;
  const heading = document.querySelector('[data-testid="profiles-heading"]') as HTMLElement | null;
  const picker = document.querySelector('[data-testid="child-picker"]') as HTMLElement | null;
  const list = document.querySelector('[data-testid="child-list"]') as HTMLElement | null;
  const roster = document.querySelector('[data-testid="child-roster"]') as HTMLElement | null;
  const form = document.querySelector('[data-testid="child-add"]') as HTMLFormElement | null;
  const addLabel = document.querySelector('[data-testid="child-add-label"]') as HTMLElement | null;
  const input = document.querySelector('[data-testid="child-name"]') as HTMLInputElement | null;
  const status = document.querySelector('[data-testid="child-status"]') as HTMLElement | null;
  const intro = document.querySelector('[data-testid="family-intro"]') as HTMLElement | null;

  const json = <T,>(selector: string, fallback: T): T => {
    const node = document.querySelector(selector);
    if (!node?.textContent) return fallback;
    try {
      return JSON.parse(node.textContent) as T;
    } catch {
      return fallback;
    }
  };

  const catalogue = json<LedgerCatalogue>('[data-ledger-catalogue]', {
    entries: [],
    wins: {},
    winCap: 0,
    ranks: [],
  });
  const rankLabels = json<Record<string, string>>('[data-rank-labels]', {});

  /** One profile's derived standing. Never stored, never fetched as a total. */
  interface Standing {
    readonly points: number;
    readonly solved: number;
    readonly rank: string;
    readonly next: string | null;
    readonly remaining: number;
    readonly progress: number;
  }

  let accountId = '';
  let children: Child[] = [];
  let active: Child | null = null;
  let shape: EffectiveShape = 'unknown';
  let standings = new Map<string, Standing>();

  /**
   * ⚠️ TWO LOADS ARE ROUTINELY IN FLIGHT, AND THEY CAN LAND OUT OF ORDER.
   *
   * `resolveChild()` adopts or creates a profile and fires `CHILD_EVENT`, whose
   * listener re-enters `load()` — so the very first paint already has a second
   * read behind it, and an add, a rename or a removal starts another. Whichever
   * finishes last wins, which is not the same as the newest one winning: an
   * older read that was issued before an insert committed will happily repaint
   * the roster as it was, and the section then shows a list the database has
   * already moved past.
   *
   * The counter is what makes "newest wins" true. It is not defensive
   * decoration — it is the fix for a measured failure: under the full spec
   * fan-out a removal left one name on screen and two rows in the table.
   */
  let generation = 0;

  /**
   * ⚠️ THE PROFILE WHOSE ROW IS MID-EDIT, AND WHY REPAINTING IT IS FORBIDDEN.
   *
   * A background refresh landing while a parent is halfway through typing a new
   * name replaces the input under them and loses what they wrote — measured as
   * `element was detached from the DOM` before it was understood as a defect.
   * Worse for a removal: the confirm they are reading is swapped for a fresh
   * "Retirer" in the same place, under a thumb already moving.
   *
   * Whatever ends the edit calls `load()` itself, so nothing goes stale.
   */
  let editing: string | null = null;

  const msg = (key: string) => root?.dataset[key] ?? '';

  function setStatus(text: string) {
    if (status) status.textContent = text;
  }

  function button(label: string, testid: string, extra = ''): HTMLButtonElement {
    const el = document.createElement('button');
    el.type = 'button';
    /* ⚠️ `.btn-ghost` carries the 44px target and the press from controls.css.
       A bare class of our own would be under the touch target on every phone,
       which `motion.spec.ts` measures site-wide. */
    el.className = `btn-ghost child-action${extra ? ` ${extra}` : ''}`;
    el.textContent = label;
    el.dataset['testid'] = testid;
    return el;
  }

  /* ── "Qui joue ?" ──────────────────────────────────────────────────────── */

  function paintChoices() {
    if (!list) return;
    list.replaceChildren(
      ...children.map((child) => {
        const li = document.createElement('li');
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn-ghost child-choice';
        btn.textContent = child.name;
        btn.dataset['childId'] = child.id;
        /* ⚠️ `aria-pressed`, not a class alone — "which one is chosen" has to
           reach someone who cannot see the highlight. */
        btn.setAttribute('aria-pressed', String(active?.id === child.id));
        btn.addEventListener('click', () => {
          chooseChild(accountId, child);
          active = child;
          paint();
        });
        li.append(btn);
        return li;
      }),
    );
  }

  /* ── The roster, as cards ──────────────────────────────────────────────── */

  function paintRoster() {
    if (!roster) return;
    /* ⚠️ NEVER OVER A ROW THE READER IS IN THE MIDDLE OF. See `editing`. */
    if (editing) return;
    roster.replaceChildren(...children.map((child) => rosterRow(child)));
  }

  /** End an edit and redraw the row it was on, in one place. */
  function endEdit() {
    editing = null;
    paintRoster();
  }

  /**
   * ⚠️ THE STANDING IS DRAWN ONLY WHEN IT HAS ARRIVED, and its absence says so
   * rather than printing a zero. A card reading "0 points" for a profile whose
   * rows are still in flight is a lie a parent has no way to distinguish from
   * the truth — and Critical Feature 30 is the same rule for `/progres/`: never
   * print a number nothing computed.
   */
  function standingBlock(child: Child): HTMLElement {
    const wrap = document.createElement('div');
    wrap.className = 'child-standing';
    wrap.dataset['testid'] = 'child-standing';

    const standing = standings.get(child.id);
    if (!standing) {
      wrap.textContent = msg('msgLoading');
      wrap.classList.add('child-standing-loading');
      return wrap;
    }

    const rank = document.createElement('span');
    rank.className = 'child-rank';
    rank.dataset['testid'] = 'child-rank';
    rank.textContent = rankLabels[standing.rank] ?? standing.rank;

    const points = document.createElement('span');
    points.className = 'child-metric';
    points.dataset['testid'] = 'child-points';
    points.textContent = msg('msgPoints').replace('%s', String(standing.points));

    const solved = document.createElement('span');
    solved.className = 'child-metric';
    solved.textContent = msg('msgSolved').replace('%s', String(standing.solved));

    /* The bar is decoration over numbers that are already written out, so it is
       hidden from assistive tech rather than given a redundant label. */
    const bar = document.createElement('div');
    bar.className = 'child-bar';
    bar.setAttribute('aria-hidden', 'true');
    const fill = document.createElement('span');
    fill.className = 'child-bar-fill';
    fill.style.setProperty('--fill', `${Math.round(standing.progress * 100)}%`);
    bar.append(fill);

    const next = document.createElement('span');
    next.className = 'child-next';
    next.textContent = standing.next
      ? msg('msgNext')
          .replace('%s', String(standing.remaining))
          .replace('%s', rankLabels[standing.next] ?? standing.next)
      : msg('msgTop');

    wrap.append(rank, points, solved, bar, next);
    return wrap;
  }

  function rosterRow(child: Child): HTMLLIElement {
    const li = document.createElement('li');
    li.className = `child-row${child.isSelf ? ' child-row-self' : ''}`;
    li.dataset['childId'] = child.id;

    const head = document.createElement('div');
    head.className = 'child-row-head';

    const name = document.createElement('span');
    name.className = 'child-row-name';
    name.textContent = child.name;
    name.dataset['testid'] = 'child-row-name';
    head.append(name);

    /* ⚠️ THE HOLDER'S OWN CARD IS NAMED AS THEIRS. "Les deux" exists precisely
       so a parent who plays is not reading their own progress under a heading
       about their children. */
    if (child.isSelf) {
      const badge = document.createElement('span');
      badge.className = 'child-you';
      badge.dataset['testid'] = 'child-you';
      badge.textContent = msg('msgYou');
      badge.setAttribute('aria-label', msg('msgYouLabel'));
      head.append(badge);
    }

    const actions = document.createElement('div');
    actions.className = 'child-row-actions';

    const rename = button(msg('msgRename'), 'child-rename');
    /* Repeated per row, so the visible label alone is not a distinguishing
       accessible name. */
    rename.setAttribute('aria-label', `${msg('msgRename')} — ${child.name}`);
    rename.addEventListener('click', () => startRename(li, child));
    actions.append(rename);

    /**
     * ⚠️ THE ANSWER GIVEN AT SIGN-UP IS NOT A LIFE SENTENCE. A reader who said
     * "mon enfant" and later starts playing themselves has no other way to say
     * so, and re-running the welcome screen is not available (it is shown once,
     * per account, deliberately). One control, on the row that is theirs.
     *
     * Offered only where it would change something: never on a profile already
     * flagged, and never when another one is — moving it is a rename away from
     * being ambiguous, and `child_profiles_one_self_idx` would refuse the second
     * write anyway.
     */
    if (!child.isSelf && !children.some((c) => c.isSelf)) {
      const mine = button(msg('msgMarkSelf'), 'child-mark-self');
      mine.setAttribute('aria-label', msg('msgMarkSelfLabel').replace('%s', child.name));
      mine.addEventListener('click', () => void commitMarkSelf(child));
      actions.append(mine);
    }

    /**
     * ⚠️ NEVER THE LAST PROFILE, AND THAT IS NOT TIMIDITY. `resolveChild()`
     * creates one from the profile name the instant an account has none, so
     * "remove" on a lone profile is a lie: it comes straight back, renamed,
     * with its whole history gone by cascade. The button is absent rather than
     * disabled — a disabled control with no explanation reads as a bug.
     */
    if (children.length > 1) {
      const remove = button(msg('msgRemove'), 'child-remove');
      remove.setAttribute('aria-label', `${msg('msgRemove')} — ${child.name}`);
      remove.addEventListener('click', () => startRemove(li, child));
      actions.append(remove);
    } else {
      const note = document.createElement('span');
      note.className = 'child-note';
      note.dataset['testid'] = 'child-only';
      note.textContent = msg('msgOnlyChild');
      actions.append(note);
    }

    li.append(head, standingBlock(child), actions);
    return li;
  }

  /* ── Rename ────────────────────────────────────────────────────────────── */

  function startRename(li: HTMLLIElement, child: Child) {
    setStatus('');
    editing = child.id;
    const field = document.createElement('input');
    field.type = 'text';
    field.maxLength = 40;
    field.value = child.name;
    field.className = 'child-rename-input';
    field.autocomplete = 'off';
    field.dataset['testid'] = 'child-rename-input';
    field.setAttribute('aria-label', msg('msgRenameLabel').replace('%s', child.name));

    const save = button(msg('msgSave'), 'child-rename-save');
    const cancel = button(msg('msgCancel'), 'child-rename-cancel');
    save.addEventListener('click', () => void commitRename(child, field.value.trim()));
    cancel.addEventListener('click', () => endEdit());
    /* Enter is how a rename is finished by anyone who got here from the
       keyboard; Escape is how it is abandoned. Neither may submit the add
       form sitting below it. */
    field.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        void commitRename(child, field.value.trim());
      } else if (event.key === 'Escape') {
        event.preventDefault();
        endEdit();
      }
    });

    const actions = document.createElement('div');
    actions.className = 'child-row-actions';
    actions.append(save, cancel);
    li.replaceChildren(field, actions);
    field.focus();
    field.select();
  }

  async function commitRename(child: Child, name: string) {
    if (!name || name === child.name) {
      endEdit();
      return;
    }
    const { getSupabase } = await import('@lib/supabase');
    const supabase = await getSupabase();
    const { error } = await supabase
      .from('child_profiles')
      .update({ display_name: name })
      .eq('id', child.id);
    editing = null;
    if (error) {
      setStatus(msg('msgRenameError'));
      paintRoster();
      return;
    }
    /* ⚠️ The remembered choice carries the NAME as well as the id, so a rename
       that did not refresh it would leave this device's picker showing the old
       one until the entry was replaced for some other reason. */
    if (activeChild()?.id === child.id) {
      chooseChild(accountId, { id: child.id, name, isSelf: child.isSelf });
    }
    await load();
  }

  /* ── "C'est moi" ───────────────────────────────────────────────────────── */

  async function commitMarkSelf(child: Child) {
    setStatus('');
    const { getSupabase } = await import('@lib/supabase');
    const supabase = await getSupabase();
    const { error } = await supabase
      .from('child_profiles')
      .update({ is_self: true })
      .eq('id', child.id);
    if (error) {
      /* Also the answer on a database without 0010, where the column does not
         exist at all. Nothing was claimed and nothing changed. */
      setStatus(msg('msgMarkSelfError'));
      return;
    }
    await load();
  }

  /* ── Remove ────────────────────────────────────────────────────────────── */

  /**
   * ⚠️ TWO STEPS, IN PLACE — no modal, and no `window.confirm`.
   *
   * This is the one control on the site that destroys data a child earned:
   * `child_profiles` is the FK target for progress, games, attendance and
   * awards, all `on delete cascade`. The confirm therefore names the profile
   * and says what goes with it, rather than asking "are you sure?" about a row.
   */
  function startRemove(li: HTMLLIElement, child: Child) {
    setStatus('');
    editing = child.id;
    const question = document.createElement('span');
    question.className = 'child-row-name';
    question.dataset['testid'] = 'child-remove-question';
    question.textContent = msg('msgRemoveConfirm').replace('%s', child.name);

    const yes = button(msg('msgRemoveYes'), 'child-remove-confirm', 'child-action-danger');
    const no = button(msg('msgCancel'), 'child-remove-cancel');
    yes.addEventListener('click', () => void commitRemove(child));
    no.addEventListener('click', () => endEdit());

    const actions = document.createElement('div');
    actions.className = 'child-row-actions';
    actions.append(yes, no);
    li.replaceChildren(question, actions);
    /* The confirm takes focus, so the keyboard path does not have to hunt for
       the control the click path just revealed. */
    yes.focus();
  }

  async function commitRemove(child: Child) {
    const { getSupabase } = await import('@lib/supabase');
    const supabase = await getSupabase();
    const { error } = await supabase.from('child_profiles').delete().eq('id', child.id);
    editing = null;
    if (error) {
      setStatus(msg('msgRemoveError'));
      paintRoster();
      return;
    }
    /* ⚠️ The device's remembered choice goes with it. Left behind, resolution
       keeps handing progress to a child id RLS now refuses, and the offline
       queue never drains — the same re-validation `resolveChild()` does for a
       graduated child, done here because we already know. */
    if (activeChild()?.id === child.id) {
      forgetChild(accountId);
      active = null;
    }
    await load();
  }

  /* ── Load and paint ────────────────────────────────────────────────────── */

  function paint() {
    if (!root) return;
    /* ⚠️ THE TWO RULES, SPELLED SEPARATELY. Signed in ⇒ the section. More than
       one profile ⇒ the picker as well. Anything that re-couples these puts the
       add form back out of reach. */
    root.hidden = false;
    root.dataset['shape'] = shape;
    if (picker) picker.hidden = children.length <= 1;
    paintVocabulary();
    paintChoices();
    paintRoster();
  }

  /**
   * ⚠️ THE HEADING, THE INTRO AND THE ADD LABEL ALL COME FROM ONE DECISION.
   *
   * Splitting them is how a page ends up headed « Vos enfants » with a button
   * reading « Ajouter un profil » underneath it. `effectiveShape()` is the only
   * thing that decides, and it decides once.
   */
  function paintVocabulary() {
    const many = children.length > 1;
    const headKey =
      shape === 'self'
        ? 'headSelf'
        : shape === 'children'
          ? 'headChildren'
          : shape === 'both'
            ? 'headBoth'
            : 'headUnknown';
    if (heading) heading.textContent = msg(headKey);

    let text: string;
    if (shape === 'self') text = msg('introSelf');
    else if (shape === 'both') text = msg('introBoth');
    else if (shape === 'children') {
      text = many
        ? msg('introChildrenMany').replace('%s', String(children.length))
        : msg('introChildrenOne');
    } else {
      text = many
        ? msg('introUnknownMany').replace('%s', String(children.length))
        : msg('introUnknownOne');
    }
    if (intro) intro.textContent = text;

    /* ⚠️ « Ajouter un enfant » ONLY WHERE IT IS TRUE. On an account that never
       answered the question, what is being added is a profile — calling it a
       child would be the same guess Critical Feature 54 forbids. */
    if (addLabel) {
      addLabel.textContent = msg(shape === 'unknown' ? 'msgAddLabel' : 'msgAddLabelChild');
    }
  }

  /**
   * Every profile's standing, from three requests.
   *
   * ⚠️ FAILS QUIET AND LEAVES THE MAP EMPTY. A card whose rows did not arrive
   * says so (see `standingBlock`); it does not print a zero, and it does not
   * stop the roster, the rename form or the add form from working. Progress is
   * the reason a parent opened the page, and managing profiles is what the page
   * is FOR — the second must not be taken out by a failure of the first.
   */
  async function loadStandings(supabase: any, ids: readonly string[]) {
    if (ids.length === 0) return;
    const [progress, games, awards] = await Promise.all([
      supabase.from('exercise_progress').select('child_id,exercise_slug,solved,hint_used'),
      supabase.from('game_results').select('child_id,level,outcome'),
      supabase.from('point_awards').select('child_id,points'),
    ]);

    const buckets = new Map<
      string,
      {
        exercises: Record<string, { solved: boolean; hintUsed: boolean }>;
        games: Record<string, { wins: number }>;
        awards: { points: number }[];
      }
    >();
    const bucket = (id: string) => {
      let value = buckets.get(id);
      if (!value) {
        value = { exercises: {}, games: {}, awards: [] };
        buckets.set(id, value);
      }
      return value;
    };

    for (const row of progress.data ?? []) {
      bucket(String(row['child_id'])).exercises[String(row['exercise_slug'])] = {
        solved: row['solved'] === true,
        hintUsed: row['hint_used'] === true,
      };
    }
    for (const row of games.data ?? []) {
      const value = bucket(String(row['child_id']));
      const level = (value.games[String(row['level'])] ??= { wins: 0 });
      /* ⚠️ Wins only. A loss costs nothing, ever (Critical Feature 35). */
      if (row['outcome'] === 'win') level.wins += 1;
    }
    for (const row of awards.data ?? []) {
      bucket(String(row['child_id'])).awards.push({ points: Number(row['points'] ?? 0) });
    }

    const next = new Map<string, Standing>();
    for (const id of ids) {
      const value = buckets.get(id);
      const ledger = computeLedger(catalogue, {
        exercises: value?.exercises ?? {},
        games: value?.games ?? {},
        awards: value?.awards ?? [],
      });
      next.set(id, {
        points: ledger.points,
        solved: Object.values(value?.exercises ?? {}).filter((e) => e.solved).length,
        rank: ledger.rank,
        next: ledger.next,
        remaining: ledger.remaining,
        progress: ledger.progress,
      });
    }
    standings = next;
  }

  async function load() {
    const mine = ++generation;
    const { getUser, getSupabase, getProfile } = await import('@lib/supabase');
    const user = await getUser();
    if (!user) return;
    accountId = user.id;

    /* Resolution decides silently where it can; only what it could not decide
       comes back in `pendingChoices()`. */
    const resolved = (await resolveChild()) ?? activeChild();
    const supabase = await getSupabase();
    const [rows, profile] = await Promise.all([
      fetchChildren(supabase, user.id),
      getProfile(),
    ]);

    /* ⚠️ A NEWER LOAD HAS ALREADY ANSWERED — drop this one rather than paint
       over it. See `generation`: this read may have been issued before an
       insert or a delete that has since committed, and last-to-finish is not
       the same as most-recent. */
    if (mine !== generation) return;

    active = resolved;
    children = rows && rows.length > 0 ? rows : [...pendingChoices()];
    shape = effectiveShape({ answer: profile?.account_shape ?? null, children });

    /* ⚠️ PAINTED BEFORE THE NUMBERS ARRIVE, THEN AGAIN AFTER. The roster is the
       page's subject and it must not wait on three progress queries; the cards
       say "Chargement…" for as long as that honestly takes. */
    paint();

    await loadStandings(supabase, children.map((c) => c.id));
    if (mine !== generation) return;
    paintRoster();
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const name = (input?.value ?? '').trim();
    if (!name) return;
    const { getSupabase } = await import('@lib/supabase');
    const supabase = await getSupabase();
    const { error } = await supabase
      .from('child_profiles')
      .insert([{ account_id: accountId, display_name: name }]);
    if (error) {
      setStatus(msg('msgAddError'));
      return;
    }
    if (input) input.value = '';
    setStatus('');
    await load();
  });

  window.addEventListener(CHILD_EVENT, () => void load());
  void load();
</script>
