---
/**
 * Level badge (débutant / intermédiaire / avancé).
 *
 * Fills only — the level colours are mid-tones and fail AA as text, so every
 * badge carries an ink-950 label on its fill. See the brass contrast rule in
 * tokens.css; the same reasoning applies here.
 */
import type { Locale } from '@config/site';
import { LEVEL_KEYS, useTranslations } from '@i18n/ui';

interface Props {
  locale: Locale;
  level: keyof typeof LEVEL_KEYS;
}

const { locale, level } = Astro.props;
const t = useTranslations(locale);
---

<span class:list={['level-badge', `level-${level}`]}>
  <span class="sr-only">{t('level.label')}:</span>
  {t(LEVEL_KEYS[level])}
</span>

<style>
  .level-badge {
    display: inline-block;
    padding: 0.15rem 0.6rem;
    border-radius: var(--radius-pill);
    color: var(--color-ink-950);
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .level-debutant {
    background-color: var(--mcc-level-debutant);
  }
  .level-intermediaire {
    background-color: var(--mcc-level-intermediaire);
  }
  .level-avance {
    background-color: var(--mcc-level-avance);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
