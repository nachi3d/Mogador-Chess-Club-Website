---
/**
 * Site footer — venue, association credit, Nachi3D Labs credit.
 *
 * PORTABILITY: the venue block reads `site.venue` and renders NOTHING when the
 * club has no fixed venue, or when the address is not marked public. No venue
 * string appears anywhere in this file. (CLAUDE.md → Critical Features.)
 */
import type { Locale } from '@config/site';
import { site, hasVenue, venueAddress } from '@config/site';
import { useTranslations } from '@i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const address = venueAddress();
const showVenue = hasVenue();
const year = new Date().getFullYear();
---

<footer class="surface-inverse site-footer">
  <div class="container-page footer-inner">
    {
      showVenue && (
        <section class="footer-block">
          <h2>{t('venue.heading')}</h2>
          {/* `venueAddress()` already joins name + address + city + country;
              the map link must not repeat it. */}
          <p>{address ?? `${site.venue.city}, ${site.venue.country}`}</p>
          {site.venue.mapUrl && (
            <p>
              <a href={site.venue.mapUrl} rel="noopener noreferrer" target="_blank">
                {t('venue.map')}
              </a>
            </p>
          )}
        </section>
      )
    }

    <section class="footer-block">
      <h2>{t('footer.association')}</h2>
      <p>
        <a href={site.association.url} rel="noopener noreferrer" target="_blank">
          {site.association.name}
        </a>
      </p>
      <p class="muted">{site.association.handle}</p>
    </section>

    <section class="footer-block">
      <h2>{site.name}</h2>
      <p class="muted">{site.tagline[locale]}</p>
    </section>
  </div>

  <div class="container-page footer-credit">
    <p>
      {site.credit.text[locale]}{' '}
      <a href={site.credit.url} rel="noopener noreferrer" target="_blank">{site.credit.label}</a>
    </p>
    <p class="muted">© {year} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--mcc-section-gap);
    padding-block: 2.5rem 1.5rem;
    border-top: 4px solid var(--color-brass-600);
  }

  .footer-inner {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }

  .footer-block h2 {
    margin: 0 0 0.5rem;
    color: var(--mcc-accent-on-inverse);
    font-size: 0.8125rem;
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-block p {
    margin: 0 0 0.35rem;
    font-size: 0.9375rem;
  }

  /* green-300 on green-800 = 5.16:1 — verified in scripts/check-contrast.mjs. */
  .muted {
    color: var(--mcc-text-on-inverse-muted);
  }

  .footer-credit {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-green-900);
    font-size: 0.875rem;
  }

  .footer-credit p {
    margin: 0;
  }
</style>
