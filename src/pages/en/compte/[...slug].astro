---
/**
 * /en/compte/ — emitted ONLY when accounts are enabled.
 *
 * ⚠️ THE REST PARAMETER IS WHY THIS FILE HAS A STRANGE NAME.
 *
 * Astro's static build has no "skip this page" switch on a plain `.astro`
 * route: if the file exists, the page is emitted. A DYNAMIC route decides for
 * itself, so `getStaticPaths()` returning `[]` emits nothing at all and the URL
 * 404s exactly as an unwritten URL does. `{ params: { slug: undefined } }`
 * produces `/en/compte/` itself and nothing below it.
 *
 * See `src/config/auth.ts` for why the flag exists and what OFF guarantees.
 */
import { AUTH_ENABLED } from '@config/auth';
import AccountPage from '@components/pages/AccountPage.astro';

export function getStaticPaths() {
  return AUTH_ENABLED ? [{ params: { slug: undefined } }] : [];
}
---

<AccountPage locale="en" />
