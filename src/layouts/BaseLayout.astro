---
/**
 * The one page shell. Every route renders through it.
 *
 * Responsibilities: <head> (title, canonical, hreflang alternates, PWA tags),
 * the header/footer chrome, the skip link, and service-worker registration.
 */
import type { Locale } from '@config/site';
import { site, LOCALES } from '@config/site';
import { SITE_THEMES, DEFAULT_SITE_THEME } from '@config/site-themes';
import { alternatePath, stripLocale } from '@i18n/paths';
import { useTranslations } from '@i18n/ui';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import MobileNav from '@components/MobileNav.astro';
import Analytics from '@components/Analytics.astro';
import '@styles/global.css';

interface Props {
  locale: Locale;
  /** Page title WITHOUT the site name — the shell appends it. */
  title: string;
  description?: string;
  /**
   * Opt this page into scroll reveals for its `[data-reveal]` elements.
   *
   * OFF by default, and deliberately not automatic. Board detail pages must not
   * have it: the board is the content there, and fading it in delays the one
   * thing the reader came for. Home and the index pages set it.
   *
   * Setting it does two things — marks the body so the CSS gate opens (see
   * `src/styles/motion.css`) and emits the observer below. Neither happens
   * otherwise, so an un-opted page carries no reveal cost at all.
   */
  reveals?: boolean;
  /**
   * This page mounts a chessboard.
   *
   * It becomes `data-board` on `<html>`, and the theme head script reads it to
   * decide whether to fetch the active theme's piece stylesheet. Pages without
   * a board — every index, the agenda, the legal notice — therefore fetch no
   * piece artwork at all, which is the whole reason the sets are split into one
   * file each. See `scripts/build-pieces.mjs`.
   *
   * ⚠️ A BOARD PAGE THAT FORGETS THIS RENDERS AN EMPTY BOARD: squares, no
   * pieces. `tests/e2e/themes.spec.ts` walks every route that mounts a board
   * and asserts the attribute is present, so it cannot be forgotten silently.
   */
  board?: boolean;
  /**
   * This page shows the piece-set previews (only `/parametres/`).
   *
   * Loads `/pieces/preview.css` — four knights, ~3 KB — rather than four full
   * sets, which would be ~32 KB brotli to draw four glyphs.
   */
  piecePreviews?: boolean;
}

const {
  locale,
  title,
  description,
  reveals = false,
  board = false,
  piecePreviews = false,
} = Astro.props;

/**
 * The theme table, handed to the inline script by `define:vars`.
 *
 * ⚠️ THIS IS WHY THE HEAD SCRIPT IS NOT A THIRD HAND-MAINTAINED COPY.
 *
 * The script cannot import `@config/site-themes` — that would reintroduce the
 * module fetch the whole anti-FOUC design exists to avoid. The theme script
 * already duplicates `applyTheme()` for that reason, and it says so. But the
 * *data* it needs (which board and which pieces each theme defaults to) does
 * not have to be duplicated: it is serialised in at build time from the one
 * source, so it cannot drift even in principle.
 *
 * Only the LOGIC is duplicated, and only because it must be.
 */
const THEME_TABLE = Object.fromEntries(
  SITE_THEMES.map((theme) => [
    theme.id,
    { board: theme.defaultBoard, pieces: theme.pieceSet, font: theme.fontFile },
  ]),
);

/* ============================================================================
   THE THEME HEAD SCRIPT — the full rationale lives HERE, not in the script.

   ⚠️ AN `is:inline` SCRIPT SHIPS VERBATIM, COMMENTS AND ALL, ON EVERY PAGE.
   Astro does not process it — that is the whole point of `is:inline` — so
   every line of explanation inside it is bytes in all 84 documents, before
   the first paint it is blocking. Written the way the rest of this codebase
   is commented it measured 8.4 KB per page; the notes are here instead, in
   frontmatter, which is compiled away. The script keeps short pointers back.

   WHY IT IS INLINE AT ALL. An external module would be fetched
   asynchronously, the page would paint in the default palette, and a
   dark-mode reader would get a white flash on every navigation. The cost is
   a little parse time before first paint, which is the correct trade.

   ⚠️ IT DUPLICATES `applyTheme()` FROM src/lib/theme.ts, deliberately, and
   the two must not drift. That module cannot run here — importing it would
   reintroduce the fetch this exists to avoid. The no-flash assertion in
   tests/e2e/theme.spec.ts is what catches a divergence.

   ⚠️ ONLY THE LOGIC IS DUPLICATED. The DATA — which board and which pieces
   each theme defaults to, and which font it preloads — is serialised in from
   `@config/site-themes` as `MCC_THEMES` via `define:vars`, so it cannot drift
   even in principle. Resist any temptation to hand-write that table here.

   WHAT IT DOES, IN ORDER:
     1. `js` on <html>, proving scripting before first paint (the header's
        theme toggle is display:none until it lands, never visible-but-inert);
     2. resolves `system` to a concrete light/dark and sets `data-theme`;
     3. applies `theme-<id>`, `board-<id>`, `pieces-<id>`;
        - the board is the reader's PIN if they have one, else the theme's
          default. Absence is a real state — see `boardTheme` in theme.ts;
     4. re-applies a reader's custom square colours as inline properties;
     5. injects two <link>s (see below);
     6. re-runs on OS scheme change and on `astro:after-swap`.

   ⚠️ THE TWO INJECTED <link>s ARE APPENDED SYNCHRONOUSLY DURING HEAD
   PARSING, AND THAT IS THE POINT.

   - The PIECE STYLESHEET, on board pages only (`<html data-board>`). A
     stylesheet added to <head> while the parser is still in <head> blocks
     rendering exactly as a static one does, so the pieces paint WITH the
     board. Injecting it from the island's mount effect would be simpler and
     would show a board of empty squares first — worse than a flash of the
     wrong theme, because it reads as the position having failed to load.
   - The HEADING FONT preload, for the ACTIVE theme. A preload fetches
     unconditionally, so four static preloads would pull four heading faces
     per page and undo the per-theme split entirely. Inter is preloaded
     statically further down because every theme uses it.

   Both are SAME-ORIGIN; the no-third-party-request rule is untouched.

   Kept defensive rather than clever throughout: any failure to read or parse
   the stored value must leave the reader on the default theme with a working
   page, never on a half-applied one.
   ========================================================================= */

/**
 * Scroll reveals. ~20 lines of vanilla JS rather than an animation library: the
 * whole behaviour is "add a class when it comes into view", and CSS owns
 * everything visual (`src/styles/motion.css`).
 *
 * ⚠️ Held as a STRING and injected with `set:html`, not written as script
 * children. Under `is:inline` Astro emits the tag's content exactly as authored
 * and does NOT evaluate `{...}` expressions inside it — so a `{`…`}` wrapper
 * ships to the browser verbatim as a block containing a template literal. That
 * parses cleanly and does nothing at all, which is the worst possible failure:
 * no console error, no reveals, and content left at opacity 0. (Cost: one
 * debugging round in Session 6.) `set:html` inserts unescaped and is the
 * reliable way to emit a computed script body.
 *
 * Everything below fails VISIBLE — no IntersectionObserver, a throwing query, a
 * reader with reduced motion: the class goes on immediately, and content shows.
 */
const REVEAL_SCRIPT = `
(function () {
  try {
    var targets = document.querySelectorAll('[data-reveal]');
    if (!targets.length) return;

    /* Stagger index, read by the CSS as --reveal-i. Capped so a long grid does
       not leave its last card waiting. */
    document.querySelectorAll('[data-reveal-stagger]').forEach(function (group) {
      var i = 0;
      Array.prototype.forEach.call(group.children, function (el) {
        el.style.setProperty('--reveal-i', String(Math.min(i, 5)));
        i++;
      });
    });

    var reduced =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduced || !('IntersectionObserver' in window)) {
      targets.forEach(function (el) { el.classList.add('is-revealed'); });
      return;
    }

    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-revealed');
          /* One-shot. Re-hiding on scroll-up is the effect everyone regrets:
             it makes a page you have already read flicker. */
          io.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.01 }
    );

    targets.forEach(function (el) { io.observe(el); });
  } catch (e) {
    document.querySelectorAll('[data-reveal]').forEach(function (el) {
      el.classList.add('is-revealed');
    });
  }
})();
`;
const t = useTranslations(locale);

const pathname = Astro.url.pathname;
const canonical = new URL(pathname, site.url);
const pageTitle = stripLocale(pathname) === '/' ? site.name : `${title} — ${site.name}`;
const pageDescription = description ?? site.description[locale];
---

<!doctype html>
<html lang={locale} data-board={board ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* THEME — inline, blocking, first. The anti-FOUC script.
        ⚠️ Ships verbatim on every page, so it is kept terse deliberately:
        the rationale is in this file's frontmatter, which is compiled away.
        Read that before changing anything here. */}
    <script is:inline define:vars={{ MCC_THEMES: THEME_TABLE, MCC_THEME_DEFAULT: DEFAULT_SITE_THEME }}>
      (function () {
        var KEY = 'mcc:theme:v1';
        var HEX = /^#[0-9a-f]{6}$/i;
        var INK = '#14120e';
        var CREAM = '#fffdf7';
        var root = document.documentElement;

        function luminance(hex) {
          var c = [1, 3, 5].map(function (i) {
            var v = parseInt(hex.slice(i, i + 2), 16) / 255;
            return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
          });
          return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
        }
        function ratio(a, b) {
          var x = luminance(a);
          var y = luminance(b);
          return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05);
        }
        /* two-ink rule: bestInkFor() in src/lib/theme.ts */
        function inkFor(square) {
          return ratio(INK, square) >= ratio(CREAM, square) ? INK : CREAM;
        }

        function stored() {
          try {
            var raw = localStorage.getItem(KEY);
            if (!raw) return {};
            var parsed = JSON.parse(raw);
            return parsed && typeof parsed === 'object' ? parsed : {};
          } catch (error) {
            return {};
          }
        }

        root.classList.add('js');

        /* Prefixes are structural, so no copy of src/config/*.ts is needed. */
        function clearPrefix(prefix) {
          for (var i = root.classList.length - 1; i >= 0; i--) {
            var name = root.classList[i];
            if (name.indexOf(prefix) === 0) root.classList.remove(name);
          }
        }

        /* One <link> per role. Appended during head parsing so it blocks
           render like a static one — see the frontmatter note. */
        function ensureLink(role, attrs) {
          var el = document.querySelector('link[data-mcc="' + role + '"]');
          if (!el) {
            el = document.createElement('link');
            el.setAttribute('data-mcc', role);
            document.head.appendChild(el);
          }
          for (var key in attrs) el.setAttribute(key, attrs[key]);
        }

        function apply() {
          var state = stored();

          var mode = state.mode === 'light' || state.mode === 'dark' ? state.mode : 'system';
          var resolved = mode;
          if (mode === 'system') {
            resolved =
              window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          }
          root.setAttribute('data-theme', resolved);
          root.style.colorScheme = resolved;

          /* Validated against the table, not a regex: an unknown id would
             add a class no stylesheet defines. */
          var themeId = typeof state.theme === 'string' && MCC_THEMES[state.theme]
            ? state.theme
            : MCC_THEME_DEFAULT;
          var theme = MCC_THEMES[themeId];

          clearPrefix('theme-');
          root.classList.add('theme-' + themeId);

          /* The reader's pin if any, else the theme's default. Absence is a
             real state — see `boardTheme` in src/lib/theme.ts. */
          clearPrefix('board-');
          var pinned = state.boardTheme;
          root.classList.add(
            'board-' +
              (typeof pinned === 'string' && /^[a-z0-9-]+$/.test(pinned) ? pinned : theme.board),
          );

          /* Always the theme's; never chosen separately. */
          clearPrefix('pieces-');
          root.classList.add('pieces-' + theme.pieces);

          /* The artwork, on board pages only (BaseLayout's `board` prop). */
          if (root.hasAttribute('data-board')) {
            ensureLink('pieces', { rel: 'stylesheet', href: '/pieces/' + theme.pieces + '.css' });
          }

          /* ⚠️ Injected, not static: a preload fetches unconditionally, so a
             static one would pull a face the theme does not use. */
          ensureLink('display-font', {
            rel: 'preload',
            as: 'font',
            type: 'font/woff2',
            crossorigin: '',
            href: theme.font,
          });

          /* Custom squares override the preset as inline properties. */
          var custom = state.custom;
          var props = [
            '--mcc-board-light',
            '--mcc-board-dark',
            '--mcc-board-light-ink',
            '--mcc-board-dark-ink',
          ];
          if (custom && HEX.test(String(custom.light)) && HEX.test(String(custom.dark))) {
            root.style.setProperty(props[0], custom.light);
            root.style.setProperty(props[1], custom.dark);
            root.style.setProperty(props[2], inkFor(custom.light));
            root.style.setProperty(props[3], inkFor(custom.dark));
          } else {
            for (var j = 0; j < props.length; j++) root.style.removeProperty(props[j]);
          }
        }

        apply();

        /* `system` follows the OS live. */
        try {
          window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', apply);
        } catch (error) {
          /* older Safari: correct on load, just not live */
        }

        /* ClientRouter would drop the <html> attributes on navigation. */
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical.href} />

    {/* Both languages, plus x-default pointing at the FR root. */}
    {
      LOCALES.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(alternatePath(pathname, l), site.url).href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(alternatePath(pathname, 'fr'), site.url).href} />

    {/* Inter — the BODY face, used by every theme, so it is safe to preload
        statically. It is discovered only after the CSS parses, and `swap`
        would otherwise flash system-ui through the first paragraph.

        ⚠️ THE HEADING FONT IS NOT PRELOADED HERE. It depends on the reader's
        theme, which is not known at build time, so it is injected by the
        script above for the ACTIVE theme only. A static preload of one
        theme's face would make the other three themes download two heading
        fonts and use one. (This is exactly what the line that used to sit
        here — a hardcoded Fraunces preload — would now do.)

        The latin-ext files are deliberately not preloaded either, in any
        theme: they are the rare-glyph fallback. */}
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Four knights for the theme previews on /parametres/ — not four full
        piece sets. See `scripts/build-pieces.mjs`. */}
    {piecePreviews && <link rel="stylesheet" href="/pieces/preview.css" />}

    {/* PWA */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content={site.pwa.themeColor} />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={site.shortName} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_GB'} />

    <Analytics />
  </head>

  <body data-reveals={reveals ? '' : undefined}>
    <a class="skip-link" href="#main">{t('nav.skipToContent')}</a>

    {/* Where the header's theme toggle announces itself. Lives here rather
        than inside the toggle so the announcement is not made by the element
        that just took focus — several screen readers do not report a live
        region that is also the active control. */}
    <p class="sr-only" role="status" aria-live="polite" data-theme-status></p>

    <Header locale={locale} pathname={pathname} />

    <main id="main" class="container-page site-main">
      <slot />
    </main>

    <Footer locale={locale} />

    {/* The bottom bar — mobile only, hidden by its own CSS at ≥768px. It is
        rendered on EVERY page: a permanent bar that appears on some routes and
        not others is worse than none. See src/components/MobileNav.astro. */}
    <MobileNav locale={locale} pathname={pathname} />

    {reveals && <script is:inline set:html={REVEAL_SCRIPT} />}

    <script is:inline>
      // Registered after load so the SW install never competes with the first
      // paint. Guarded on protocol: `astro dev` over http://localhost is fine,
      // but a file:// preview would throw.
      if ('serviceWorker' in navigator && location.protocol.startsWith('http')) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {
            /* An unavailable SW must never break the page — the site works without it. */
          });
        });
      }
    </script>
  </body>
</html>

<style>
  .site-main {
    padding-block: 2.5rem;
  }

  /* ⚠️ ROOM FOR THE BOTTOM BAR, OR IT COVERS THE LAST LINE OF EVERY PAGE.
     The bar is `position: fixed`, so it is out of flow and takes no space —
     the page has to reserve it. `--mcc-bottom-nav` is the bar's row height,
     declared in tokens.css so the bar and this padding cannot disagree; the
     iOS safe-area inset is added here because `env()` cannot live inside a
     custom property and still resolve per-device.

     It goes on the FOOTER's bottom padding rather than on `body`, so the
     footer's background still runs to the bottom of the scroll instead of
     leaving a strip of page colour behind a translucent bar. */
  @media (max-width: 767.98px) {
    :global(.site-footer) {
      padding-block-end: calc(var(--mcc-bottom-nav) + env(safe-area-inset-bottom, 0px) + 1rem);
    }
  }
</style>
