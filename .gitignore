# build output
dist/
.output/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production
.env.local
# ⚠️ Holds a SERVICE ROLE key (RLS-bypassing) for the test project. Never commit.
.env.test

# test artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/

# The release gate's evidence — matrix logs, JSON reports and memory traces,
# written by scripts/test-release.mjs.
# ⚠️ Gitignored but NOT disposable, and deliberately NOT under node_modules/.
# It is the only record of which tests failed on a gate that blocks promotion;
# it used to live in node_modules/.cache, where `npm ci` deleted it along with
# three failures that then had to be re-run from scratch on another machine.
gate-logs/

# editor-local preferences
.vscode/

# macOS / Windows cruft
.DS_Store
Thumbs.db

# NOTE — deliberately NOT ignored, unlike some other Labs projects:
#   public/icons/       generated by scripts/build-icons.mjs
#   public/fonts/       generated by scripts/build-fonts.mjs
#   src/styles/fonts.css   generated by scripts/build-fonts.mjs
# Those scripts are NOT part of `npm run build`. They are run by hand when the
# brand mark or the font subset list changes, and their outputs are committed —
# so a Cloudflare Pages build needs no sharp, no font packages at build time,
# and no extra step. Ignoring them would ship a site with no icons and no
# typography. See CLAUDE.md → "Generated assets".

# The baked public agenda — GENERATED by scripts/fetch-agenda.mjs at build time.
# ⚠️ The committed source is src/data/agenda.fallback.json. This artefact is not
# committed because a test run bakes the TEST project into it, and `git add -A`
# would then ship test sessions as the production fallback.
src/data/agenda.json

# Supabase CLI scratch — written by `supabase db push`, never source.
supabase/.temp/
