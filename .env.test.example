# e2e configuration — THE TEST SUPABASE PROJECT ONLY.
#
# Copy to `.env.test` (gitignored) and fill in. `tests/e2e/env.ts` loads this
# file and ONLY this file: never .env, never .env.local. That separation is the
# whole point — a test run must not be able to reach production by inheriting
# the dev environment.
#
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ SUPABASE_PRODUCTION_REF IS A SAFETY INTERLOCK, NOT DOCUMENTATION.
#
# `assertNotProduction()` runs at Playwright config load and aborts the ENTIRE
# run if the resolved test project ref equals the production ref. The e2e suite
# creates users and PURGES BY PATTERN; pointed at production it would delete
# real accounts.
#
# It FAILS CLOSED. If either ref is missing or unparseable, the run aborts — an
# unconfigured checkout cannot accidentally run against anything.
# ─────────────────────────────────────────────────────────────────────────────

# The TEST project. Must NOT be the production project.
#
# The `TEST_` prefix is the preferred spelling — a file in which every credential
# literally says TEST is much harder to confuse with `.env.local`. The unprefixed
# names are still accepted for backwards compatibility (see `pick()` in
# tests/e2e/env.ts).
TEST_PUBLIC_SUPABASE_URL="https://your-TEST-project-ref.supabase.co"
TEST_PUBLIC_SUPABASE_ANON_KEY="your-test-anon-key"

# Service role key for the TEST project. Bypasses RLS — used to create and purge
# e2e users through the admin API, because we do not depend on real email
# delivery. NEVER put a production service role key here.
TEST_SUPABASE_SERVICE_ROLE="your-test-service-role-key"

# Direct Postgres password for the TEST project, used by `supabase db push` and
# the seed script. Optional for the e2e suite itself.
TEST_SUPABASE_PASSWORD="your-test-db-password"

# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ DO NOT DELETE THIS LINE. THE SUITE ABORTS WITHOUT IT.
#
# The real value is written here rather than left as a placeholder, on purpose:
# this key went missing from .env.test TWICE, because the file was recreated by
# copying `.env.example` (the build-time template, which has no such key) instead
# of this one. A placeholder would be lost the same way. The value below is the
# actual production ref, so a copy of this file is correct as it stands.
#
# It is NOT a secret: a Supabase project ref is the subdomain of the public
# project URL and already ships inside the built bundle. Nothing is exposed by
# committing it.
#
# ⚠️ IT BEGINS WITH "vtest" AND IS NEVERTHELESS PRODUCTION. Read the ref, not the
# vibe of the ref — see CLAUDE.md.
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_PRODUCTION_REF="vtestpaufxmrvdhgrrsy"

# Every e2e account uses this domain so the purge can find them by pattern.
# Changing it means changing tests/e2e/helpers/purge.ts too.
E2E_EMAIL_DOMAIN="mcc-e2e.test"
