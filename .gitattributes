# Normalise line endings. Development happens on Windows; Cloudflare Pages
# builds on Linux. Without this, every file committed from Windows lands in the
# repo with CRLF and any later diff from a Linux checkout is a whole-file
# rewrite.
* text=auto eol=lf

# Binaries — never touched, never diffed as text.
*.woff2 binary
*.woff  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.ico   binary
*.wasm  binary

# SVG is text, but treat it as such explicitly so the brand mark diffs cleanly.
*.svg text eol=lf
